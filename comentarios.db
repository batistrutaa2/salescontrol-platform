INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'YASSUO TODA', '11987796837', '1137651364', '11950687287', '11995554638', 'ELE PEDIU PARA ENVIAR NO WHATSAPP DELE A COTAÇÃO, MAS DISSE QUE SERIA POSSIVEL APENAS ANO QUE VEM. ELE FALOU QUE TEM UM CADASTRO COM AUXILIO NA EMPRESA, ONDE PAGA UMA PARTE DO PLANO.', '2023-09-19 10:53:29');
