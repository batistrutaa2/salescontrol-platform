INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LIVIA PORTO DE MEDEIROS CUNHA', '30560339852', '11972770011', NULL, NULL, '11 99676-6491 Em contato com Livia, a mesma informa que ainda não migrou a Bradesco Saúde\nInforma que está pagando 9 mil reais e solicita cotação via whatsapp\nInforma que vai trocar e está aguardando o esposo realizar alguns exames, gostou da Porto por conta do\nlaboratório alta e também do Oswaldo Cruz da paulista, porto em manutenção de valores, enviei Bradesco e \nirei enviar a Porto após o reajuste!', '2023-11-01 10:44:55');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LIVIA PORTO DE MEDEIROS CUNHA', '30560339852', '11972770011', NULL, NULL, '11 99676-6491 Em contato com Livia, cliente informa que irá fazer a transição no começo do ano, no máximo \naté fevereiro, alega que seus filhos precisam fazer uma cirurgia de carne esponjosa e posteriormente irá\nefetivar a transição. \nSolicita as cotações por whatsapp da Porto Seguro e também Bradesco Saúde. Enviadas juntamente com o\ncheck list dos documentos !', '2024-01-08 10:11:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LIVIA PORTO DE MEDEIROS CUNHA', '30560339852', '11972770011', NULL, NULL, '11 99676-6491 Acompanhamento feito através de ligações e whatsapp durante todos os meses\nA mesma disse que o marido preferiu fechar com outra pessoa', '2024-04-25 10:56:33');
