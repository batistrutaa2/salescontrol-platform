INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'LARISSA HANAUER DE MOURA', '01336547618', '1126451661', '11981231718', '21981288870', 'EM CONTATO COM A DR QUE ESTA EM VIAGEM DE 15 DIAS, CONSEGUI CONTATO COM O MARIDO (RODRIGO) APRESENTEI A PROPOSTA PARA O MESMO QUE SE INTERESSOU E PEDIU PARA ENVIAR POR EMAIL... \n\nO MESMO ME ABRIU QUE TAMBÉM POSSUI PLANO DE SAUDE PORÉM DESTINTO DO DELA... \n\nSENDO ASSIM ENCAMINHEI UMA COTAÇÃO EDIT PARA O CASAL PELA PORTO PARA APÓS ENTRAR COM AMIL \n\nRETORNO NA SEXTA', '2023-05-24 11:57:15');
