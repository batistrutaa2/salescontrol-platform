INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'GERALDO DE SOUZA DIAS FILHO', '76400794891', '1139693278', '11996891150', '11974992353', 'SÓ CHAMOU.', '2023-04-04 16:58:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'GERALDO DE SOUZA DIAS FILHO', '76400794891', '1139693278', '11996891150', '11974992353', 'TELEFONE 2 - MULHER DELE\nMARIA BERALDA ALTENFELDER SANTOS DE SOUZA DIAS - 112.809.758-30\nAFAVEL.\nELA DISSE QUE ELES TEM SOFRIDO MUITOS REAJUSTES E O REEMBOLSO NÃO SOBE.\nAGORA EM JULHO TERA UM NOVO AUMENTO E NÃO SABE COMO FICARÁ A SITUAÇÃO POIS ESTÁ MUITO CARO.\nLEANDRO PUXOU NO SISTEMA E SÓ ESTÁ O RAPAZ E UM FILHO NO PLANO EXCUTIVO ATUAL.\nELA DEVE TER MUDADO PARA OUTRA APOLICE. (ELA COMENTOU QUE FEZ UM DONWGRADE)\nDISSE TAMBÉM QUE NO ANO PASSADO ELA QUASE MUDOU PARA A BRADESCO, E AGORA A QUALICORP NÃO \nCOMERCIALIZA MAIS... (DEIXOU CLARO QUE JA TEVE E TEM INTERESSE NA BRADESCO)\n\nELE NÃO TEM EMPRESA, MAS ELA TEM MAIS DE 20.', '2023-06-05 10:00:59');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'GERALDO DE SOUZA DIAS FILHO', '76400794891', '1139693278', '11996891150', '11974992353', 'Em contato, apresentei One Heath e Bradesco. Estamos evoluídos na negociação!\nTirei muitas dúvidas no tel.\nLigar próxima semana para marcar reunião.', '2023-09-01 14:27:58');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'GERALDO DE SOUZA DIAS FILHO', '76400794891', '1139693278', '11996891150', '11974992353', 'Cliente não podia falar. E informou na ligação não estar interessada no momento.', '2024-01-18 15:58:12');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'RAPHAEL GENDLER', '4162730849', NULL, '11971625777', NULL, 'JOSE LUIZ PINTO LIMA GENDLER - 311.354.688-50 - (11) 99685-2823\n\nEm contato com o filho do cliente. O mesmo solicitou cotação através do e-mail zegendler@yahoo.com.br para que possam avaliar. \n\nIrei encaminhar uma opção na Bradesco Saúde considerando a portabilidade dos pais via inclusão.\n\nKaique Albertin', '2022-08-11 13:01:46');
