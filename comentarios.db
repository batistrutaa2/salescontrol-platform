INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MAURO SERGIO GODOY', '75944740825', '(11) 9403-36844', NULL, NULL, 'Em conversa com Mauro o mesmo informou que estava ocupada para falar mais adiantou que liguei num bom \nmomento pois ele esta insatisfeito com os valores atuais da Sulamerica e pediu que ligasse para sua esposa \nGilvâni no numero 11 999487364 (ligar de manhã).\nPORTO - CNPJ', '2023-07-11 17:18:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MAURO SERGIO GODOY', '75944740825', '(11) 9403-36844', NULL, NULL, 'Em conversa com a esposa Gilvany a mesma informou que são dois planos na Sulamerica através da entidade \nOAB, em um plano esta ela e um filho e no outro esta Mauro e a filha pagando cerca de 10.000 em cada apolise.\nA mesma já adiantou que possui CNPJ e reside em jandira. \nEnviar estudo no Email e retornar na proxima semana para verificar a avaliação \n(gilvany@godoyebrasileiro.com.br)  ( 999487364)', '2023-07-20 12:03:24');
