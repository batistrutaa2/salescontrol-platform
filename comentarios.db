INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'IVONE KOBAYASHI', '00317162888', '1136415485', '11991772836', '11989806445', '(11) 9917-72836 Em contato com Ivone, cliente aceita receber cotação da Amil Saúde S750 R1 \nA mesma informa ser contadora e abriria a empresa caso goste da proposta, trouxe uma sobrinha neta\npara a cotação e passou o email KOBAYASHI.ivone@yahoo.com.br\nEnviada cotação, pediu retorno terça feira para sabermos a sua opinião!', '2023-09-04 17:41:53');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'IVONE KOBAYASHI', '00317162888', '1136415485', '11991772836', '11989806445', '(11) 9917-72836 Em retorno com cliente, a mesma informa não ter interesse na transição no momento\nAlega varias inseguranças tanto com a amil e também em questão de ter que abrir empresa\ntentei contornar objeções, cliente permaneceu sem interesse!', '2023-09-21 12:02:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JAMIL ABRAO MALUF FILHO', '56955596853', NULL, '11995552600', NULL, '(11) 9955-52600 Em contato com Jamil, cliente informa que não tem outro participante para incluir\nna cotação, possui MEI\nO mesmo informa que está em um tratamento ativo com a sulamérica, para tentarmos no futuro!', '2023-09-05 11:38:12');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JEANNETTE ARMINDA S DE RADA', '12630978800', NULL, NULL, NULL, 'Tentativa de contato sem sucesso aqui  e nos numeros do assertiva \n(11) 99988-9566 provavel numero do filho , consegui contato com o mesmo , ele disse que é \nda qualicorp', '2023-08-29 14:33:53');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JEANNETTE ARMINDA S DE RADA', '12630978800', NULL, NULL, NULL, '(11) 99261-5733 Falei como Porto com o filho antonio, o mesmo aceitou receber cotação e pediu \npara mandar mensagem no whatsapp. Aguardando respaldo para enviar cotações!', '2024-06-20 16:59:59');
