INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'INAHY BARRERO', '14385331871', '1150723599', '13996076636', '11976998015', '(11) 98494-8859 - em contato come la, disse que aconteceram algumas coisas an familia e que nao vai fazer\nagr, perguntei se podia retornar, disse que nao, que ela mesma me liga, vou ter fim de fev', '2023-01-31 12:07:05');
