INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MONIQUE TOLEDO SALGADO', '06901515782', '6135413140', '61982020319', NULL, '(61) 9820-20319 Em contato com cliente , a mesma informa ser sozinha e não ter interesse\nem plano empresarial por não ter mais participantes a trazer!', '2023-07-06 11:00:26');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PATRICIA MARIA A M DE ALMEIDA', '07526178856', '1141052198', '11984876547', '11982451399', '(11) 9824-51399 Em contato com cliente, a mesma aceita conversar comigo e se queixa quanto \nao reajuste do próximo mês ao ser informado a porcentagem de 30%\n\nAlega que está pagando R$ 5.500,00 e que o valor está um absurdo, informa que em 2020 teve um tumor\ncerebral benigno e que faz só acompanhamentos para ver se não vai voltar! \nEm consulta no assertiva, a mesma possui uma microempresa individual baixada 01.502.278/0001-20 \n\nPede um retorno amanhã as 11 horas para receber propostas de melhoria, falar sobre o MEI da cliente para\na portabilidade e fazer propostas de redução de custo!', '2023-06-22 11:35:30');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PATRICIA MARIA A M DE ALMEIDA', '07526178856', '1141052198', '11984876547', '11982451399', '(11) 9824-51399 Em contato com cliente, a mesma aceita conversar comigo e se queixa quanto \r\nao reajuste do próximo mês ao ser informado a porcentagem de 30%\r\n\r\nAlega que está pagando R$ 5.500,00 e que o valor está um absurdo, informa que em 2020 teve um tumor\r\ncerebral benigno e que faz só acompanhamentos para ver se não vai voltar! \r\nEm consulta no assertiva, a mesma possui uma microempresa individual baixada 01.502.278/0001-20 \r\n\r\nPede um retorno amanhã as 11 horas para receber propostas de melhoria, falar sobre o MEI da cliente para\r\na portabilidade e fazer propostas de redução de custo!', '2023-06-22 11:47:48');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PATRICIA MARIA A M DE ALMEIDA', '07526178856', '1141052198', '11984876547', '11982451399', '(11) 9824-51399 Em contato com cliente, a mesma solicita cotação da Amil pelo whats\nSana algumas dúvidas sobre o plano empresarial e informa que não sabe se vai sofrer reajuste no mês de julho\nAcompanhar cliente pós reajuste e abordar novamente a proposta de melhoria!', '2023-06-30 12:41:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PATRICIA MARIA A M DE ALMEIDA', '07526178856', '1141052198', '11984876547', '11982451399', '(11) 9824-51399 Em retorno com cliente , a mesma informa que preferiu fazer acordo com a propria\nsulamérica e migrar para um plano cooparticipativo!', '2023-07-11 15:51:59');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PATRICIA MARIA A M DE ALMEIDA', '07526178856', '1141052198', '11984876547', '11982451399', '(11) 9824-51399 Em contato com cliente, a mesma informa que reajuste não foi alto e não quer mudar no \nmomento!', '2024-08-02 16:08:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'REGINA JUNQUEIRA TIMONER', '30751131822', '1131980171', '11956909857', '11992759857', '(11) 9927-59857 Em contato com cliente, a mesma aceita receber propostas Porto Seguro e Amil One\nCliente muito receptiva e se mostrou interessada pelas propostas, informou que seu esposo tratou \num câncer a dois anos que foi curado e o mesmo só faz acompanhamentos \n\nEnviado Porto Ouro Mais e Diamante, Amil S1500r2 \nretornar com argumentos de fechamento, cliente possui empresa aberta!', '2023-06-15 11:55:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'REGINA JUNQUEIRA TIMONER', '30751131822', '1131980171', '11956909857', '11992759857', '(11) 9927-59857 Em retorno com cliente, a mesma informa que está em uma obra, que está analisando\ne solicita retorno em outro horário!', '2023-06-21 14:52:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'REGINA JUNQUEIRA TIMONER', '30751131822', '1131980171', '11956909857', '11992759857', '(11) 9927-59857 Em contato com cliente, a mesma solicita retorno em um horário mais oportuno\npois está funcionando!', '2023-07-19 17:20:37');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'REGINA JUNQUEIRA TIMONER', '30751131822', '1131980171', '11956909857', '11992759857', '(11) 9927-59857 Em novo contato com cliente , a mesma informa que acabou de chegar de viagem\ne que vai passar a proposta para a secretária cuidar\nReenviado novamente nova mensagem no whats com as cotações para que a mesma envie a secretária\n\nRetornar nos próximos dias!', '2023-07-26 14:06:46');
