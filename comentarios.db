INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'EDSON GOROJI IKARI', '14494053805', NULL, '69993961837', '69999001050', 'PESQUISA FEITA EM DEZEMBRO (RECENTE) INSATISFEITO COM O VALOR PAGO. ELE ATENDE MUITOS CLIENTES EM SP E PEDIU AS REDES DAQUI. ENTÃO É PRECISO UM COM ATENDIMENTO NACIONAL, MAS APRESENTAR OS HOSPITAIS DAQUI. ELE É MEDICO ENTÃO CONHECE AS REDES. CLIENTE POSSUI SEGURO DE VIDA PELA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-02-08 18:52:12');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'EDSON GOROJI IKARI', '14494053805', NULL, '69993961837', '69999001050', '(69) 9990-01050 Em contato com Edson, cliente aceita receber proposta Amil por email \nEnviado no email descrito \n\nO mesmo sana algumas duvidas referente a modo de contratação, questiona se é empresarial\nSolicita cotação para comparar de fato e informa que conhece bastante de planos de saúde \nO mesmo não deu muito abertura, possui empresa em Rondônia, utiliza também os hospitais de \nSão Paulo \n\nRetornar com argumentos de fechamento!', '2023-02-09 11:01:27');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'EDSON GOROJI IKARI', '14494053805', NULL, '69993961837', '69999001050', '(69) 9990-01050 Tentativa de retorno, telefone para contato do mesmo só chamou! \n\nTentar novamente!', '2023-03-21 15:31:24');
