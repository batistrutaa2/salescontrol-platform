INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'NATALYA ZAIDAN MALUF', '26487133876', '(11) 9411-21266', '(11) 9964-66735', NULL, 'Em contato com a cliente a mesma informou estar na Unimed nacional com apenas sua vida de 46 anos na apolice, \na mesma ja adiantou que não tem outras vidas para adicionar porem disse que tem interesse na proposta.\nFoi enviado para a cliente, cotações PME e Adesão, porém verificado via ASSERTIVA que a cliente possui CNPj\nativo com mais socios.', '2023-06-12 15:09:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'NATALYA ZAIDAN MALUF', '26487133876', '(11) 9411-21266', '(11) 9964-66735', NULL, 'Em conversa com a cliente via Whatsapp a mesma demonstrou interesse no plano empresarial da Porto, e também pediu que enviasse nova cotação com sua vida(46), sua socia(40) e a filha de 4 meses.\nCotação enviada para a cliente e a mesma foi afavél, retornar entre hoje ou amanhã .', '2023-06-13 11:32:17');
