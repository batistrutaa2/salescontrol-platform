INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'MIRELE NAVERO DA SILVA', '17610341894', '(11) 9929-22197', NULL, NULL, 'Cliente tem uma doença pre existente, porém não faz nenhum acompanhamento nem exames a 4 anos, disse ter considerado cura. Falei sobre a opção da Omint pois ela não possuem ninguém para completar a confirmação de portabilidade, mais disse que se ela declarar terá carência de 2 anos. A mesma gostou da opção e disse que ficar com a carência está sendo uma possibilidade. Mandei tudo por WhatsApp e retornarei Segunda 05/08.', '2024-08-01 11:13:25');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'MIRELE NAVERO DA SILVA', '17610341894', '11992922197', NULL, NULL, 'Em negociação, cliente tem pre existente. Mais aceitou a opção de Omint com carência', '2024-08-02 15:54:37');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'JOSE CARLOS BAPTISTA PUOLI', '10742970833', '11996096836', NULL, NULL, 'Conversei com o cliente disse que só pode falar em Setembro.', '2024-08-01 11:48:08');
