INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LEANDRA STEINMETZ', '14773412852', '11991872290', '11991872290', NULL, '(11) 9918-72290 Em contato com cliente, a mesma entende produtos TNPLUS e Diamante Porto \nFalado bastante de valores e reembolso, e reforçada a vontade e desejo de marcar uma reunião, \nA mesma solicita retorno na sexta para saber se vamos fazer a reunião no sábado!', '2023-01-31 14:46:46');
