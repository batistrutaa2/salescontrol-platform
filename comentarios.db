INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'FERNANDA FREIRIA B THEODORO', '24817762837', '1132536087', '11950387449', '11992154898', 'AFAVEL MAS UM POUCO SÉRIA. CLIENTE ESTÁ EXTREMAMENTE INSATISFEITO COM O VALOR DE REEMBOLSO. FALOU QUE TEM EM TORNO DE 220,00. NÃO TEVE PROBLEMAS EM UTILIZAÇÃO NAS REDES CREDENCIADAS, USA MUITO O REEMBOLSO. FOCAR NOS VALORES DE REEMBOLSO. FALOU QUE PAGA EM TORNO DE 6.000,00 E SABE QUE ESTA DESATUALIZADO. TELFONE 3 DA CLIENTE. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA.', '2023-02-08 18:46:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'FERNANDA FREIRIA B THEODORO', '24817762837', '1132536087', '11950387449', '11992154898', '(11) 9921-54898 - resultado de pesquisa sem interesse, abordei como Bradesco, cliente já cortou e disse que \nnão ia mudar de plano, que ela tem liminar com a sul américa e ela não vai sair e nem pode.', '2023-02-10 11:39:57');
