INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ADRIANO LUIZ GUERRA', '19101073877', '11985782887', '11992492887', NULL, '(11) 9857-82887 - em contato com ele, viu a cotação, disse que pra mudar ta mto delicado agr, pq ela teve endometriose operou e ainda ta acompanhando e tal, dei opção de fazer amil e incluir via portabilidade\nele disse que ok bom saber da opção mais pra eu nao pressionar ele.. kk ok ok mandei tudo no wpp e vamos na manhã com ele pq ele é meio chatinho, mais dei a opção expliquei tudo certinho.', '2023-05-18 14:51:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ADRIANO LUIZ GUERRA', '19101073877', '11985782887', '11992492887', NULL, 'Olá Sr. Adriano! boa tarde. \n\nPassando para me colocar á disposição caso tenha conversado com a sua esposa quanto ao cenário que passei de trocar via portabilidade ta ok! \n\nMe coloco a disposição para uma reunião presencial com vocês esta semana, eu e meu gestor podemos ou ir até voces, ou recebermos voce no nosso escritório que fica na av angelica ta ok! \n\nBoa semana. ??', '2023-05-29 17:38:20');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ADRIANO LUIZ GUERRA', '19101073877', '11985782887', '11992492887', NULL, 'Bom dia!\nA minha esposa está fazendo um tratamento específico p/ endometriose - inclusive c/ cirurgia! Não seria interessante trocar de convênio neste momento! Mas muito agradecido!', '2023-06-19 13:52:08');
