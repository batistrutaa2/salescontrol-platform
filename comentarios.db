INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PATRICIA SAETA LOPES BAYEUX', '17127241856', '1150822267', '11981338053', '11981338049', '(11) 9813-38049 Em contato com esposo, cliente informa que ele, esposa e filho migraram para um plano\nde saúde empresarial da Bradesco Saúde, porém que por conta de uma doença pré-existente o plano da \nSulamérica qualicorp da esposa ainda está ativo, até a mesma cumprir o prazo de 2 anos de CPT\n\nLigar quem sabe futuramente, apesar da condição ser deliciada por conta da CPT', '2023-04-17 09:37:32');
