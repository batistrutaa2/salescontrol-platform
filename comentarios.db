INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA ELIZABETH FILIPPINI ZORZI', '40144658887', '(11) 96812-0999', '(11) 98467-1923', '(11) 99485-5678 - Mauro', 'Telefones abaixo indisponíveis!\n(11) 9681-20999\n(11) 9846-71923\n(11) 9948-55678', '2024-01-11 15:11:34');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA ELIZABETH FILIPPINI ZORZI', '40144658887', '(11) 96812-0999', '(11) 98467-1923', '(11) 99485-5678 - Mauro', '(11) 98388-8679 Em contato com filha Lidia, a mesma informa que sua mãe não mexe no plano dela\nAbordei como Porto Seguro pois a mãe está para completar 74 anos e compra as carências até então. \nPorém filha disse que mãe não vai ter interesse em sair e ela também não troca seu plano atual\nTentativa de contato com Maria nos demais telefones sem sucesso!', '2024-01-30 13:50:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA JOSEFA DEL CARMEN M SOTO', '39246124634', NULL, NULL, NULL, 'Cliente completou 74 anos , não possui CNPJ \nNão atende os numeros do assertiva', '2024-05-10 10:39:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'OLIVER THOREY', '16934439880', '(11) 96456-6284', '(11) 95826-1316', '(11) 2628-8380', '11 - 982356364  Esposa passa o contato do Oliver\nEm contato com o mesmo, passa que esposa faz tratamento de hemodialise no oswaldo cruz\nSana muitas dúvidas, em ligação no oswaldo cruz a cobertura para o procedimento é somente no S1500 \nQue ficou R$ 7.000,00 para os dois em categorias diferentes, \nEnviada cotações no whats do mesmo, retornar com argumentos de fechamento, falado sobre reunião\nno oswaldo cruz', '2024-01-11 11:53:38');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'OLIVER THOREY', '16934439880', '(11) 96456-6284', '(11) 95826-1316', '(11) 2628-8380', '11 - 982356364 FECHAMENTO :\nEm retorno com Oliver, o mesmo passa que está conversando com sua esposa e está indo com cautela por\nconta das questões do tratamento da mesma, abordado em linha sobre a portabilidade e REUNIÃO\nonde ficaria mais fácil para ele entender todas as questões da transição e da portabilidade. \nEle passou que sim, vamos fazer, porém esse mês está um pouco corrido pela esposa estar recebendo um\nfilho do exterior, vamos manter o contato para marcar a reunião no máximo em fevereiro e irmos ao fechamento\nO mesmo está interessado, mantê-lo aquecido.', '2024-01-17 09:46:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'OLIVER THOREY', '16934439880', '(11) 96456-6284', '(11) 95826-1316', '(11) 2628-8380', '11 - 982356364  Tentativa de contato, só chamou!', '2024-04-10 10:15:14');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'OLIVER THOREY', '16934439880', '(11) 96456-6284', '(11) 95826-1316', '(11) 2628-8380', '11 - 982356364 Em contato com Oliver, o mesmo recebeu reajuste e solicita retorno amanhã!', '2024-06-18 16:42:41');
