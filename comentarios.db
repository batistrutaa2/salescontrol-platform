INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'REGINA PIRES SMITH DA SILVA', '14819019821', '11999623618', '11999759043', '11999792610', '(11) 9997-59043 - numero do esposo, abordei como porto seguro, ele disse que podia enviar cotação para ele\n64/64/39. consultei ele no assertiva e nao achei cnpj tb \n(11) 9997-92610 - não atendeu \n(11) 9996-23618 - nao atendeu \n\nem busca no assertiva \n\nnao encontrei tb CNPJ ativo \n\ntem benf com a porto', '2023-03-30 14:55:47');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'REGINA PIRES SMITH DA SILVA', '14819019821', '11999623618', '11999759043', '11999792610', '(11) 9997-59043 - em contato com reinaldo, perguntei o que achou da cotação da porto, falou que gostou porem não tem empresa, que estava ate cogitando fazer pela empresa da filha porem a esposa dele sempre foi autônoma, mal tem carteira de trabalho. Falei sobre a abertura, e se ele topava bater um papo com a contadora e ele topou, esta aguardando ctt neste numero. \n(11) 9997-92610 - não atendeu \n(11) 9996-23618 - nao atendeu \n\nem busca no assertiva \n\nnao encontrei tb CNPJ ativo \n\ntem benf com a porto', '2023-05-04 16:26:49');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'REGINA PIRES SMITH DA SILVA', '14819019821', '11999623618', '11999759043', '11999792610', '(11) 9997-59043 - pediu que de mais um tempo pra ele, tentei marcar visita, porem essa semana ele ta sem agenda. Ta pagando 11 mil porem ta no dilema de abrir empresa ou nao. Prox semana eu contato dnv para tentar \nmarcar', '2023-05-22 16:49:49');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'REGINA PIRES SMITH DA SILVA', '14819019821', '11999623618', '11999759043', '11999792610', 'em contato com ele, disse que quer, porem que nao tem como agendar agr a reunião e que a empresa movimentada tb ele ta alinhando mta coisa pra abrir, me pediu mais tempo', '2023-06-14 10:25:21');
