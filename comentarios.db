INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA MARIA DE O SANCHES', '03057521894', NULL, '11999968009', '11997655909', 'CONVERSEI COM O FELIPE 11985529554 FILHO DELA, PERMITIU ENVIAR UMA COTAÇÃO.\nVOU TENTAR NEGOCIAR COM ELE, E SE FOR PRECISO, TENTO RETORNAR PARA A MÃE QUE NO CASO SÓ CHAMOU O NUMERO.', '2022-09-22 11:26:50');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA MARIA DE O SANCHES', '03057521894', NULL, '11999968009', '11997655909', 'KAIQUE CONVERSOU COM O FELIPE, ELE RECEBEU A COTAÇÃO, GOSTOU MAS ESTA CONVERSANDO COM A MAE SOBRE.\nFALOU SOBRE CARENCIA, O KAIQUE TIROU AS DUVIDAS E IRÁ RETORNAR NA SEGUNDA FEIRA PARA MARCAR UMA REUNIAO.', '2022-10-05 16:07:48');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA MARIA DE O SANCHES', '03057521894', NULL, '11999968009', '11997655909', 'OURO MAIS - 3.574,96', '2022-10-05 16:08:41');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA MARIA DE O SANCHES', '03057521894', NULL, '11999968009', '11997655909', 'Em contato com o Felipe, o mesmo apresentou receio em relação a troca por conta de insegurança de ser negado algum tipo de procedimento posteriormente a transferencia.\r\nConseguimos quebrar a objeção apresentando valores e regras de comercialização. O mesmo solicitou envio de valores SulAmerica para mostrar a sua mãe e usar isso como argumento de marcação de reunião em breve em nosso escritório.\r\nRetornar no final desta semana.', '2022-10-11 11:05:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA MARIA DE O SANCHES', '03057521894', NULL, '11999968009', '11997655909', 'Em contato, Felipe foi orientado a Mudar o plano para Amil PME ou Bradesco APM \r\nSolicitou envio por WhatsApp e retorno para alinharmos uma reunião.', '2022-10-26 11:20:23');
