INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA THEREZINHA N COTRIM', '66856906587', NULL, '11996511997', '11981542827', '11 99651-1997 Em contato com cliente via indicação da Kathia\nA mesma é sócia no mesmo CNPJ e se interessou pela Bradesco \nPassou também mais uma idade de 0 a 18 e a do marido de 43\nEnviada cotação Bradesco TQN3, cliente sana as últimas dúvidas para alinhar contrato\nSolicitar documentação e posteriormente tratar com a Kathia.', '2023-02-28 10:21:37');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA THEREZINHA N COTRIM', '66856906587', NULL, '11996511997', '11981542827', 'Cotado o produto da Omint Skill SC2ME [A]\nValores ficaram interessantes com o Hospital Oswaldo Cruz para atendimento completo\nTentar contato com a mesma para passar a proposta!', '2023-03-14 11:34:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA THEREZINHA N COTRIM', '66856906587', NULL, '11996511997', '11981542827', '11 99651-1997 Enviada via whatsapp a proposta da Sulamérica empresarial, uma vez que a mesma\nsó tem interesse na Bradesco, porém não possui um terceiro participante para compor grupo\n\nValor da troca administrativa ficou bem atrativo, trazer a mesma e cobrar angariação!', '2023-04-06 12:20:37');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA THEREZINHA N COTRIM', '66856906587', NULL, '11996511997', '11981542827', '11 99651-1997 Tentativa de retorno, caixa postal \nA mesma não aceita nenhum outro produto a não ser Bradesco, como não possui terceira vida\nOferecer troca administrativa e cobrar angariação!', '2023-04-11 14:29:38');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA THEREZINHA N COTRIM', '66856906587', NULL, '11996511997', '11981542827', '11 99651-1997 Tentativa de contato com a cliente sem sucesso\nA mesma solicitou retorno essa semana, tentativa ontem e hoje sem sucesso. \n\nNo ultimo contato passou que ia trazer seu outro filho para contratar a Bradesco Saúde pela sua empresa!', '2023-05-11 14:11:08');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA THEREZINHA N COTRIM', '66856906587', NULL, '11996511997', '11981542827', '11 99651-1997 Tentativa de contato com a cliente sem sucesso\nA mesma solicitou retorno essa semana, tentativa ontem e hoje sem sucesso. \n\nNo ultimo contato passou que ia trazer seu outro filho para contratar a Bradesco Saúde pela sua empresa!', '2023-05-11 14:11:21');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA THEREZINHA N COTRIM', '66856906587', NULL, '11996511997', '11981542827', '11 99651-1997 Tentativa de retorno na semana passada sem sucesso \nNova tentativa hoje, só chamou \nMensagem no whats enviada referente ao retorno para tentar trazer os documentos da mesma!', '2023-05-15 10:18:23');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROBERTA BORGES N PETRILLI', NULL, '11999944456', '1130633433', NULL, '(11) 9999-44456 - nao atendeu \n(11) 99577-3801 - nao atendeu \n(11) 3063-3433 - desconhece \n(11) 3031-0581 - nao atendeu \n\nnao tem empresa e idade atual 45 anos', '2023-02-24 11:10:14');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROBERTA BORGES N PETRILLI', NULL, '11999944456', '1130633433', NULL, '180.228.578-40\nCLIENTE PRAGMATICA COM MINIMO DE AFAVEL.\nELA TEVE UM PROBLEMA RECENTE COM SEGURO VIAGEM, ONDE PRECISOU USAR NO CANADA, E NÃO TEVE\nCOBERTURA.\nEM TERMOS DE VALOR E BENEFICIOS, ELA NÃO RECLAMOU.\nA FRUSTAÇÃO DELA É TÃO GRANDE, QUE ELA QUER SAIR DA QUALICORP E DA SULAMERICA, POR TEREM\nFEITO ISSO COM ELA.\nELA ESTA NA LINHA EXECUTIVO DA SULAMERICA DESDE 2021.\nO FINAL DA PESQUISA QUANDO FUI FALAR QUE ENTRARIAM EM CONTATO, ELA FALOU: "BOM, COM TUDO \nQUE EU FALEI, ESPERO QUE VOCE RETORNE COM UMA SOLUÇÃO, OBRIGADO E BOM DIA."\nNÃO DEU TEMPO DE FALAR QUE IRIAM LIGAR PRA ELA DE OUTRA COMPANHIA, MAS SABEMOS QUE ELA ESTÁ\nCOMPLETAMENTE INSATISFEITA.\nTELEFONE 1.\n\nCLIENTE POSSUI DIVERSOS BENEFICIOS NA PORTO SEGURO.\nCLEINTE NÃO POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-13 11:49:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROBERTA BORGES N PETRILLI', NULL, '11999944456', '1130633433', NULL, '(11) 9999-44456 - nao atendeu \n(11) 99577-3801 - nao atendeu \n(11) 3063-3433 - desconhece \n(11) 3031-0581 - nao atendeu \n\nnao tem empresa e idade atual 45 anos', '2023-03-28 16:11:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROBERTA BORGES N PETRILLI', NULL, '11999944456', '1130633433', NULL, '(11) 9999-44456 -abordei como porto, nao tenho intersse, falei nem falei do que era calma, ela ja sei que é \nplano de saúde entao nao quero obg\n(11) 99577-3801 - nao atendeu \n(11) 3063-3433 - desconhece \n(11) 3031-0581 - nao atendeu \n\nnao tem empresa e idade atual 45 anos', '2023-06-14 17:33:09');
