INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCILENE RAPOSO FLORENTINO', '07606529884', NULL, NULL, NULL, '(11) 98491-4825 Em contato com cliente, a mesma aceita receber cotação da Bradesco Saúde TQRI \nInforma que utiliza o Sta. Paula e o A+ , enviada cotação no valor de 7.910,36 e também o reajuste da mesma\nestá chegando. \nEla sana todas as dúvidas sobre ABERTURA de cnpj e informa que irá conversar com seu esposo, solicitando \nretorno na próxima semana, retornar com todos os argumentos para marcarmos uma reunião!', '2024-05-07 15:32:41');
