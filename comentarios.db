INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MARCUS AUGUSTUS GIANULLO', '81781610878', '(11) 2973-1583', '(11) 9991-95059', '(11) 9697-31583', 'Em conversa com Marcus o mesmo não havia visto o material então adiantei informações sobre benefício, valores e sobre a portabilidade já que sua esposa tem câncer de mama, Marcus pediu que enviasse novamente o estudo e disse que está livre amanhã na parte da tarde após as 15H', '2023-09-12 15:12:10');
