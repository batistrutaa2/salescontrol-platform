INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'NELSON SERCHELI', '49298470878', '1142298016', '11997522756', '11993509392', 'Em contato com a esposa Selma. Ela tem interesse porém está conversando com a filha para a entrada, pois terá que ser uma portabilidade para Selma que tem leucemia crônica.', '2023-09-27 14:12:01');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'NELSON SERCHELI', '49298470878', '1142298016', '11997522756', '11993509392', 'Mantendo contato com a filha não conseguimos fazer a troca devido a idade e precisa ser portabilidade, e nenhuma das filhas quer entrar no plano só pra ativar a apólice.', '2024-04-23 14:39:34');
