INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'VERA SASSON', '11754691811', '(11) 3801-1760', '(11) 9987-06288', '(11) 9990-40809', 'Em conversa com Vera a mesma foi afável e disse estar bem com a atual UNIMED porém não tem hospitais que \ncostumava utilizar como São Camilo e metropolitano então ela utilizou o BP quando necessário.\nVera também relatou que só pode fazer um retorno com o medico após 30 dias', '2024-01-31 14:15:56');
