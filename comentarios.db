INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'RICARDO ANTONIO LOUREIRO VELOSO', '78405211853', '13997034129', NULL, NULL, 'Em contato com ele, informou que tem interesse, porem ta pra operar da vesícula, não é ele em si, é a esposa ou o filho eu acho, pq no fim da ligação falei que desejava que ocorresse tudo bem no procedimento e ele informou que não era ele mais brigado. Pediu ret em 1 mês, ta na unimed ainda pagando os 3.600 confirmei as idades 66-60-31 e-mail dele mhrengenharia@gmail.com fazer o envio da cotação e ret em 30 dias', '2022-07-10 10:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'RICARDO ANTONIO LOUREIRO VELOSO', '78405211853', '13997034129', NULL, NULL, 'Tentei contato com ele, não atendeu, vou informar que a sula subiu os preços e dar opção da Bradesco.', '2022-07-11 10:54:50');
