INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANE MARIA JORIO NOGUEIRA', '32447213620', '11 93730-0207', '(11) 98196-5063', NULL, '11 98196-5063 Consegui contato com esposo Carlos, o mesmo informa que titular possui doenças pré \nexistentes e toma medicamento de alto custo que a propria sulamérica arca. \n\nCenário: \nSugerido abertura de CNPJ para trazer um terceiro participante, deixando a titular na sulamérica e fazendo\npara o Pai Carlos, filha, e um terceiro, custos ficaram bem baixos. Carlos tem 70 anos e filha 34\nEnviada cotação da Porto Seguro em seu whats, o mesmo passou que iria conversar com a sua esposa!', '2024-06-20 14:25:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANE MARIA JORIO NOGUEIRA', '32447213620', '11 93730-0207', '(11) 98196-5063', NULL, '11 98196-5063 Em retorno com Carlos, cliente informa que esta viajando porém está interessado no assunto. \nReforcei com o mesmo toda a transição e passado que fiz os levantamentos para o caso do cliente. \nRetornar quinta ou sexta feira quando o mesmo ja estará em casa após viagem!', '2024-06-24 14:38:13');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANE MARIA JORIO NOGUEIRA', '32447213620', '11 93730-0207', '(11) 98196-5063', NULL, '11 98196-5063 Tentativa de retorno abaixo, tentar novamente, cliente interessado.', '2024-06-26 14:27:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANE MARIA JORIO NOGUEIRA', '32447213620', '11 93730-0207', '(11) 98196-5063', NULL, '11 98196-5063 Em retorno com cliente , o mesmo informa que ainda está avaliando junto a esposa. \nReforçar que a esposa permanecerá na qualicorp por conta dos medicamentos e a alteração seria para o restante\ndo grupo. \nRetornar próxima semana!', '2024-07-02 10:44:38');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANE MARIA JORIO NOGUEIRA', '32447213620', '11 93730-0207', '(11) 98196-5063', NULL, '11 98196-5063 Em contato com cliente, o mesmo informa que irá ter uma reunião social com a APM para\npedir conselhos sobre a questão do seu seguro saúde, está com alguns receios referente a  abertura do CNPJ\nCliente pede retorno na próxima quinta-feira. \nRetornar para focar em marcar uma reunião e detalhar todo o processo de transição ao mesmo!', '2024-07-11 17:56:26');
