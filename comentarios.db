INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'TAMARA CURY LAITER', '30069846847', '1123079751', '11983711174', '11985515612', 'Em retorno com Tamara a mesma informou não ter visto o estudo e pediu que enviasse novamente em seu Wpp.\nJa foi passado os valores disponiveis para as duas vidas, retornar e conversar sobre uma terceira pessoa ou trocar \nde opção', '2023-07-05 15:42:16');
