INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIA FERNANDES SANCHEZ', '25477852852', '1126056553', '11953161677', '11968462600', '(11) 9531-61677 - não é dela, um rapaz atedeu e disse que é da familia dela mais ela nao atende por esse num\n(11) 9684-62600 - nao atendeu \n(11) 2605-6553 - Em ctt com Sra. Maria josefa, mãe dela, informou que esse num ja foi fixo dela, por isso ela \natendeu... Disse do que se tratava falei que era corretora e que queria falar sobre o plano dela, ela comecou \na falar algumas isatisfações, tem 75 anos, paga 3.600. Disse que nao sabe o que fazer cm esse preço, falei da prevent ela nao gosta por causa dos escandalos na epoca do covid. Disse pra ela que etendia, e que a unica e maneira de reduzir legal o plano seria por empresa, ela disse que nao sabe se pode abrir e nem a filha dela pois é funcionaria publica, falei que tem alguns que pode, ela disse que vai pedi pra filha dela me ligar.\n\nem busca no assertiva \n\nnao tem empresa \nligando como amil', '2023-04-13 12:02:58');
