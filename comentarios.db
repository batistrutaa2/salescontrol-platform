INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ARCENIO GONCALVES DA SILVA JUNIOR', NULL, '11991291913', NULL, NULL, '(11) 9912-91913 Em contato com Arcenio, o mesmo informa que tentou migrar para a Bradesco saúde\ncom um corretor de sua confiança, porém sem êxito por conta de sua esposa ter doenças pré-existentes\nFalado sobre a portabilidade das carências e prestada a consultoria, cliente permaneceu achando não ser possível\nEnviei mensagem no whatsapp do mesmo para permanecer no radar, retornar o contato após o reajuste\nde julho e para tentar trazê-lo!', '2024-01-09 16:17:30');
