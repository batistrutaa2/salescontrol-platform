INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'TELMA ALVES', '76382893820', '1155732992', '11934658582', '11956691312', '(11) 5573-2992 Em contato com telma, cliente informa que paga menos de R$ 7.000,00 \nCotado Amil S750 e valores não bateram os atuais, a mesma informou também que não possui \nCNPJ para migrar para um plano empresarial!', '2023-07-27 14:12:25');
