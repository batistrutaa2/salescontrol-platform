INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROGERIO AGUIRRE NETTO', '07302348863', '1132596034', '11999321793', '11941211403', '(11) 9993-21793 - em contato com ele, informou tar sozinho no plano pois se separou da esposa, pediu que eu retornasse por volta de umas 19h30 pois agora nao podia falar. informar que ele sozinho nao da e questionar se nao tem algum socio ou funcionario. \n(11) 9412-11403 - \n(11) 3259-6034 - \n\nem busca no assertiva\n\n(11) 3305-2029 - \n\n38.353.127/0001-67 - empresa ativa SP \n00.728.079/0001-71 - empresa ativa SP tb \ntem benf com a porto', '2023-04-18 17:33:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROGERIO AGUIRRE NETTO', '07302348863', '1132596034', '11999321793', '11941211403', 'falei com ele ontem 19h30. Ele vê que a esposa paga um custo legal por um plano diamante,  pois ele recebe o boleto para pagar a parte dos filhos, alegou também que paga 3.600 na qualicorp, falei da porto as condições \nDe aceitação de agregados e tal, ele questionou se podia ser funcionário falei que sim, que da pra filiar e tal \nporem ele questionou que se as pessoas saíssem da empresa ele perde o plano, falei que teoricamente sim. \naconselhei que é melhor que seja sócio ou familiar.', '2023-04-19 11:08:57');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROGERIO AGUIRRE NETTO', '07302348863', '1132596034', '11999321793', '11941211403', 'mandado wpp pra ele com todas as regraas de aceitação e valores percapta', '2023-04-19 11:09:26');
