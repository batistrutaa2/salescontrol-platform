INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUIZ ROBERTO FERNANDES MARTINS', '59909307804', NULL, '11950309226', '11996639710', '11 98291-9104 Em contato com filha Juliana, a mesma se interessa pela proposta Amil One S2500 \nFiz contato antes com funcionária Marilene no telefone 2 \nA mesma passou que irmã dela e filha do titular , nome Caroline tam CNPJ \nGostou das cotações e passou as idades da irmã, de sua sobrinha, cunhado e também de seu esposo. \n\nEnviado via whatsapp e a mesma vai dar um retorno para marcarmos a reunião presencial!', '2023-08-09 16:52:41');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARCOS VINICIUS DA SILVA', '76904121815', '1236754296', '11996251412', NULL, '(11) 9962-51412 Em contato com Marcos, abordado como "  contato antigo " .\n\n O mesmo informa que está na justiça com a sulamérica e só irá ver de migrar para a Bradesco caso o \nseu processo com a sulamérica não corra bem', '2023-08-28 16:16:28');
