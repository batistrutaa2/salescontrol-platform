INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'NILO CESAR BRAGA S DE LIMA', '87446537434', '8335660181', '83986101521', '83986101520', '(83) 9861-01520 - não atendeu', '2023-01-16 11:30:57');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'NILO CESAR BRAGA S DE LIMA', '87446537434', '8335660181', '83986101521', '83986101520', 'CLIENTE AFAVEL.\nTELEFONE 3.\nELE ESTÁ NA UNIMED DESDE 2021. ELE QUER VOLTAR PARA SULAMERICA. FALOU SOBRE PORTABILIDADE E \nDISSE ATÉ SOBRE A CARTA QUE PEGA NO SITE DA ANS.\nELE TEM CNPJ, ELE E A MULHER SÃO SOCIOS, E QUER UTILIZAR PARA O SEGURO.\n\nCLIENTE NÃO POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI EMPRESA ABERTA - CONFIRMOU NA LIGAÇÃO.', '2023-03-13 14:43:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'NILO CESAR BRAGA S DE LIMA', '87446537434', '8335660181', '83986101521', '83986101520', '(83) 9861-01520 - mandei wpp ontem, como quem queria retomar só, nao to falando que é da pesquisa \nliguei agr e deu caixa postal', '2023-03-14 11:36:55');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'NILO CESAR BRAGA S DE LIMA', '87446537434', '8335660181', '83986101521', '83986101520', '(83) 9861-01520 - NÃO PODIA FALAR, FALOU QUE LEMBRAVA DE MIM E QUE SEMANA QUE VEM FALAVA \nCMG', '2023-03-17 15:37:10');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'NILO CESAR BRAGA S DE LIMA', '87446537434', '8335660181', '83986101521', '83986101520', '(83) 9861-01520 - não atendeu, mandei wpp', '2023-04-03 14:33:28');
