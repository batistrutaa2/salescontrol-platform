INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ALLINE VALADAO FERNANDES', NULL, '(11)99475-9889', NULL, NULL, 'Em contato com ele, questionei quanto ao CNPJ, se ele estava abrindo, ele disse que ja enviou a documentação \npara a contabilidade e que esta indo. Questionou quanto a carência, pois a mulher fez uma cirurgia a 3 meses da \nretirada de um câncer no rim. Pedi a ele que preenchesse uma declaração de saúde para que pudéssemos \navaliar, ele falou que qlq coisa deixa a mulher na qualicorp e troca ele e os filhos. Vamos ver!', '2022-08-03 10:09:02');
