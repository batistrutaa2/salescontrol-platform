INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'GERALDO DE SOUZA DIAS FILHO', '76400794891', '1139693278', '11996891150', '11974992353', '(11) 9968-91150 - Esposa do cliente informou que irá manter tudo como esta;', '2022-09-14 11:57:53');
