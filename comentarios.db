INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'SILAS MIUDO DO AMARAL', '70135258804', '1141197477', '11993141187', '11985936659', '(11) 9931-41187 - Em contato com Cida esposa do cliente e também com o Silas através deste contato. Apresentaram insatisfações pelo preço. E por ser um plano Enfermaria Cida informou ter empresa. E querem saber condições para melhorias em seu plano. Indico Amil - 2 vidas compra de carência até 81 anos Solicitou retorno 11/01 - a partir das 10:00 horas da manhã.\ntabulação feita pelo kaique', '2023-01-11 15:30:32');
