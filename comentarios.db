INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'IVO LUIZ POLETTO', '1051474868', '1138899873', '11999006130', '11998459239', '(11) 9990-06130 Em contato com Ivo e esposa Vera, cliente se interessa \npela proposta, enviado Bradesco Saúde TQN2 por email: poletto.vera@gmail.com\nExplicado sobre entrevista médica, cliente pagando 15 mil reais mensais\nBradesco com agravo ficou mais atrativo, o mesmo informa não possuir doenças\npré-existentes. \nRetornar na próxima semana com argumentos de fechamento!', '2023-01-12 12:05:15');
