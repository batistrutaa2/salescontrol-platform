INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'INAHY BARRERO', '14385331871', '1150723599', '13996076636', '11976998015', 'em contato com ela, disse que devido a patologia no grupo familiar, não quis especificar o que aconteceu, mais \ninformou que não tem como mudar de plano agora, ja falei por cima da portabilidade abrir mei e tal. Ela não deu \nmta atenção, perguntei se eu podia ligar, ela disse que não, que ela tem meu numero e quando for a hora vai \nme contatar. MANDEI UM WPP PRA FICAR RESCENTE', '2023-04-03 11:27:05');
