INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'EDUARDO PEREIRA L FILHO', NULL, NULL, '(11)99689-4149', '(11)4617-3935', 'em contaot com ele, teve reajuste, plano foi para 11 mil, porem nao tem o que fazer a mulher \nprecisa fazer os procedimentos, perguntou de prevent que um amigo dele comentou que tinha e era bom \ne falei tb de amil duas vidas, pq o filho dele foi morar fora e nao tem mais a possibilidade dele entrar \npediu pra enviar via email e ret mais no fim do mes pra irmos nos atualizando', '2023-07-03 16:42:28');
