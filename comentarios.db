INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'IVAN LEONARDO A F E SILVA', '13547606896', '11993273915', '11981223715', NULL, '1° Contato - Cliente afável, se interessou em receber a cotação pra ele e família, esta na BRADESCO e de inicio passou somente as vidas da família sendo: 51/53/22/13. \n\n2° Contato - Cliente se interessou pelo produto e sendo assim perguntou se era possível a inclusão dos sócios, me dando a abertura e o contato de sua secretária (Iara) para me informar as idades do quadro societário para a cotação \n\n3° Contato (Iara) - A secretária informou que o Dr/Sócios não acharam grande diferença de valores equiparando com o plano atual, sendo assim enviamos uma nova cotação COPE com tabulação para melhor apresentar. \n\n4° Contato 23/05 - Kaique entrou em contato com o Dr e o mesmo disse que a Iara viu  de fato uma redução de custo no COPE, sendo assim será passado ao Dr Ivan e Sócios para uma confirmação...', '2023-05-23 10:16:53');
