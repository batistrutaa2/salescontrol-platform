INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'KELEM DE NEGREIROS CABRAL', '03524632440', '11986426515', '11986426515', NULL, '(11) 9864-26515 Em contato com Dra via listagem, a mesma aceita receber proposta Porto Seguro\n\nCliente passa as idades do esposo e filho, informa estar na sulamérica executivo , abordagem curta\nEnviada no whatsapp, retornar para falar sobre os benefícios, fazer comparação dos custos e quem sabe\ntentar marcar uma reunião!', '2023-05-22 10:43:15');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'KELEM DE NEGREIROS CABRAL', '03524632440', '11986426515', '11986426515', NULL, '(11) 9864-26515 Em retorno com Dra. Kelem, a mesma alega que não tem tempo para nada e que\nnão conseguiu olhar\nSolicitei uma data para retornar a cliente, a mesma informa que não tem tempo para marcar o retorno\nTentar enviar mensagem via whatsapp', '2023-05-30 16:28:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'KELEM DE NEGREIROS CABRAL', '03524632440', '11986426515', '11986426515', NULL, '(11) 9864-26515 Em retorno com cliente, a mesma informa que está em atendimento novamente\nPede retorno depois da 13h para falar sobre o assunto, retornarei!', '2023-06-29 11:47:01');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'KELEM DE NEGREIROS CABRAL', '03524632440', '11986426515', '11986426515', NULL, '(11) 9864-26515 Em retorno com Kelem, cliente informa que vai começar um atendimento\nsolicita retorno em um horário mais oportuno!', '2023-07-11 16:07:56');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'KELEM DE NEGREIROS CABRAL', '03524632440', '11986426515', '11986426515', NULL, '(11) 9864-26515 tentativa de contato, telefone só chamou!\n\nEm contato com Dra via listagem, a mesma aceita receber proposta Porto Seguro\n\nCliente passa as idades do esposo e filho, informa estar na sulamérica executivo , abordagem curta\nEnviada no whatsapp, retornar para falar sobre os benefícios, fazer comparação dos custos e quem sabe\ntentar marcar uma reunião!', '2023-07-28 11:57:39');
