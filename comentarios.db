INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'JOAO BAPTISTA M DE O NOVAES', '28185529825', '8AWF7', NULL, NULL, 'Em conversa com Joao ele informou que sua mãe retorna do Europa quarta-feira e não havia visto a rede \ncredenciada. Joao também informou que seu plano tem Eistein e Sirio e pediu que enviasse um estudo incluindo \neles por mais que não tenha tanta necessidade. Retornar na segunda feira para conversar sobre', '2023-10-10 12:01:44');
