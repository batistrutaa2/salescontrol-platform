INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ADRIANO LUIZ GUERRA', '19101073877', '11985782887', '11992492887', NULL, '(11) 9857-82887 - abordei como porto, deixou mandar cotação, disse que eram 49/48, nao quis ja queimar \ne dizer a questao das 3 vidas, mandei cotação editada e dps irei abordar 3 vida ou partir pra amil', '2023-04-18 15:50:38');
