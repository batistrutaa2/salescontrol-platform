INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ERTON RIVO BANCHER', '25541206847', '1147294526', '11999436789', '11996555643', '11 99655-5643 Em contato com Ivone, cliente informa que comparou e ainda não vai trocar \nno momento. Prefere ver como a sulamerica vai reagir nesse ano de 2023 e alega que fez\numa redução com a propria qualicorp. Pede um retorno após 3 meses para de fato sabermos\ncomo está o interesse comercial em uma troca\nLigar futuramente!', '2023-01-16 11:37:49');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ERTON RIVO BANCHER', '25541206847', '1147294526', '11999436789', '11996555643', 'TELEFONE 3 - IVONE MULHER DELE.\nAFAVEL MAS UM POUCO ARISCA\nELA RECLAMOU QUE NO SAO CAMILO NÃO CONSEGUE FAZER EXAMES, E ALGUNS MEDICOS TBM DESCREDEN.\nESTÁ COM VARIOS PROBLEMAS NO REEMBOLSO. O PLANO DELA ESTÁ MUITO RUIM, DO FINAL DO ANO PRA CA.\nELA FEZ UMA ATUALIZAÇÃO NO MES 06 DE 2022, ACREDITAMOS QUE ESTA PAGANDO EM TORNO DE 5400\n\nCLIENTE POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-10 17:14:54');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ERTON RIVO BANCHER', '25541206847', '1147294526', '11999436789', '11996555643', 'Tentativa de retorno , telefone só chamou!', '2023-03-20 16:24:08');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ERTON RIVO BANCHER', '25541206847', '1147294526', '11999436789', '11996555643', '(11) 9965-55643 Em contato com Ivone, a mesma aceita receber cotações de melhoria\nNão rendeu muito assunto ao entender  ser uma nova contratação, porém disse que iria comparar \njunto com esposo. \n\nNo retorno, tentar contornar mais a situação trazendo o interesse e falando do reajuste!', '2023-03-21 12:07:36');
