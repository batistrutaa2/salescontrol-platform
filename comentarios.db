INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEANDRO ALVES FREITAS DOS SANTOS', 'MARCELO F SOUZA', '10672146827', '11996392880', NULL, NULL, 'PRIMEIRO CONTATO NO DIA 27/09, TENTEI NEGOCIAR, MANDEI COTAÇÕES, MAS SEM SUCESSO. HOJE\nRETORNEI COM A PESQUISA, ELE ME DEU ATENÇÃO, DISSE QUE QUER ABAIXAR O VALOR SEM PERDER OS\nHOSPITAIS QUE POSSUI. "QUALQUER 700 REAIS JA AJUDA". TELEFONE 2 O DELE. ENVIANDO COTAÇÕES\nBRADESCO E PORTO SEGURO PARA O KAIQUE FAZER O SEGUNDO CONTATO.', '2024-03-27 12:10:32');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEANDRO ALVES FREITAS DOS SANTOS', 'MARCELO F SOUZA', '10672146827', '11996392880', NULL, NULL, '11996392880 - Em contato com o cliente o mesmo se interessou pelos valores. Porém existe receio em\nquestão de utilizar a empresa pois tem outros sócios. Informei que não é necessário a inclusão dos demais\nsócios no seguro e o mesmo solicitou o envio da cotação via WhatsApp. Retornar segunda feira para alinhar\numa reunião com o mesmo.', '2024-03-27 12:11:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEANDRO ALVES FREITAS DOS SANTOS', 'MARCELO F SOUZA', '10672146827', '11996392880', NULL, NULL, 'Cliente informou que esta fazendo a abertura da empresa não somente para efeito do plano de saúde e sim\npara outros fins também. Solicitou mais tempo para começarmos a implantação pois esta resolvendo com\nseu contador.', '2024-03-27 12:12:04');
