INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'PATRICIA LUCCHESI CENTOFANTI', '17689484883', '1143270549', '11996890853', '11992428484', '(11) 9924-28484 - abordei como brazil health e ela falou que quer conversar sim porem agr tava trabalhando \ne nao conseguia falar, amanha ela ia trabalhar ate mais cedo e pediu que eu ligasse 17h30', '2023-02-09 16:15:06');
