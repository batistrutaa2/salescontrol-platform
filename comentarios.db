INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'ADALBERTO KIOCHI AGUEMI', '57203067904', '1134763365', '11999908971', '11988401831', 'DEPOIS DE VARIAS TENTATIVAS DE CTT CONSEGUI ACHAR A ESPOSA ANNE NO CTT 91558-4866 ONDE A MESMA DISSE QUE AUMENTOU MUITO O VALOR DO PLANO MAS QUE ESTA ABERTA PARA RECEBER A COTAÇÃO E ESTUDAR JUNTO AO MARIDO UMA POSSIVEL TROCA', '2023-10-02 16:34:18');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'ADALBERTO KIOCHI AGUEMI', '57203067904', '1134763365', '11999908971', '11988401831', 'EM RETORNO COM A ANNE ESPOSA DO ADALBERTO APRESENTEI MELHOR O MATERIAL OFERECIDO, TIREI AS DUVIDAS DELA SOBRE CARENCIA E IREI RETORNAR AINDA ESSA SEMANA PRA MARCAR REUNIÃO', '2023-10-09 09:59:23');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'ADALBERTO KIOCHI AGUEMI', '57203067904', '1134763365', '11999908971', '11988401831', 'ESTIVE EM NOVO CONTATO COM A ESPOSA QUE É A ANNE E ELA INFORMOU QUE FIZERAM UM DOWNGRADE NO ESPECIAL 100 DELA MUDANDO ELE PRA COPAR, SENDO ASSIM CREIO QUE MINHA PROPOSTA NA BRADESCO PRA FAMILIA AINDA SIM ESTA SENDO VANTAJOSO PRA ELES, ENVIEI NOVAMENTE O ESTUDO, EXPLIQUEI SOBRE A ABERTURA DO CNPJ SOMENTE PARA O PLANO ELA MOSTROU INTERESSE SENDO ASSIM IREI RETORNAR NA PROXIMA SEMANA PRA MARCAR UMA REUNIÃO', '2023-11-22 14:28:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'ADALBERTO KIOCHI AGUEMI', '57203067904', '1134763365', '11999908971', '11988401831', 'TENTATIVA DE RETORNO SEM SUCESSO', '2023-11-28 10:37:42');
