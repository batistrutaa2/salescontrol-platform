INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JUNQUEIRA IE SOCIEDADE DE ADVOGADO', NULL, NULL, NULL, NULL, 'CNPJ de São Paulo, Porto Seguro Diamante reduziu para : R$ 7.849,69\nContato da titular Lavinia: \n(11) 97205-4368     (11) 3815-9510  (11) 97246-8600 \nTentativa de contato, telefones só chamaram, tentar novamente', '2024-02-21 16:44:14');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JUNQUEIRA IE SOCIEDADE DE ADVOGADO', NULL, NULL, NULL, NULL, '(11) 97205-4368  Em contato com Lavinia, a mesma se interessa pelo projeto e questiona os benefícios \nserem os mesmos, apesar da redução de R$ 1000,00 mensal, a mesma sofrerá reajuste em julho, solicita\ncotação da Porto Diamante em seu whatsapp para avaliação, a mesma sana algumas dúvidas de carências em \nlinha. Cotação enviada, retornar com fechamento', '2024-02-22 14:29:08');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JUNQUEIRA IE SOCIEDADE DE ADVOGADO', NULL, NULL, NULL, NULL, '(11) 97205-4368 Em contato com Lavinia, a mesma disse que entendeu a proposta porém não teve muito\ntempo, ressaltei todo tema em linha com as melhorias, a mesma informa que irá passar a secretária que é\nquem trata do assunto, e iria passar o contato dela para mim, aguardando!', '2024-02-29 14:44:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JUNQUEIRA IE SOCIEDADE DE ADVOGADO', NULL, NULL, NULL, NULL, '(11) 97205-4368 Fiz contato com a secretaria Karol no numero 11- 45502784\nA mesma passa o email carolina.kanda@jlegalteam.com e solicita toda a apresentação com as cotações\ne valores da Porto, informa que observando a redução, irá solicitar os documentos para a transição do seguro\nManter-se próximo para levar ao fechamento', '2024-02-29 15:16:32');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JUNQUEIRA IE SOCIEDADE DE ADVOGADO', NULL, NULL, NULL, NULL, '11- 45502784 Em contato com Karol a mesma informa que por ter algumas questões a frente ela só\nvai conseguir analisar a proposta na próxima semana, e solicita um retorno para tratarmos e chegarmos a uma\nconclusão\nRetornar contato!', '2024-03-05 11:07:49');
