INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'PEROLA DE OLIVEIRA M MICHELETTI', '22708717820', NULL, NULL, NULL, 'Em conversa com Perola a mesma informou que tem um diagonostico desde 2012 e que toma medicamento de \n6 em 6 meses no Einstein.  Expliquei para a mesma sobre Portabilidade e então pediu que enviasse um estudo \nincluindo dois filhos (4 e 2) e seu marido (38).\nRetornar em breve para marcar reunião.', '2023-08-07 13:44:31');
