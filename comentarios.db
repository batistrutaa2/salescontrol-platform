INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'MARIA CECILIA SQUASSONI', '25922095811', '1155712210', '11982811041', NULL, 'TELEFONE 2 CLIENTE SUPER AFAVEL. ELA NÃO TEM PROBLEMAS COM UTILIZAÇÕES, E UTILIZA O HCOR QUANDO PRECISA. MAS SABE DAS COISAS QUE VEM ACONTECENDO NA SULAMERICA, E COMO É MEDICA, ATÉ ONDE TRABALHA VEM SAINDO PACIENTES QUE PASSARAM COM ELA POR UM BOM TEMPO E HOJE NÃO CONSEGUEM MAIS. ELA CITOU QUE TEM VONTADE DE TROCAR DE PLANO, POSSUI CNPJ E SABE QUE É POSSIVEL PAGAR MAIS BARATO DO QUE ELA PAGA HOJE. ESTA ESPERANDO UM RETORNO COM UMA MELHORA NO CUSTO. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-05-31 17:26:18');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'MARIA CECILIA SQUASSONI', '25922095811', '1155712210', '11982811041', NULL, 'COTAÇÃO ENVIADA, OURO MAIS... CLIENTE DISSE DO INTERESSE DE INCLUIR O PAI (83) DENTRO DISSO SERÁ OFERECIDO A PARTE UM PLANO PRA ELA E O FILHO E OUTRO SOMENTE PARA O PAI', '2023-06-12 15:52:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'MARIA CECILIA SQUASSONI', '25922095811', '1155712210', '11982811041', NULL, 'Em contato, a cliente informou que recebeu porém não conseguiu avaliar ainda. Ressaltei os benefícios por telefone e a mesma solicitou retorno na próxima semana.', '2023-06-15 11:37:38');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'MARIA CECILIA SQUASSONI', '25922095811', '1155712210', '11982811041', NULL, 'EM NOVO CONTATO COM A MESMA ELA PEDIU PARA EU LIGAR NA SEGUNDA FEIRA', '2023-09-15 15:40:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'MARIA CECILIA SQUASSONI', '25922095811', '1155712210', '11982811041', NULL, 'EM NOVO CONTATO COM A CLIENTE A MESMA DISSE QUE NÃO ACEITA AMIL DE FORMA ALGUMA SENDO ASSIM PERGUNTEI DE OUTRA VIDA PARA COTAR OUTRA OPERADORA E ELA DISSE TER SOMENTE O PAI DE 83 ANOS QUE ESTA NA SULA ESPECIAL TBM, FALEI SOBRE PORTABILIDADE E ELA ACEITOU RECEBER A COT COM ELE', '2023-10-09 18:37:46');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'MARIA CECILIA SQUASSONI', '25922095811', '1155712210', '11982811041', NULL, 'A MESMA A TEMPOS QUE NÃO CONSEGUIU NEM OLHAR O MATERIAL ENVIADO E SEGUE NA MESMA SITUAÇÃO, HOJE ENTREI EM CTT PARA APRESENTAR A CAMPANHA DA BRADESCO PORÉM PRECISO QUE ELA PRIMERO VISUALIZE A COT', '2023-11-13 13:13:14');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'MARIA CECILIA SQUASSONI', '25922095811', '1155712210', '11982811041', NULL, 'ESTOU SEMPRE EM CTT COM A DRA POR WHATS PORÉM A MESMA SEMPRE ESTA BEM CORRIDA, NÃO CONSEGUIU ESTUDAR O MATERIAL QUE ENVIEI E TUDO MAIS E PRA NÃO SER CHATO TODA HORA CHAMANDO COMBINEI COM ELA DE RETOMAMOS O ASSUNTO EM JANEIRO, ONDE A MESMA COMBINOU E DISSE QUE VAI TIRAR ESSE TEMPO ENTÃO PARA DARMOS CONTINUIDADE NO ASSUNTO', '2023-12-13 14:40:35');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'MARIA CECILIA SQUASSONI', '25922095811', '1155712210', '11982811041', NULL, 'A MESMA CONFIRMOU CMG UMA CALL NA QUINTA-FEIRA AS 14HRS', '2024-01-29 15:49:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'CASSIA SOARES DA SILVA', '05279539899', '1126477844', '11992082883', '11976503993', 'TELEFONE 2 CLIENTE AFAVEL. ELA TEVE UM AUMENTO DE 130% (SEGUNDO ELA, FAIXA ETARIA) NÃO TINHA MAIS CONDIÇÕES DE PAGAR, E AGORA ESTA ADERINDO AMIL. FAZENDO UMA PESQUISA, ELA DEVE TER ENTRADO NO REGIONAL COM COPARTICIPAÇÃO, POIS ELA ME DISSE QUE IRÁ PAGAR 1.331,00 E NO PAINEL UM NOVO SERIA 1.500,00. ELA JA PEDIU A CARTA DE PERMANENCIA, ESTÁ EM PROCESSO DE ACEITAÇÃO. FALOU QUE PREFERE WHATS OU E-MAIL POIS NÃO ATENDE NUMERO DESCONHECIDO (ME ATENDEU KKKK) CLIENTE POSSUI BENEFICIO NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-05-31 17:27:42');
