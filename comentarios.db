INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FELIPE CHALELLA NOGUEIRA', '33231721830', '11999871284', '11994916245', NULL, '(11) 9998-71284 Em contato com cliente através do número 2, cliente informa ser o numero da esposa\ne passa o telefone 1 como contato e também o email atualizado no sistema. \n\nEnviada propostas referente a Amil Saúde one e selecionada, Bradesco Saúde top nacional no email descrito. \nCliente informa que está na Porto diamante, através da empresa de sua esposa que é CLT\nAparentemente gosta dos custos, sana dúvidas de reembolso e atendimentos . \nO mesmo confirma retorno na próxima semana para sabermos opinião dele sobre as propostas. \n\nRetornar!', '2023-05-16 15:14:13');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FELIPE CHALELLA NOGUEIRA', '33231721830', '11999871284', '11994916245', NULL, '(11) 9998-71284 Tentativa de retorno, telefone para contato só chamou!', '2023-06-07 15:06:34');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FELIPE CHALELLA NOGUEIRA', '33231721830', '11999871284', '11994916245', NULL, '(11) 9998-71284 Tentativa de retorno, telefone para contato só chamou!', '2023-06-30 14:10:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FELIPE CHALELLA NOGUEIRA', '33231721830', '11999871284', '11994916245', NULL, '(11) 9998-71284 Em retorno com Felipe, o mesmo informa que irá utilizar o plano CLT\nO mesmo alega não ter custo e informa que é a opção mais viável do momento!', '2023-07-11 16:16:13');
