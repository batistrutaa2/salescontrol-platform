INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'DANIEL LIEBERT', '34757998805', '1141139930', '11999745375', NULL, 'EM NOVO RETORNO COM O CLIENTE POR WHATS, O MESMO DISSE QUE NÃO TEM INTERESSE NAS OPÇÕES DE ABERTURA DE CNPJ QUE EU APRESENTEI E DISSE QUE IRIA ABRIR UM MEI E ESPERAR OS 6 MESES PARA VOLTARMOS A FALAR', '2023-08-15 15:06:37');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'DANIEL LIEBERT', '34757998805', '1141139930', '11999745375', NULL, 'EM NOVO CTT PARA SABER SE CORREU CERTO A ABERTURA DO MEU O CLIENTE ME MANDO ESTA MENSAGEM... \n\n\'\'Ainda não abri.. devo voltar ao mercado de trabalho em breve e daí ou abro CNPJ ou pego plano da empresa, qualquer coisa te aviso\'\'', '2023-12-01 15:47:00');
