INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SERGIO ANTONIO MALAMAN', '02364611849', '11982347044', '11983940632', NULL, '(11) 9839-40632 Em contato com esposa Marilene, cliente aceita receber proposta da Amil Saúde\n\nA mesma informa que o custo do seu plano está muito alta e informa estar na sulamérica especial 100 \npela qualicorp junto com seu esposo. \nEnviada a proposta da Amil saúde 750 no email descrito acima, cliente aceita retorno para a próxima semana\n\nRetornar com argumentos de fechamento para reunião \nCliente possui CNPJ aberto !', '2023-06-02 16:18:16');
