INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'GISELY DE SOUZA ROCHA ALMEIDA', NULL, '7598827-4128', NULL, NULL, '298.276.238-26\nTELEFONE DO LEAD CORRETO.\nCLIENTE AFAVEL MAS NÃO DEMONSTROU MUITO INTERESSE.\nRECLAMOU MUITO DO REEMBOLSO, ONDE ELA TENTA E TENTA E NÃO CONSEGUE NENHUM REEMBOLSO.\nO VALOR ELA DIZ ESTAR MUITO ELEVADO.\nELA ACEITA RECEBER UMA LIGAÇÃO COM UMA POSSIVEL MELHORA, MAS NÃO DEMONSTROU MUITO INTERESSE.\n\nCLIENTE NÃO POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-04-05 14:43:03');
