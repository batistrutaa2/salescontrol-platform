INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'WILMA DE VASCONCELOS SOUSA', NULL, '1197174-3020', NULL, NULL, '(11) 9717-43020 - nem contato com ela, abordei ser Bradesco, tentei entender as utilizações e sondar o que \nela estava achando do plano, perguntou se eu era da Bradesco mesmo, mantive firme e disse que sim, ela então \ncomeçou a falar, disse que não usa o plano só a filha dela, e  gosta de passar no sírio. Confirmei e ela disse estar \nna qualicorp! Disse que muitas pessoas ligam pra ela e que ela nao tem empresa, ja estava até farta de dizer. \nP\nPerguntei se ela conhecia da abertura de empresa, falei bem por cima ela ficou super animada, e disse\n nao conhecer. perguntei se um corretor parceiro poderia contatá-la para apresentar ela disseque sim, pode\nka \nem busca no assertiva \nnao tem empresa mesmo \n\nolhei o cpf dela na bradesco rede e parece estar ativo em um plano pj pois a nomenclatura é PERSONAL VIII/PSNQ\n\nidade dela no assertiva ta 40 anos', '2023-02-27 15:30:12');
