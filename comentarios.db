INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FRANCIS CHRYSOLOGO DE FIGUEIREDO', '68112386820', '1123724573', '13997765268', '11982282200', '(11) 9822-82200 Consegui contato com cliente nesse número, o mesmo informa que no momento não\npode falar e solicita retorno em 30 minutos \n\nCotações das concorrentes ficaram atrativas , retornar o contato!', '2023-07-21 11:07:06');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FRANCIS CHRYSOLOGO DE FIGUEIREDO', '68112386820', '1123724573', '13997765268', '11982282200', '(11) 97392-0542 Esposa passa esse numero como o número do cliente, o abaixo era o do filho\nCliente ja está com negociação com a qualicorp, valores da Porto Seguro ficaram muito atrativos!', '2023-07-25 12:20:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FRANCIS CHRYSOLOGO DE FIGUEIREDO', '68112386820', '1123724573', '13997765268', '11982282200', 'Em retorno com Francis, cliente informa que fez acordo com a propria qualicorp e mudou seu plano\npara sulamérica empresarial!', '2023-07-26 14:28:10');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FRANKLIN SILVA FRANK', '41560370882', '1150839679', '11999999493', '11991334405', '(11) 9999-99493 Em contato com Dr Franklin, o mesmo se interessa pela proposta Amil S750 R2\nCliente sana dúvidas sobre abertura de empresa, solicita retorno para segunda-feira a tarde\nO mesmo trouxe a vida da esposa que também está na sulamérica especial 100 pela qualicorp \n\nRetornar o contato para marcar a reunião com o cliente!', '2023-07-21 11:54:17');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FRANKLIN SILVA FRANK', '41560370882', '1150839679', '11999999493', '11991334405', '(11) 9999-99493 Em retorno com o mesmo, cliente informa que no momento não irá mexer no seu plano\nsolicita retorno futuro para saber se é do interesse ainda a questão da transição!', '2023-07-25 12:09:36');
