INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ERIKA KAMEYA DA SILVA', '79491286153', '65981118700', '65981118700', NULL, 'Foi feito todo o acompanhamento desse caso via whatsapp , diversos contatos me mantendo \npróximo, quando o mesmo concluiu a abertura da empresa, entrei em contato\nCliente me passou que a sua cunhada é corretora de planos de saúde e escolheu fazer a troca \ncom a mesma\nTomara que seu plano se cancele sozinho.', '2023-05-09 10:37:49');
