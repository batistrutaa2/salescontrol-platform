INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ANA VALERIA ANDRADE SANTOS', '51663937591', NULL, '79998809781', NULL, '(79) 9988-09781 - Em contato com cliente, passada proposta referente a Bradesco Saúde! \nTNP6 e TNP8 \nA mesma reside em Sergipe Aracaju e possui um CNPJ ativo com seu esposo 31.351.491/0001-49\n760.917.754-72  Cpf do esposo GERALDO DE OLIVEIRA JUNIOR com números \n(79) 99645-6263\n(79) 99880-9724\nCliente informa que esposo está na Omint com filhos e passa as idades 52, 19 e 17 . \nRessaltado que Omint não atende em Aracaju e seu esposo utiliza através dos reembolsos! \nEnviada cotação no whatsapp da mesma com o mesmo grupo familiar com endereço de aracaju \nRetornar com argumentos para fechamento a cliente !', '2022-09-08 14:58:46');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ANA VALERIA ANDRADE SANTOS', '51663937591', NULL, '79998809781', NULL, '(79) 9988-09781 - Tentativa de retorno, sem sucesso!', '2022-09-15 12:14:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ANA VALERIA ANDRADE SANTOS', '51663937591', NULL, '79998809781', NULL, '(79) 9988-09781 - Em contato com Ana, cliente informa que irá reavaliar propostas \ne informa que chegou a comentar com seu esposo Geraldo, reforçada as propostas\nretornar com argumentos de  fechamento .', '2022-09-22 10:54:40');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ANA VALERIA ANDRADE SANTOS', '51663937591', NULL, '79998809781', NULL, '(79) 9988-09781  Em retorno com Ana, cliente ressalta que assim como havia me dito \nna primeira abordagem, seu esposo não iria querer mudar de plano devido a estar\nsatisfeito em seu plano com a Omint, a mesma prefere permanecer na Sulamérica com\nduas vidas pelo plano física por adesão!', '2022-10-03 11:29:40');
