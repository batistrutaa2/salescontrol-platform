INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'INAHY BARRERO', '14385331871', '1150723599', '13996076636', '11976998015', 'INAHY BARRERO\n\n (11) 98494-8859 - Em contato com a cliente, a mesma informou que esta insatisfeita com seu plano atual por conta do descredenciamento dos Hospitais Hcor e Oswaldo Cruz. E costuma também usa o BP Mirante.\nInformou ter interesse em conhecer opções de novos planos que são concorrentes da Sula e não possui CNPJ.\n\nRetornar com opção de Bradesco e Qualicorp.\n\n14/09/1967 14385331871 SUL AMERICA ESPECIAL APM 53/19/16 5230,74\nEsse é o registro da pesquisa do kaique e nao to conseguindo falar com ela quero abordar abertura', '2022-12-02 12:08:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'INAHY BARRERO', '14385331871', '1150723599', '13996076636', '11976998015', 'nao atendeu', '2022-12-12 16:22:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'INAHY BARRERO', '14385331871', '1150723599', '13996076636', '11976998015', '(11) 98494-8859 - Em contato com a cliente, informou que não tava podendo falar, pediu pra cotar e enviar no \nwhats, idades são esposo 61/55/20/18', '2023-01-19 11:50:14');
