INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LIDIANE INDIANI', '18384051860', '1138910895', '11997024037', '11945465105', '(11) 9970-24037  Em contato com Lidiane, cliente se queixa dos valores e informa\nque aceita receber uma proposta de troca dentro da própria sulamérica. \nPaga plano para seu sobrinho de 21 anos que se encontra no Especial 100 . \nA mesma informa que a Sulamérica custeia um medicamento para uma doença auto-imune\nEnviado Sulamérica executivo com 2 participantes, sem falar de taxa de angariação. \nRetornar com argumentos de fechamento a mesma para fazer tentativa de troca administrativa.', '2022-12-22 11:16:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LIDIANE INDIANI', '18384051860', '1138910895', '11997024037', '11945465105', '(11) 9970-24037  Em contato com Lidiane, cliente se queixa dos valores e informa\r\nque aceita receber uma proposta de troca dentro da própria sulamérica. \r\nPaga plano para seu sobrinho de 21 anos que se encontra no Especial 100 . \r\nA mesma informa que a Sulamérica custeia um medicamento para uma doença auto-imune\r\nEnviado Sulamérica executivo com 2 participantes, sem falar de taxa de angariação. \r\nRetornar com argumentos de fechamento a mesma para fazer tentativa de troca administrativa.', '2022-01-15 16:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LIDIANE INDIANI', '18384051860', '1138910895', '11997024037', '11945465105', '(11) 9970-24037 Em contato com cliente, a mesma se diz interessada na proposta\nporém se queixa quanto ao sobrinho, a mesma gostaria de ingressa-lo em uma categoria\ninferior ao executivo. Passado as regras de contratação, cliente pede mensagem no whats\ne informa que em uma semana irá dar uma respostas!', '2023-01-30 15:01:58');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LIDIANE INDIANI', '18384051860', '1138910895', '11997024037', '11945465105', 'SÓ CHAMOU, VOU FAZER A PESQUISA E TENTAR TRABALHAR NOVAMENTE ESTE CLIENTE.', '2023-03-15 17:43:07');
