INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ADRIANO LUIZ GUERRA', '19101073877', '11985782887', '11992492887', NULL, 'CLIENTE PRAGMATICO. ESTÁ PAGANDO 2.900,00 COM O REAJUSTE DO MES PASSADO. NÃO TEM NENHUM PROBLEMA COM UTILIZAÇÕES. COMENTOU SÓ DO AUMENTO DO VALOR, MAS SEM BRECHAS PARA UMA CONVERSA. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-02-13 10:06:48');
