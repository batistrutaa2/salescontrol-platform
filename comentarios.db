INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'IRIS HENRIQUE MEINBERG', '27626997891', '8130978578', '11999512689', '11973390650', 'KAIQUE EM CONTATO COM O CLIENTE, FOI INICIADO A NEGOCIAÇÃO DE AMIL 750 R1.\nO MESMO NO INICIO NÃO SE INTERESSOU PELO FATO DE NÃO TER APROXIMIDADE COM A EMPRESA, POREM APOS OUVIR OS VALORES SOLICITOU TODAS AS INFORMAÇÕES POR E-MAIL, PARA QUE POSSAMOS MARCAR UMA REUNIAO PRESENCIAL EM NOSSA EMPRESA.\nTAMBÉM SOLICITOU COMPARAÇÃO COM A SULAMERICA SAUDE.\nINFORMOU O E-MAIL: IRISMEINBERG@HOTMAIL.COM TAMBEM INFORMOU  O PESSOAL DELE: 11999344244', '2022-10-10 11:41:08');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'IRIS HENRIQUE MEINBERG', '27626997891', '8130978578', '11999512689', '11973390650', 'Tentativa de contato, sem sucesso.', '2022-10-26 11:46:26');
