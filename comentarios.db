INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'RUBENS GOMES JOSE', '21784507849', NULL, '11999753182', '11981385050', '(11) 9813-85050 Em contato com Cleide, cliente informa que está entrando no banho\r\nAbordado o assunto sobre o seguro saúde, cliente se interessa e pede retorno amanhã as 10h \r\nRetornar com valores atuais!', '2023-05-11 17:13:56');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'RUBENS GOMES JOSE', '21784507849', NULL, '11999753182', '11981385050', '(11) 9813-85050 Feito cotações com agravo para retornor , valor na Amil ficou R$ 6.626,72\nValor atual da cliente : R$ 5.303,91 \nA mesma está com liminar, retornar após o seu reajuste de julho para tentar trazer uma proposta de melhoria!', '2023-05-12 10:49:39');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'RUBENS GOMES JOSE', '21784507849', NULL, '11999753182', '11981385050', '(11) 9813-85050 - Em contato com Rubens, o mesmo informa que está com liminar, por isso, \nnão poderá trocar o plano de saúde no momento!\nApós reajuste, valor pago pelo cliente foi para R$ 5.600,00', '2023-07-18 10:50:16');
