INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CARLOS TADASHI YOSHIZAKI', '25308977860', '1146523504', '11975003829', '11997425813', 'Jaqueline boa tarde! O meu convênio sulamerica já retornou a liberação dos laboratórios como no mês de novembro de 2022. Logo, não vou trocar pelo Bradesco .\n\n\nSim, já tive esse aumento. E o  valor ficou um pouco a mais que a do Bradesco.\nInfelizmente , tenho pré conceito com o Bradesco devido à vários problemas de autorização de exames na minha área de medicina fetal .\n\n\nTENTANDO VENDER PORTO BRADESCO ELE TEM PRECONCEITO', '2023-05-04 13:05:04');
