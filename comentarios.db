INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'ANA CLAUDIA BRANDÃO', '8467329807', '11999121556', NULL, NULL, 'Em contato com a cliente, a mesma informou que seu marido é funcionário do Einstein e possui plano pela empresa. Estão reestruturando o plano de saúde e possivelmente passaram a ter atendimento no Einstein através do novo plano do hospital. Solicitou retorno no próximo mês para acompanhamento deste caso. Pois caso não aconteça o esperado por eles, iram optar pela mudança.', '2023-05-16 10:59:58');
