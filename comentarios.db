INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DOMINGOS AFONSO MACHADO', '2272808816', '11996132052', '11998206694', '11999305000', '2272808816 - Possui benefícios com a Porto Seguro! 11 99930-5000 - Em contato com esposa Bet, a mesma aceita receber proposta e se interessa pelos produtos Ouro Porto Seguro.  A mesma informa que possui MEI e sana algumas dúvidas, informa que irá avaliar e solicita retorno na próxima semana para sabermos uma posição. Retornar com argumentos para reunião ou visita.  Email de envio das cotações : betti.onouye@hotmail.com , domingozafonzomachado@gmail.com', '2022-06-23 15:23:21');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DOMINGOS AFONSO MACHADO', '2272808816', '11996132052', '11998206694', '11999305000', '(11) 9993-05000 - Em contato com esposo Domingos, o mesmo alega não ser ele quem trata, pede retorno um 1 hora para esposa!', '2022-07-13 15:47:11');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DOMINGOS AFONSO MACHADO', '2272808816', '11996132052', '11998206694', '11999305000', 'tentativa de contato sem sucesso', '2022-07-28 14:03:58');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DOMINGOS AFONSO MACHADO', '2272808816', '11996132052', '11998206694', '11999305000', '11 99930-5000 - Enviada cotação via whatsapp para Betti \nCliente informa que não possui CNPJ porém cita abertura \nde um MEI para formalizar o plano, pede também cotação\npor adesão. Enviado Porto Seguro e Seguros Unimed adesão. \nA mesma informa que sogra está internada, e que irá avaliar \nquando tiver tempo. Retornar com argumentos de fechamento', '2022-08-02 14:48:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DOMINGOS AFONSO MACHADO', '2272808816', '11996132052', '11998206694', '11999305000', '11 99930-5000 - Em contato com Betti, cliente informa que não \nteve tempo de olhar cotações por conta da doença da sogra. \nPorém consegui contornar o plano física e abordar bem o plano empresarial\nfalado bastante sobre abertura de empresas e valores de plano empresarial\npara Bradesco e SulAmérica, cliente gosta e informa que precisa conversar\ncom seus esposo, pois o mesmo que tem o receio dessa contratação. \nRetornar nos próximos dias ou semanas para marcar reunião com esposo \ndomingos e passar todos os benefícios desse plano .', '2022-08-24 11:26:14');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DOMINGOS AFONSO MACHADO', '2272808816', '11996132052', '11998206694', '11999305000', '11 99930-5000 - Em contato com Betti, cliente informa que não \nteve tempo de olhar cotações por conta da doença da sogra. \nPorém consegui contornar o plano física e abordar bem o plano empresarial\nfalado bastante sobre abertura de empresas e valores de plano empresarial\npara Bradesco e SulAmérica, cliente gosta e informa que precisa conversar\ncom seus esposo, pois o mesmo que tem o receio dessa contratação. \nRetornar nos próximos dias ou semanas para marcar reunião com esposo \ndomingos e passar todos os benefícios desse plano .', '2022-09-05 11:13:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DOMINGOS AFONSO MACHADO', '2272808816', '11996132052', '11998206694', '11999305000', '11 99930-5000 - Em tentativa de retorno, telefone para contato só chamou!', '2022-09-26 16:42:07');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DOMINGOS AFONSO MACHADO', '2272808816', '11996132052', '11998206694', '11999305000', '11 99930-5000 Em contato com Betti, cliente informa que sua sogra ainda se encontra\ninternada! A mesma ainda não pode tratar o assunto, mas informa que a sulamerica \nesta reembolsando em um mês, antes era mais rápido\nFalado sobre o benefício da sulamerica estar desatualizado, e procurar se manter perto\nda cliente para evoluir a negociação com seu esposo após a situação melhorar!', '2022-10-25 12:28:30');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DOMINGOS AFONSO MACHADO', '2272808816', '11996132052', '11998206694', '11999305000', '11 99930-5000 Em retorno com Betti, falado sobre troca de plano e diversos assuntos\nSogra da cliente ainda não está bem, mandado cotações via whatsapp da Bradesco Saúde\nConsiderando reajuste da faixa-etária de idade de seu cliente, retornar futuramente \ncom argumentos de fechamento!', '2022-12-15 12:02:16');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DOMINGOS AFONSO MACHADO', '2272808816', '11996132052', '11998206694', '11999305000', 'TELEFONE 3, BETTI DIZ ESTAREM SEM PLANO, E QUE SAIRAM JA DA QUALICORP, MAS AGRADECEU A MINHA\nLIGAÇÃO.\nPENSAR EM FAZER UMA ABORDAGEM DIFERENTE, ENTREVISTA SEM SUCESSO.', '2023-03-15 17:19:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DOMINGOS AFONSO MACHADO', '2272808816', '11996132052', '11998206694', '11999305000', '(11) 9993-05000 Em contato com Betti, a mesma informa que migrou para Prevent Senior pessoa física\nAlega que seu custo está muito baixo e não pretende mudar no momento .', '2023-11-07 11:02:07');
