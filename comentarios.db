INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MOBIBRASIL TRANSPORTE DIADEMA LTDA', NULL, '1121552500', NULL, NULL, '2155-2500 Em contato com Debora, resp do RH, me identifiquei como Bradesco, campanha para empresas de recife no segmento de transportes. Ela informou que poderia enviar um email no Deboralima@mobibrasil.com apresentando e solicitando informações para que pudessemos fazer uma proposta, que devido a LGPD ela nao ia informar nada e ia checar internamente o que poderia ser passado a nos neste caso', '2022-06-28 11:45:52');
