INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE RENATO SATIRO SANTIAGO JR', '7245115800', '9235842186', '11996000010', NULL, '(11) 9960-00010 Em contato com Nilceia, esposa do cliente .\nA mesma se queixa quanto ao reajuste e também ao descredenciamento da parte\nlaboratorial do Samritano, onde saiu da linha ESPECIAL 100\n\nEnviada Amil One S1500 via whatsapp, cliente informa que irá fazer comparação efetiva\nSe queixa quanto ao reajuste do seu plano e sana duvidas de carência e contrato\n\nretornar para tentativa de marcar reunião ou fechar contrato!', '2023-01-30 11:02:50');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE RENATO SATIRO SANTIAGO JR', '7245115800', '9235842186', '11996000010', NULL, '(11) 9960-00010 Em retorno com Nilceia, a mesma informa que visualizou e entendeu a proposta\r\nA mesma me passou que esposo está viajando e retorno na próxima semana, retornar via ligação ou\r\nwhatsapp para tentar contato com esposo, passando a proposta o mesmo e tentando marcar a reunião!\r\nRetornar ..', '2023-02-09 10:12:54');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE RENATO SATIRO SANTIAGO JR', '7245115800', '9235842186', '11996000010', NULL, '(11) 9960-00010 Em tentativa de retorno, telefone para contato da cliente só chamou !', '2023-03-27 11:43:23');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE RENATO SATIRO SANTIAGO JR', '7245115800', '9235842186', '11996000010', NULL, '(11) 9960-00010 Tentei contato com cliente a mesma desligou em face\nManter cliente no muito interesse e retornar próximo ao reajuste ou no mês do mesmo. \nTrazendo novamente a proposta da Amil que melhora suas condições, permanecer no radar!', '2023-05-11 14:16:50');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE RENATO SATIRO SANTIAGO JR', '7245115800', '9235842186', '11996000010', NULL, '(11) 9960-00010 Em novo retorno com Nilceia, cliente informa que no momento não irá migrar\npara a Amil por conta do seu esposo estar fazendo novos acompanhamentos e ter medo de carências\nDado todo o suporte na transição sobre o contrato sem carências, contornado as objeções\nCliente informa e ressalta que no momento não vão trocar por essas questões!', '2023-08-15 10:43:11');
