INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIANA GARCIA VILLELA', '30132180880', '1141533961', '11982650066', NULL, 'retornei pra ela, ela disse que tem meu contato, se for fechar vai fazer vomigo, mais que ela e o marido tao numa \nconfusão ai, nao explicou bem, disse que agr nao vao mexer e nem quer opção duas vidas, que qnd forem mexer \nela vai me ligar. Pedi pra poder ligar em nov, ela pediu que nao, pra deixar que se ela for mudar ela me liga', '2022-07-22 16:23:49');
