INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'ROSELI FERREIRA DA SILVA', '10819565857', '1142271184', '11999207424', '11972504559', 'PESQUISA  24-05-2023\r\n\r\n(11)987734556 - TELEFONE DELA EXTREMAMENTE AFAVEL E FALA DE UMA FORMA UM POUCO LENTA, BASTANTE PACIENCIA ELA ESTA MUITO DESCONTENTE COM O PLANO, POIS TENTOU FAZER UM EXAME NO HCOR E NÃO FOI AUTORIZADO, E QUANDO ELA FOI PAGAR A PARTE DOI ALGO EM TORNO DE 100 REAIS, ENTÃO FOI MUITA SACANAGEM AO VER DELA. O VALOR ESTÁ ALTO E ELA CITOU POR DIVERSAS VEZES NA LIGAÇÃO QUE ELA TEM OS PAIS QUE ESTAO PAGANDO CARO, E QUE SOMADO TODOS DA CASA, É ALGO EM TORNO DE 20 MIL REAIS. ENTÃO ELA ESTA ESPERANDO O RETORNO COM UMA POSSIVEL MELHORA NO CALOR MAS SEM PERDER OS BENEFICIOS QUE ELA JA TEM. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE NÃO POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-05-31 11:23:45');
