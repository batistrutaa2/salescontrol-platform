INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA EDITH DE AZEVEDO MARQUES', '02538244862', NULL, NULL, NULL, '(13) 98174-7700 Em contato com cliente , a mesma aceita receber cotações e sanas muitas dúvidas. \nSe queixa do valor pago atualmente, passa a idade do esposo de 79 anos no Amil One \nE também a do filho de 38 e nora de 32, informa que eles usam Einstein e Sírio, e que ela está grávida para\nter bebe e ja querem inclui-lo em um plano novo. \n\nA mesma informa que filho ou nora possui CNPJ, que irá levantar o cenário para me passar \nEnviada em seu whats cotações da Amil e Bradesco, porém no cenário atual, melhor opção é Amil pelas idades!\nRetornar!', '2024-04-26 12:11:10');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA EDITH DE AZEVEDO MARQUES', '02538244862', NULL, NULL, NULL, '(13) 98174-7700 Em contato com cliente, a mesma informa que sua nora teve complicações no parto e que\nfuturamente retornava o contato, pois não estão com cabeça para tratar do assunto agora!', '2024-05-14 15:41:07');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA EDITH DE AZEVEDO MARQUES', '02538244862', NULL, NULL, NULL, '(13) 98174-7700 Em contato com cliente, a mesma informa que sua nora teve complicações no parto e que\nfuturamente retornava o contato, pois não estão com cabeça para tratar do assunto agora!', '2024-05-14 15:41:08');
