INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'MARCELO PICOLO FUSARO', NULL, NULL, '(11)99880-2692', '(11)4713-1190', '(11) 9988-02692 - abordei como Porto, não me deixou concluir a primeira parte da abordagem informou que \nnão tinha interesse eu falei nao que nao sei o que a porto consegue manter o padrão o custo menor ele disse\n "vou te falar dnv, não tenho interesse, já tenho plano"', '2022-07-11 15:40:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'MARCELO PICOLO FUSARO', NULL, NULL, '(11)99880-2692', '(11)4713-1190', 'em contato com ele, me identifiquei como qualicorp, ele disse que eu tinha os dados dele indevidamente \nque ele ia adicionar meu nome e meu numero numa lista de investigação da policia federal', '2022-08-08 14:40:52');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'SERGIO ALBINO BITAR PINHEIRO', NULL, NULL, '(91)98131-9451', '(91)3344-7600', '(91) 9813-19451 - informou que ta cansada de gnt ligar e ela falar que nao quer que a qualicorp atende bem,\n falei mais vcs podem ter um benf tao bom quanto, pagando menos, ela falo que eles nao querem sair\n da qualicorp e agradeceu o contato', '2022-07-11 15:02:47');
