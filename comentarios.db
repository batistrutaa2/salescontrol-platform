INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', 'Tentativa de contato sem sucesso!\n(11) 9990-17375 Só chamou  ( telefone para contato do cliente )\n(11) 9990-16323  Em contato com atendente, a mesma não quis informar nada sobre o cliente\nPossui participações em empresa!', '2022-10-13 15:28:10');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Em contato com Juliana ( esposa do Frederico ) \nCliente informa que saiu da Sulamérica e está na Porto Seguro Diamante R2 \n\nInformado pela mesma possuir empresa em Itú, cotado Bradesco Saúde TNP4\nValores ficaram bem atrativos, enviado via whatsapp \n\nRetornar com argumentos de fechamento!', '2022-12-20 11:52:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Em tentativa de retorno, telefone para contato só chamou \nRetornar', '2023-01-09 12:30:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Em contato com Juliana, cliente solicita retorno para\r\nsexta-feira no período da manhã\r\nRetornar!', '2023-01-13 11:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Em contato com Juliana, cliente informa que está de férias\r\nA mesma pede retorno para a primeira semana de fevereiro para receber uma\r\napresentação mais detalhada do produto \r\nRetornar e tentar marcar reunião, apresentação de produto!', '2023-01-16 11:19:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Em contato com Juliana, cliente foi receptiva e informou estar ocupada\r\nSolicita retorno quinta feira no final do dia\r\nCombinado com cliente após as 17h30', '2023-02-14 16:47:34');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263  Fiz retorno com esposa Juliana . \n\nA mesma informa que não sabe o valor que paga atualmente na Porto Diamante ( em consulta\nno site constam boletos empresariais com 30 vidas ) \n\nRetomei assunto da Bradesco com endereço de empresa de Itú, cliente informa ser o esposo quem\npaga o plano e precisa comparar com o mesmo os valores para saber se é válido uma troca. \nPede nova cotação do TNP4 via whatsapp , enviada a mesma . \n\nretornar com argumentos de fechamento e tentar contato com esposo Frederico por intermédio \nda mesma, pois segundo ela, ele quem trata referente ao assunto!', '2023-03-09 11:46:06');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Em tentativa de retorno, telefone para contato só chamou!', '2023-03-21 16:41:34');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263  Em contato com Juliana, a mesma informa que está analisando junto com esposo\nque no momento ainda não chegaram a uma conclusão, que quando tiverem irá me contatar\n\nTentar contato com esposo para passar benefícios e quem sabe marcar uma reunião\nLigar novamente após duas semanas!', '2023-03-29 11:15:49');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Em contato com Juliana, a mesma informa que no momento está ocupada mas pede\num retorno para segunda - feira, onde consegue me atender com mais calma\nIrei retornar para retomar negociações!', '2023-06-29 15:52:07');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Em retorno com Juliana, cliente informa que no momento está tendo uma transição\nno emprego, e que esse tema será resolvido no futuro, no momento não irá tratar!', '2023-07-13 16:16:53');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Em contato com cliente, a mesma informa que ainda está na Porto Saúde Diamante\nEnviada duas propostas de melhoria para comparação com seu seguro, sendo Bradesco e Sulamérica\nInforma que está satisfeita com seu seguro e que iria avaliar com seu esposo se ele possui interesse na troca\n\nretornarei o contato!', '2023-08-30 15:23:48');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Cliente informa que ainda está no Diamante e que não teve tempo de comparar propostas\nabaixo, solicita mensagem no whats com atualização das propostas na próxima semana, pois essa está corrida\nEnviar para a mesma e tentar descobrir valor que vem pagando atualmente com a Porto!', '2023-10-11 10:54:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Em contato com Juliana, cliente informa que ainda estão no diamante e que por hora\nnão querem mudar. Tentei contornar objeção falando sobre o reajuste, a mesma desconversou falando ser\no marido quem trata\nTentar um contato futuro!', '2024-03-12 15:51:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FREDERICO DE MELLO E F DA CUNHA', '10661428826', '1140228463', '11999017375', '11999016323', '(11) 98280-5263 Em retorno com cliente, a mesma permanece sem interesse e está satisfeita na Porto\nSeguro Diamante', '2024-08-02 11:03:22');
