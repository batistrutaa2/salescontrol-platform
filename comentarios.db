INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'EDUARDO PEREIRA L FILHO', NULL, NULL, '(11)99689-4149', '(11)4617-3935', '(11) 9968-94149 - em contato com ele, alegou ainda não ter sido notificado pelo reajuste, perguntei se podíamos \nretomar e tal atualizou idades 72/65 e 30 o filho para quem sabe Bradesco saúde. Mandei por email e ret amanha', '2023-04-11 11:27:03');
