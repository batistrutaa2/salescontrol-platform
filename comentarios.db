INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ALESSANDRA B DE O L B R SANTOS', '07056491723', NULL, '11976169550', '11992861388', 'email enviado \n\nFiquei de te enviar um e-mail segunda pela manhã para que pudéssemos checar se esta semana o Sr. poderia me receber, juntamente com meu gestor Kaique para uma reunião presencial Dr. \n\nEntendemos a seriedade deste assunto e acreditamos poder reduzir o valor do plano sem discrepância de atendimento. O valor atual de vocês esta impraticável. \n\nTrabalhamos com todas as operadoras e vamos encontrar o melhor cenário a vocês. \n\nNa quinta-feira, as 10h o Sr. poderia nos receber ? \n\nAtt,', '2022-08-08 10:36:20');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ALESSANDRA B DE O L B R SANTOS', '07056491723', NULL, '11976169550', '11992861388', '(11) 9928-61388 - disse que dnv não podia falar, meus e-mails não responde, perguntei se podia ligar amanha \npara vermos se podíamos agendar uma reunião ele disse que nao, que ele vai ver e ele mesmo me retorna\n\nvou pedir pro kaique fazer uma seg voz sei la tentar me ajudar em algo', '2022-08-15 17:45:19');
