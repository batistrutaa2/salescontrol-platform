INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'ANA CLAUDIA BRANDÃO', '8467329807', '11999121556', NULL, NULL, 'TENTAMOS REALIZAR A PORTABILIDADE DO PAI DA DRA PARA PREVENT TODO PROCESSO FOI FEITO E QUASE FINALIZADO ATÉ ELA PEDIR PRA CANCELAR TUDO PORQUE O IRMÃO DELA TEM CONTATO COM OS DONOS DA PREVENT', '2023-08-11 11:06:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'ANA CLAUDIA BRANDÃO', '8467329807', '11999121556', NULL, NULL, 'EM NOVO CONTATO COM A CLIENTE A MESMA INFORMOU QUE O PAI DELA QUE TENTAMOS MUDAR PARA PREVENT ACABOU FALECENDO, E QUE SE MANTEM OS ATENDIMENTOS QUE O MARIDO DELA TEM POR SER MÉDICO DO EINSTEIN OU SEJA, ELA ME DISSE QUE ELES REDUZIRAM CUSTO MAIS DE 10K E ESTÃO SATISFEITOS POR ENQUANTO COM ESSA CONDIÇÕES... QUEM SABE EM UM FUTURO PROX EXISTA UMA MELHOR OPÇÃO PARA APRESENTAR', '2024-01-17 10:24:38');
