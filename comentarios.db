INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'SUMIO MATSUNAGA', '49358510820', '(11) 3473-9231', '(11) 9660-55788', '(11) 9969-90578', 'Cliente disse estar interessado, falo que a 1 mês iniciou uma conversa com a corretora dele sobre o assunto. Porém ela não falou para ele sobre a portabilidade, ele ira conversar com o Filho e vamos ver uma dia para uma reunião.', '2024-07-05 13:27:04');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'SUMIO MATSUNAGA', '49358510820', '(11) 3473-9231', '(11) 9660-55788', '(11) 9969-90578', 'Reunião na BrazilHeath, amanhã as 10:00.', '2024-07-10 10:17:23');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'SUMIO MATSUNAGA', '49358510820', '(11) 3473-9231', '(11) 9660-55788', '(11) 9969-90578', 'Já abriram o CNPJ iniciaremos a implantação no dia 12/08.', '2024-07-19 12:05:06');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'VALTER TAKESHI NISHIYAMA', '00271097809', '1137318649', '11999796362', '11951348584', 'Me apresentei com representante Qualicorp, estava no transito porém já informou seu interesse em reduzir custo dos filhos.', '2023-07-07 16:41:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'VALTER TAKESHI NISHIYAMA', '00271097809', '1137318649', '11999796362', '11951348584', 'Cotação por WhatsApp, ele fez uma cirurgia em novembro no coração cateterismo e tem um pouco de receio de mudar apresentei Porto e Bradesco e falei também de portabilidade', '2023-07-10 10:00:10');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'VALTER TAKESHI NISHIYAMA', '00271097809', '1137318649', '11999796362', '11951348584', 'Ele ira fazer a Ablação no coração antes de fazer a troca de plano, ele quer fazer uma portabilidade pra ter mais segurança.', '2023-07-17 16:23:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'VALTER TAKESHI NISHIYAMA', '00271097809', '1137318649', '11999796362', '11951348584', 'Em contato iremos retomar dia 02/10, pois esta aguardando alguns exames que esta fazendo.', '2023-09-27 12:06:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'WILLIAM DOS SANTOS', '17842160899', '1123869260', '11998360275', '11991948959', 'Tem porto,\nGostou da proposta não tem CNPJ expliquei sobre e ficou de pensar.\n\nEncaminhei por WhatsApp', '2023-07-07 16:09:01');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'WILLIAM DOS SANTOS', '17842160899', '1123869260', '11998360275', '11991948959', 'Conversei com ele, a esposa faz um acompanhamento com remédio pelo plano de saúde e acompanhamento de 3 em 3 meses.', '2023-07-10 11:09:18');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'WILLIAM DOS SANTOS', '17842160899', '1123869260', '11998360275', '11991948959', 'Em contato por WhatsApp, esta conversando com a esposa pois a mesma tem medo pelo tratamento de \ncâncer  que ela fez. Enviei a cartilha da ANS, e ele pediu para aguardar que entrara em contato.', '2023-09-27 12:08:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'WILLIAM DOS SANTOS', '17842160899', '1123869260', '11998360275', '11991948959', 'Entrou em um novo emprego, e tem plano de saúde então não tem mais custo. E conseguiu levar a esposa.', '2024-07-04 17:45:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'JOSE ROBERTO LOPEZ VIDA', '168585812', '1134563342', '11974527622', '11997403960', 'Falei com representante Qualicorp com parceria com a BrazilHealth, falei sobre abertura de CNPJ mandei cotação por WhatsApp da Bradesco e Amil\n\nContato dele atualizado é 11-99628-8145', '2023-07-07 15:33:57');
