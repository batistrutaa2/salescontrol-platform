INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'SELMA SANTIAGO SANCHES', '04311730870', '1148279087', '11998468880', NULL, '(11) 9984-68880 - nao atendeu \n(11) 4827-9087 - em contato com ela, abordei como porto, expliquei o projeto, ela já alegou que é somente ela \ne que faz questao do ac camargo e bp, falei de abrir empresa e trazer um outro participante, pedi a idade da filha\nsendo 34 a 38, ela disse que dps falamos com calma ia ter que sair. simulei já no excel ela em produtos \nque tenha o ac camargo, e a filha dela nos amis básicos só pra compor. FALEI DE AMIL já que trabalho com \noutras operadoras. ela pediu ret terça que vem e eu falei que ia pensar em opções. bater na tecla do aumento \ndela em julho.  \n\nem busca no assertiva \n\nnao encontrei mais telefones ativos. \n\nnao encontrei CNPJ aberto \ntem benf com a porto/azul', '2023-04-19 14:52:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'SELMA SANTIAGO SANCHES', '04311730870', '1148279087', '11998468880', NULL, 'em contato com ela, falamos sobre valores pra ela e a filha, falei do reajuste e tal, ela pediu pra cotar com o ex esposo tb pai da filha dela, falei que teria que estar no cnpj tb e tal... Enfim conversamos um tempo e enviei tudo no wpp, valores pro ex esposo, rede pra ele rede pra filha e rede pra ela.', '2023-04-25 17:21:02');
