INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'ANTONIO FERREIRA APOLONIA', '59124350834', '11991146960', NULL, NULL, 'Cliente gostou da ideia da portabilidade pediu um resumo por e-mail e que retornasse em 1 mês. Não faz mais quimioterapia somente acompanhamento.', '2024-07-30 10:48:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'FERNANDA FREIRIA B THEODORO', '24817762837', '11992154898', NULL, NULL, 'Filho de 23 anos toma remédio de alto custo, a mesma disse que está com uma ação contra a SulAmerica para rever valores abusivos. Falei sobre a portabilidade ela se interessou muito e pediu cotação com a inclusão do esposo de 49 anos, encaminhei as informações via WhatsApp e aguardar para ela falar com o advogado.', '2024-07-30 12:18:06');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'CASSIA DE CARVALHO SAMMARTINO', '15118712882', '11999940605', NULL, NULL, 'Cliente se interessou muito pediu a inclusão da irmão de 45 anos e o Pai de 89 anos. Eles não tem CNPJ porém a abertura não será um problema. Pediu cotação por WhatsApp, ela disse que o pai acabou de sair da internação de uma cirurgia disse que essa semana não é possivel a reunião, mais que vamos conversando no WhatsApp para se alinhar.', '2024-07-30 17:11:27');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'CASSIA DE CARVALHO SAMMARTINO', '15118712882', '11999940605', NULL, NULL, NULL, '2024-07-30 17:12:16');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'MIRELE NAVERO DA SILVA', '17610341894', '(11) 9929-22197', NULL, NULL, 'Cliente pediu que retornasse amanhã 31/07 as 18:00', '2024-07-30 18:21:57');
