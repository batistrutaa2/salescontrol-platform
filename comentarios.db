INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'DANIEL ALVES FERREIRA', '20586245804', '1130813614', '11999749155', '11996535952', 'Cliente informou que acabou de fazer uma alteração na Sul America onde conseguiu baixar o custo do plano dele para 5 mil reais, mandei opção na porto e em outras operadoras que aceitam apenas 2 vidas.  50/20.mandei wpp pra ele', '2022-06-02 14:25:29');
