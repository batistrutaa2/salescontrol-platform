INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'RENATO GERMANO DOS ANJOS', '05538650804', NULL, NULL, NULL, 'Em conversa com a esposa Erta a mesma informou que gostaria de propostas apenas para Renato pois seu plano é \nmuito antigo tem um valor bom.\nEnviar no WPP e retornar esta semana para marcar reunião.', '2023-08-29 11:44:12');
