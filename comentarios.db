INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'JORGE GARROTE PAIVA', '50917307887', '1126496470', '11999149140', '11999710293', 'FOI ENVIADA UMA PROPOSTA COM A PORTO SEGURO ONDE EXISTIU UMA REDUÇÃO DE CUSTO CONSIDERAVEL, AGUARDANDO A ANALISE DO DR E DA ESPOSA PARA RETORNAR NOVAMENTE', '2023-07-03 14:15:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'JORGE GARROTE PAIVA', '50917307887', '1126496470', '11999149140', '11999710293', 'EM NOVO CONTATO COM A ESPOSA (SONIA) QUE É QUEM ESTAVA AVALIANDO O MATERIAL  A MESMA DISSE TER MAIS DE UMA DOENÃ PRÉ EXISTENTE E QUE UMA DAS PATOLOGIAS SERIAM SÉRIAS DEMAIS, E POR ELA JÁ TER TRABALHO COM PLANO DE SAUDE E ENTENDER ACHOU MELHOR NÃO MOVIMENTAR NADA NO PLANO', '2023-08-08 17:34:10');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'JORGE GARROTE PAIVA', '50917307887', '1126496470', '11999149140', '11999710293', 'RETOMEI O CONTATO COM A MESMA QUE ESTA DESCONTENTE AO MAX COM A SULAMERICA PORÉM AS OPÇÕES PRA ELA E PRO MARIDO TANTO POR IDADE QUANTO POR PRÉ EXISTENTE IMPOSSIBILITAM VARIAS ALTERNATIVAS UMA VEZ QUE ELA DEIXOU CLARO NÃO QUERER AMIL, SENDO ASSIM VOU PRECISAR BUSCAR SAIDA E PESSOAS JUNTO A ELA PARA ATIVAÇÃO DE UMA APÓLICE', '2024-01-17 16:56:15');
