INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GUSTAVO BERNARDES DE F OLIVEIRA', '91079047620', '1124780566', '11984019897', '11981920237', 'cliente meio fechado, disse que em aspecto utilização não tem o que falar porque ele nem usa! Que o que grande \nproblema é o preço, perguntei se outra equipe poderia contatar, ele disse que poderia enviar opções no email \ne só, perguntei se podia ser no whats, ele falo email, fiquei meio pa de perguntar qual era e ele perrecar, \nvou ligar com segunda voz e pronto. disse que tem empresa, perguntei amil e bradesco, ele falo ok, pode \nenviar tanto cnpj tanto apm que ele precisa mudar msm desse plano', '2022-11-16 17:22:13');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GUSTAVO BERNARDES DE F OLIVEIRA', '91079047620', '1124780566', '11984019897', '11981920237', 'nao encontrei email para envio de cotação, tentei ligar agr pra abordar como representante msm da bradesco, \nnao consegui ctt em nenhum dos números. quero conversar primeiro com ele, pq ele pediu pra nao manda no whats', '2022-12-01 16:24:07');
