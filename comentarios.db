INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'VANIA PIANCA', '04928908899', NULL, '11999434799', '11999436495', 'Em conversa com Vania a mesma demonstrou muita insatisfação com seu plano atual pois pagava 5 mil e foi \npara 7 mil, e tem receio de trocar por conta de seus problemas pulmonares. vania pediu que enviasse um \nestudo em seu wpp com 3 vidas de 63/35/36 onde atenda 9 de julho, samaritano entre outros.\n\n\nInformações:\nGUILHERME PIANCA MORENO - 35\n357.025.338-44 \n99664-7993\n94458-7306\n\nPIANCA ARQUITETURA LTDA\nCNPJ: 29.154.578/0001-84\n\nSócios\nGUILHERME PIANCA MORENO\nData de entrada: 27/11/2017\n\nVANIA PIANCA\nData de entrada: 27/11/2017\n\nVANIA PIANCA - 63\n049.289.088-99 \n99943-4799\n99943-4755', '2023-08-01 15:33:34');
