INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ALESSANDRA GONZAGA S DA SILVA', '26975761850', NULL, NULL, NULL, 'Consegui contato com irmã Adriana, a mesma passa as idades: 48/47/84/77 e o email: adrigonzaga_1@hotmail.com .\nPassa o cenário dos pais que estão pagando R$ 18.000,00 e sua irmã que reduziu do Executivo para o \nEspecial 100 por conta do custo. A Adriana encontra-se no Bradesco TNP4 pela empresa em que trabalha. \nSana diversas dúvidas sobre portabilidade e abertura de empresa, informa que ja pesquisou sobre \nportabilidade e ainda não encontrou uma empresa que garanta fazer.\nPassado as propostas e todo cenário em seu email, retornar na próxima semana com argumentos de \nfechamento para marcarmos uma reunião!', '2024-04-10 11:13:40');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ALESSANDRA GONZAGA S DA SILVA', '26975761850', NULL, NULL, NULL, '(11) 97027-6402 Em contato novamente com Adriana, a mesma solicita reenvio da cotação pelo email\nInforma que devido a correria não conseguiu ver porém pede retorno pelo whatsapp na próxima semana\npara tratarmos sobre a transição\nRETORNAR COM ARGUMENTOS DE FECHAMENTO!', '2024-05-28 14:33:48');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ALESSANDRA GONZAGA S DA SILVA', '26975761850', NULL, NULL, NULL, '(11) 97027-6402 Tentativa de contato, telefone só chamou! \nEnviada mensagem no whats e também reforçado os benefícios pelo email, informado sobre o reajuste\nda irmã Alessandra. Tentar contato!', '2024-06-14 09:24:16');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ALESSANDRA GONZAGA S DA SILVA', '26975761850', NULL, NULL, NULL, '(11) 97027-6402 Uma vez que a mesma não retorna as mensagens,  enviei cotação apenas para a irmã\nAlessandra da Omint C16 , para quem sabe adiantarmos a transição para a irmã!', '2024-07-24 16:30:59');
