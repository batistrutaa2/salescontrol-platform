INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'CRISTIANE MANSUR G RIBEIRO', '06894528888', '1125911753', '11987930392', '11953233121', 'EM NOVA TENTATIVA CONSEGUI SOMENTE FALAR COM O MARIDO NOVAMENTE QUE PEDIU QUE EU LIGASSE AMANHÃ CEDO', '2023-10-31 17:47:23');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'CRISTIANE MANSUR G RIBEIRO', '06894528888', '1125911753', '11987930392', '11953233121', 'EM CONTATO COM A MESMA ENTENDI O CENÁRIO ATUAL E ESCUTEI BASTANTE AS DORES DELA COM A SULA, SENDO ASSIM APRESENTEI O MELHOR PRODUTO PRA ELA INCLUINDO AINDA A VIDA DO MARIDO QUE MESMO ASSIM TROUXE REDUÇÃO DE CUSTO E MELHORA DE BENEFICIO PRA TODOS, A CLIENTE ME AGRADECEU MUITO NO FINAL DA LIGAÇÃO E PEDIU QUE EU ENTRASSE EM CTT COM O PAI E COM A IRMÃ QUE ESTÃO PASSANDO PELO MESMO CENÁRIO, PARA QUE EU POSSA AJUDA-LOS TAMBÉM', '2023-11-06 11:46:06');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'CRISTIANE MANSUR G RIBEIRO', '06894528888', '1125911753', '11987930392', '11953233121', 'EM RETORNO COM A MESMA REFORCEI SOBRE O BENEFICIO E SUAS ECONOMIAS, A MESMA PEDIU QUE EU ENTRASSE EM CTT PARA MARCARMOS UMA REUNIÃO DAQUI 15 DIAS POIS ELA PRECISA AINDA SIM REALIZAR ALGUNS PROCEDIMENTOS JÁ MARCADOS PELO ATUAL CONVENIO', '2023-11-09 15:51:15');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'CRISTIANE MANSUR G RIBEIRO', '06894528888', '1125911753', '11987930392', '11953233121', 'A CLIENTE ESTA ESTUDANDO A IDEIA DA PORTABILIDADE NO PLANO DO PAI E DA IRMÃ QUE SÃO A PARTE E TERIAMOS QUE USAR A VIDA DE UMA DAS FILHAS DELA PARA REALIZAR A INCLUSÃO.\n\n TENTEI CONTATO TBM PARA SABER SE ELA JÁ REALIZOU O PROCEDIMENTO QUE TINHA MARCADO PELA SULA PARA DARMOS ANDAMENTO NO PLANO DELA E DA FAMILIA DELA ATRAVÉS DE UMA REUNIÃO, PORÉM ELA DISSE QUE NÃO CONSEGUE FALAR COMIGO HOJE, RETORNAREI AMANHÃ', '2023-11-22 11:19:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'CRISTIANE MANSUR G RIBEIRO', '06894528888', '1125911753', '11987930392', '11953233121', 'ULTIMO CTT QUE TIVE  COM A CLIENTE A MESMA DISSE QUE AINDA NÃO CONSEGUIU REALIZAR O PROCEDIMENTO MÉDICO QUE ESTAVA MARCADO COM A SULA, DISSE TBM QUE NÃO IRIA MEXER NO PLANO DE SAUDE POR AGORA, IREI DEIXAR EM STAND-BY PARA O FUTURO', '2024-01-19 16:25:08');
