INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'WALTER PEREZ SCARANTO', '1449654886', '(11) 9910-99510', NULL, NULL, 'Cliente disse já ter sofrido o reajuste e está muito insatisfeito, pediu cotação por e-mail. E sinalizou que a esposa teve câncer  a 7 anos atrás e  é bariátrica, então falei de portabilidade gostou muito da opção.', '2024-05-08 09:56:45');
