INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ADRIANA CORREA DE SOUZA FERNANDES', NULL, '(21)99957-6261', NULL, NULL, 'Telefone que busquei no assertiva (21) 99924-8956 deu sucesso no contato, sinalizei ao leandro como troca - TRATATIVA COM ELA FOI A SEGUINTE: Cliente tem ciencia da vantagem do plano empresarial, porem não pode realizar uma abertura de CNPJ agora, pois ela é funcionaria publica e vai se aposentar ao fim do ano, informei a ela que o que poderia ser feito por hora seria uma alteração dentro da propria qualciorp, disse pra eu cotar e enviar. Fiz isso cotei Asprofili RJ Adesão sula e amil, amil pois ficou o mesmo valor da sula e ela teria o samaritano, apresentei estes pontos pra ela atraves do wpp juntamente com o envio do orçamento. (em outro momento, vou dizer a ela que tive a ideia de talvez fazer a abertura do CNPJ para o esposo ou filho dela)', '2022-06-08 15:17:33');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ADRIANA CORREA DE SOUZA FERNANDES', NULL, '(21)99957-6261', NULL, NULL, 'marido dela esta com covid, já havia me avisado no whats esqueci de anotar aqui, mandei uma msg hj perguntando se ele esta melhor.', '2022-06-14 11:22:53');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ADRIANA CORREA DE SOUZA FERNANDES', NULL, '(21)99957-6261', NULL, NULL, 'em contato com ela informou que o marido teve umas complicações e nao vai poder mudar mais agr, pediu pra eu ligar pra ela em Jan que vai ser o melhor momento pra migrar e que ela vai ter aposentado ai vai poder abrir', '2023-01-10 10:00:00');
