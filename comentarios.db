INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'DIRLEY BARRETO DE CERQUEIRA', '92216285587', '71981298458', '71981938558', '71981976230', 'CLIENTE AFAVEL.\nELE ENTROU COM UMA LIMINAR, E CONSEGUIU REDUZIR PARA 3.800,00 ESTÁ COMPLETAMENTE SATISFEITO\nCOM O PLANO ATUAL, E NÃO TEM NENHUMA QUEIXA A FAZER, NÃO TEM MENOR INTERESSE EM TROCAR.\nPESQUISA SEM SUCESSO.', '2023-03-16 12:48:03');
