INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'PAULO WAIZER NOVAES', '09285811876', '1147273720', '11999772419', '11999772134', 'Em conversa com Paulo o mesmo infomou ter o plano a muitos anos mas que gostaria de receber um email para \ncomeçar um estudo de acordo com sua configuração\nEmail ja enviado, retornar esta semana para colher informações e enviar o estudo', '2023-06-20 15:19:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'PAULO WAIZER NOVAES', '09285811876', '1147273720', '11999772419', '11999772134', '9997-72419 - Em conversa com Paulo o mesmo informou as idades de 58,9 e 43 anos. \nEnviado um estudo na porto em seu wpp', '2023-06-29 11:25:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'PAULO WAIZER NOVAES', '09285811876', '1147273720', '11999772419', '11999772134', 'Em conversa com Paulo o mesmo disse ter visto redução no custo e olhou a rede credenciada, mas como tem o \nplano a muitos anos e ja teve ótimos atendimentos até mesmo no caso que sua filha ficou internada por quase \num ano ele decidiu segurar um pouco mais para a troca de plano.\nLigar futuramente para verificar possibilidade de migrar de plano saindo da MUTUA já que o mesmo esta \ninsatisfeito com os reajustes', '2023-07-05 13:45:24');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'PAULO WAIZER NOVAES', '09285811876', '1147273720', '11999772419', '11999772134', 'Paulo informou que já fez a troca de seu plano de saude', '2023-08-09 16:18:38');
