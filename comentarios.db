INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'SENIR APARECIDA RAMALHO DE SOUSA', '91191815668', NULL, '11998297094', NULL, 'Jaqueline boa tarde! O meu convênio sulamerica já retornou a liberação dos laboratórios como no mês de novembro de 2022. Logo, não vou trocar pelo Bradesco .\n\n\nSim, já tive esse aumento. E o  valor ficou um pouco a mais que a do Bradesco.\nInfelizmente , tenho pré conceito com o Bradesco devido à vários problemas de autorização de exames na minha área de medicina fetal .\n\n\nTENTANDO VENDER PORTO BRADESCO ELE TEM PRECONCEITO', '2023-05-04 13:04:18');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'SENIR APARECIDA RAMALHO DE SOUSA', '91191815668', NULL, '11998297094', NULL, 'DESCONSIDERAR TABULAÇÃO ABAIXO, ERREI! ERA DE OUTRO CLIENTE', '2023-05-04 13:04:45');
