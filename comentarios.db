INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ELEIDA COELHO CICCI RAMOS', '03066089878', '24160', NULL, NULL, '(11) 99983-8565 Em contato com cliente, a mesma aceita receber proposta de melhoria na condição\nPassada a idade do filho de 38 anos e a do esposo de 68 anos\nO esposo se encontra no sulamérica executivo qualicorp pagando R$ 11.731,88\nO esposo possui participações em várias empresas . \n\nRetornar !', '2023-09-12 16:03:39');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ELEIDA COELHO CICCI RAMOS', '03066089878', '24160', NULL, NULL, '(11) 99983-8565 Em contato com cliente, a mesma informa que não conseguiu passar proposta ao \nesposo e a família\nReforçado o benefício da proposta, enviada mensagem no whats reforçando os benefícios \nPedir para o Kaique fazer segunda voz!', '2023-09-19 10:27:48');
