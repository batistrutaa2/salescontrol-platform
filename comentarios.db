INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LAERCIO JOEL FRANCO', '57095108820', '1155756676', '1639956186', '16997745000', 'Em contato com o cliente, o mesmo informou que esta insatisfeito com seu plano por estar pagando 10 mil reais para ele e sua esposa por um plano Básico Enfermaria. Solicitou retorno amanha as 10:00 horas para conversar sobre melhorias. Indico a Amil - Duas Vidas compra de carência até 81 anos. \r\n\r\nKaique Albertin', '2023-01-11 09:32:22');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LAERCIO JOEL FRANCO', '57095108820', '1155756676', '1639956186', '16997745000', 'Em contato com o cliente, o mesmo informou que esta insatisfeito com seu plano por estar pagando 10 mil reais para ele e sua esposa por um plano Básico Enfermaria. Solicitou retorno amanha as 10:00 horas para conversar sobre melhorias. Indico a Amil - Duas Vidas compra de carência até 81 anos. Kaique Albertin', '2023-01-11 15:20:24');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LAERCIO JOEL FRANCO', '57095108820', '1155756676', '1639956186', '16997745000', 'Em contato com o cliente, o mesmo informou que esta insatisfeito com seu plano por estar\n pagando 10 mil reais para ele e sua esposa por um plano Básico Enfermaria. \nSolicitou retorno amanha as 10:00 horas para conversar sobre melhorias. \nIndico a Amil - Duas Vidas compra de carência até 81 anos. Kaique Albertin', '2023-01-11 15:20:54');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LAERCIO JOEL FRANCO', '57095108820', '1155756676', '1639956186', '16997745000', '(16) 9977-45000 Em retorno, cliente se interessa pela proposta Amil S750 R1 \nReside em Ribeirão Preto, valores ficaram bem mais atrativos\nO mesmo solicita cotação por email, informa não possuir empresa, falado em \nlinha sobre abertura. Cliente pede retorno na próxima semana para sabermos\nopinião dele e de sua esposa , retornar!', '2023-01-11 15:22:24');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LAERCIO JOEL FRANCO', '57095108820', '1155756676', '1639956186', '16997745000', '(16) 9977-45000 Em retorno, cliente se interessa pela proposta Amil S750 R1 \r\nReside em Ribeirão Preto, valores ficaram bem mais atrativos\r\nO mesmo solicita cotação por email, informa não possuir empresa, falado em \r\nlinha sobre abertura. Cliente pede retorno na próxima semana para sabermos\r\nopinião dele e de sua esposa , retornar!', '2023-01-16 10:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LAERCIO JOEL FRANCO', '57095108820', '1155756676', '1639956186', '16997745000', '(16) 9977-45000 Em contato com Laercio, o mesmo sana algumas dúvidas quanto \na abertura da empresa. \nInforma que irá conversar com a esposa, entender de fato a proposta, nos demonstrou um pouco\nde insegurança. \nTratar com ele em retorno daqui duas semanas , para marcarmos uma reunião e de fato mostrarmos que\né uma troca muito segura, e que iremos ajuda-lo tanto no custo quanto benefício.', '2023-03-01 16:47:27');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LAERCIO JOEL FRANCO', '57095108820', '1155756676', '1639956186', '16997745000', '(16) 9977-45000 Em tentativa de retorno, telefone para contato do mesmo só chamou \nManter-se próximo ao cliente para abordar novamente a troca, se manter no radar!', '2023-05-11 14:19:31');
