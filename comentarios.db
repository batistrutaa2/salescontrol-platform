INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROSANGELA MACEDO FOLTRAN', '06306815899', '11999843051', '11945305860', '1125072218', '11999843051 - Retornar após as 19 hrs\r\nRosangela, escolha a opção desejada:\r\n\r\n1 - Cartão de Crédito\r\n2 - Seguro Auto\r\n3 - Seguro Saúde\r\n4 - Seguro Aluguel (Fiança)\r\n5 - Serviço para residência\r\n6 - Sinistro de Veículos\r\n7 - Cotar e contratar\r\n8 - Outros produtos Porto\r\n9 - Recomeçar com outro CPF/CNPJ', '2023-04-05 14:12:53');
