INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FABIO FLORIANO MELO MARTINS', '96022167353', '(11) 99935-2227', NULL, NULL, 'JA FOI FEITO UMA PESQUISA NO FINAL DO ANO. KAIQUE PEDIU PARA NÃO FAZER NOVAMENTE E FAZER ABORDAGEM PORTO SEGURO. CLIENTE POSSUI SEGURO AUTO PELA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA. ESSA FOI A PESQUISA NO FINAL DO ANO ANTERIOR: "CLIENTE COM MUITOS RECEIOS SOBRE MIM, POIS NÃO SABIA QUEM EU ERA. HÁ ANOS ATRAS, ELE TEVE UM PROBLEMA COM DESCREDENCIAMENTO DE HOSPITAIS QUANDO FOI USAR. FICOU BRAVO E TROCOU PARA A SULAMERICA. HOJE AO OUVIR HISTORIAS SOBRE O MESMO PROBLEMA, ELE ESTÁ COM A IDEIA DE TROCAR EXATAMENTE PARA NÃO TER O MESMO PROBLEMA DE QUANDO FOR USAR, NÃO ACEITAR. ELE FALOU SOBRE BRADESCO. ENTÃO A IDEIA SERIA OFERECER PARA ELE."', '2023-02-13 10:08:21');
