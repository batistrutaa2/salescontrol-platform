INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'APARECIDA TAVARES DE TOLEDO', '00339668857', '1139663252', '11981214636', '11969526018', 'Em conversa com Aparecida a mesma informou que costuma utilizar o São Camilo e que não tem outra vida para \nadicionar no estudo, mas ainda sim pediu que enviasse em seu WPP.', '2023-09-19 17:41:57');
