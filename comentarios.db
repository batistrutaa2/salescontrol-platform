INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'NILO CESAR BRAGA S DE LIMA', '87446537434', '8335660181', '83986101521', '83986101520', 'em contato com ele, me identifiquei, ele já questionou se eu era da brazil, falei que sim que trabalhava com o kaique e ele informou que vai mandar os docs no email que ele enviou. portabilidade mais faremos compra normal\npq não é nada grave a cirurgia que ele fez na uinimed', '2023-04-11 14:03:23');
