INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ALESSANDRA GONZAGA S DA SILVA', '26975761850', NULL, NULL, NULL, '(11) 98207-0517 Em contato com mãe da cliente Carmen, a mesma encontra-se na sulamérica\nqualicorp junto com seu esposo Nelson, pagando R$ 17.903,00 no especial 100\nMãe da cliente 72 anos e pai 82, os mesmos estão com receio de trocar por conta da idade. \nJa a irmã Adriana, consegui contato através do número (11) 97027-6402\nA mesma passou que é do interesse o assunto referente ao seguro saúde, pediu retorno hoje\nao retornar telefone para contato só chamou, manter-se no radar e também tentar o contato \ncom a irmã Alessandra para passar proposta de melhoria a todo o grupo .', '2023-10-24 10:17:12');
