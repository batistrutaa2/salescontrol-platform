INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCILENE RAPOSO FLORENTINO', '07606529884', NULL, NULL, NULL, '(11) 98491-4825 Em contato com cliente, a mesma informa que seu esposo sofreu um AVC porém que\nja está de alta e se recuperando, devido ao ocorrido, não poderá tratar disso no momento e solicita retorno\nno proximo mês!', '2024-06-18 16:29:26');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCILENE RAPOSO FLORENTINO', '07606529884', NULL, NULL, NULL, '(11) 98491-4825 Em novo contato, cliente informa que esposo Arlindo está tratando com outro corretor ! \n\nPorém a mesma aceita receber cotações da Bradesco para 3 vidas e Amil com 2 . Informa que irá contatar seu\nesposo Arlindo para quem sabe eu passa a proposta ao mesmo. \nRetornar!', '2024-07-15 14:10:33');
