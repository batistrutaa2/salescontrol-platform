INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SILVIA DE OLIVEIRA SAMPAIO', '6584343812', '1135532392', '11995978838', '11999964718', '(11) 9959-78838 Indisponível \n(11) 9999-64718 Só chamou \nPossui participação em empresa\nAssertiva com diversos numeros\nSem sucesso no contato', '2022-08-09 15:44:01');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SILVIA DE OLIVEIRA SAMPAIO', '6584343812', '1135532392', '11995978838', '11999964718', '(11) 9999-64718 Em contato com cliente , passada as idades 62/56/19/23\nCliente informa que reduziu categoria em acordo com SulAmérica \nPorém esposo está em outra apólice com a mesma categoria \nEnviada Porto Seguro Diamante no e-mail cadastrado \nRetornar com argumentos de fechamento', '2022-08-11 16:57:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SILVIA DE OLIVEIRA SAMPAIO', '6584343812', '1135532392', '11995978838', '11999964718', '(11) 9999-64718 Em contato com Silvia, cliente gosta dos valores e do benefício\r\nquestiona sobre as carências, e solicita retorno para o dia 25\r\nPois filha está fazendo um tratamento segundo ela e está acompanhando \r\nretornar com argumentos de fechamento a cliente', '2022-08-25 10:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SILVIA DE OLIVEIRA SAMPAIO', '6584343812', '1135532392', '11995978838', '11999964718', '(11) 9999-64718 Tentativa de retorno, telefone só chamou \r\nAgendado novo retorno para o fim do dia', '2022-08-26 17:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SILVIA DE OLIVEIRA SAMPAIO', '6584343812', '1135532392', '11995978838', '11999964718', '(11) 9999-64718 Em retorno com Silvia, cliente informa que sua filha teve um\r\ndiagnostico de uma doença complexa, a mesma informa que a filha passará \r\npor diversos exames, e que não poderá trocar de plano de saúde no momento,\r\nagendado um retorno para o final do ano afim de saber condições do tratamento\r\npara uma possível troca!', '2022-11-28 11:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SILVIA DE OLIVEIRA SAMPAIO', '6584343812', '1135532392', '11995978838', '11999964718', '(11) 9999-64718 Em retorno com Silvia, cliente informa que sua filha teve um\ndiagnostico de uma doença complexa, a mesma informa que a filha passará \npor diversos exames, e que não poderá trocar de plano de saúde no momento,\nagendado um retorno para o final do ano afim de saber condições do tratamento\npara uma possível troca!', '2022-08-29 10:00:27');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SILVIA DE OLIVEIRA SAMPAIO', '6584343812', '1135532392', '11995978838', '11999964718', '(11) 9999-64718 Em contato com Silvia, cliente informa que fez um acordo \ncom a própria qualicorp e reduziu seu custo em 50%, retornar futuramente\napós seu reajuste de julho para tentar passar outra proposta.', '2023-01-12 12:17:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SILVIA DE OLIVEIRA SAMPAIO', '6584343812', '1135532392', '11995978838', '11999964718', '(11) 9999-64718 Em contato com cliente, a mesma aceita receber novamente a cotação da Amil One\nS2500R1 \nCliente sana algumas dúvidas do plano empresarial e tem alguns receios, filho está em Londres, a mesma\nse interessa pelo seguro viagem internacional , e também pelos valores de reembolsos serem mais altos\nCliente informa que usa muito fisio e psicoterapia, enviada cotação em seu whats\n\nRetornar contato!', '2023-09-21 17:04:41');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SILVIA DE OLIVEIRA SAMPAIO', '6584343812', '1135532392', '11995978838', '11999964718', '(11) 9999-64718 Só chamou', '2023-10-11 10:50:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SILVIA DE OLIVEIRA SAMPAIO', '6584343812', '1135532392', '11995978838', '11999964718', '(11) 9999-64718 Em retorno com cliente, a mesma informa que devido a uma ortoplastia, não poderá\nmexer no seu plano esse ano, informa que provavelmente terá que fazer outra cirurgia. \nRetornar futuramente!', '2024-02-02 11:27:04');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SILVIA DE OLIVEIRA SAMPAIO', '6584343812', '1135532392', '11995978838', '11999964718', '(11) 9999-64718 Telefone para contato só chamou , tentativa de mensagem no whatsapp referente a cotação!', '2024-07-24 16:14:29');
