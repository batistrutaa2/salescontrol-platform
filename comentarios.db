INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DANIEL VARONI SCHNEIDER', '30151521816', NULL, '11971000530', '11971005016', '(11) 9710-00530 Em contato com cliente, o mesmo aceita receber propostas de melhoria no plano de saúde\n\nEnviado pelo whatsapp e no email : fisico12@gmail.com \nOmint e Bradesco Saúde \nO mesmo passou a idade do pai de 68 anos para a cotação junto a Bradesco Saúde\n\nRetornar ao mesmo com argumentos de fechamento!', '2023-08-10 15:58:33');
