INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ANTONIO FERREIRA APOLONIA', '59124350834', NULL, '11991146960', NULL, 'Me retornou informou que a mulher quem cuida, que ele ta com opção de fazer plano direto com a oab, vou falar que oab nao comercializa e questionar se nao é um corretor.  Falar com ligia numero 11 991365880', '2022-07-06 18:10:00');
