INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUIZ JUNIOR NOYAMA', NULL, '1199889-9042', NULL, NULL, '(11) 9988-99042 O mesmo informa que migrou para sulamérica empresarial e está com 4 participantes. \n\nAo abordar tratar-se de uma nova proposta o mesmo desligou telefone em face. \nTentei retornar o contato e ele desligou novamente \n\nTentar contato futuro!', '2023-03-17 11:37:35');
