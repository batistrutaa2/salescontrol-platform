INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'EDUARDO PEREIRA L FILHO', NULL, NULL, '(11)99689-4149', '(11)4617-3935', '01/08 - em contato no fixo, informou que a esposa vai precisar fazer mais um monte de exame e que nao \nvão poder mexer agora, perguntei se pudesse retornar em Nov ele disse que sim!', '2022-11-01 10:30:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'EDUARDO PEREIRA L FILHO', NULL, NULL, '(11)99689-4149', '(11)4617-3935', 'em contato com ele, disse que pretende mudar somente no meio do ano, pedi pra deixar eu cotar agr, ele falo ok, \nfiquei de enviar amil e bradesco \nele ta com 72/64/ filho 30 só pra compor massa no bradesco', '2023-01-12 13:25:42');
