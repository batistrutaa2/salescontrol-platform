INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'IVA MARIA COSTA DEBELIAN', '45021872915', '11991216794', '11991216775', '11989832650', 'TELEFONE 1 - MARCIO DEBELIAN (MARIDO) - 010.539.138-77\nAFAVEL.\nNO COMEÇO JA DEIXOU CLARO QUE É ELE QUE MANDA, ENTÃO NO DECORRER DA PESQUISA ELE JA FALOU QUE\nNÃO TEM CONDIÇÕES DE MANTER ESSE PLANO, QUE O CUSTO ESTA MUITO ALTO, ELE MORA AO LADO DO\nSAMARITANO E GOSTARIA DE CONTINUAR USANDO, POIS HOJE, ATÉ PRA FAZER EXAMES, ELE ESTÁ COM\nDIFICULDADES. ELE COMENTOU QUE A LINHA NOVA ESPECIAL 100 DA SULA, NÃO TERIA MAIS SAMARITANO\nMAS TERIA OSWALDO CRUZ, E SE FOSSE O CASO, ELE PODERIA COMEÇAR A UTILIZAR LA.\nAGUARDANDO UMA LIGAÇÃO COM UMA POSSIVEL MELHORA NO PLANO DELE.\n\nCLIENTE POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI MEI - ASSERTIVA (TODOS OS DADOS REFERENTE A ELE)', '2023-04-03 12:33:52');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'IVA MARIA COSTA DEBELIAN', '45021872915', '11991216794', '11991216775', '11989832650', 'm.db@uol.com.br - Esposo Marcio, solicitou cotação por e-mail\r\nEnviar Amil', '2023-06-14 17:44:25');
