INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'BASILIO ROSA CARVAS', '06347784807', '1137444649', '11997163182', '11999328708', 'tentativas de contato com Basílio e Priscilla, sua filha, sem sucesso', '2024-05-10 11:27:25');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'DANIEL GONCALVES LOPES RIBEIRO', '17423086860', '1130312277', '11999668089', '11980898888', '999668089 TELEFONE NÃO PERTENCE A PESSOA  980898888 - Em contato com daniel o mesmo informou esta \ndesempregado e não tem condições atualmente, tambem informou não ter plano de saude e que não tem \ninteresse', '2023-06-05 11:56:01');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'EDILEINE K L ANDRILLI', '11427451800', '(11) 4418-3138', '(11) 9422-31968', '(11) 9598-54223', '942231968 - Em conversa com Edilene a mesma infomou não ter interesse em uma proposta pois estava ocupada \ne ja adiantou que tem um plano com descontos de funcionario publico e que dificilmente as propostas chegam no \nvalor que ela paga', '2023-06-05 11:57:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'EDILEINE K L ANDRILLI', '11427451800', '(11) 4418-3138', '(11) 9422-31968', '(11) 9598-54223', 'EDILENE INFORMOU QUE SEU PLANO É ATRAVES DA EMPRESSA QUE TRABALHA MAS QUE PAGA CERCA DE 3.000 REIS PARA DUAS PESSOAS DE 55 E 27 ANOS, ENVIAR NO WPP', '2023-07-26 16:44:20');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'EDILEINE K L ANDRILLI', '11427451800', '(11) 4418-3138', '(11) 9422-31968', '(11) 9598-54223', 'Tentativa de contato sem sucesso\nRetornar para conversar sobre Unimed adesão', '2023-09-12 11:25:58');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'EDILEINE K L ANDRILLI', '11427451800', '(11) 4418-3138', '(11) 9422-31968', '(11) 9598-54223', 'Edileine retornou mensagem demonstrando interesse, nova proposta UNIMED enviada no WPP.\nacompanhar...', '2023-10-03 10:59:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'EDILEINE K L ANDRILLI', '11427451800', '(11) 4418-3138', '(11) 9422-31968', '(11) 9598-54223', 'Em conversa com Edileine a mesma não teve interesse na Unimed pois não da atendimento em Atibaia e não \nvisualizou São luís de Osasco, mesmo eu informando que teria atendimento e as vantagens a mesma decidiu não \ntrocar neste momento', '2023-10-05 14:58:05');
