INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'SONIA COCHRANE RAO', '02956601806', '11999345086', '11968426021', NULL, 'SONIA COCHRANE RAO - Em contato com a cliente, a mesma se interessou em receber proposta da SulAmerica PME incluindo suas socias \nidades 35/40/60\nEnviar no Whatssap', '2024-01-18 16:40:15');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MELEC RIOS DIAZ', '2155828586', '11941727766', NULL, NULL, '(11) 9417-27766 Em contato com Luciana, a mesma gosta dos valores, cliente antiga\nTratando de um problema no ombro, passando nos médicos : \n\nRenato Labe Carvalho ( Ortopedista ) Clinica Ortopedia Paulista\nFernando H. Pakesian ( Ortopedista ) Santa Anna Ortopedia \nDr. Leonardo Maranhão ( Psiquiatra ) Clinica Médica Assis \n\nEm contato nas clinicas, todas atendem ao produto ofertado Amil One S1500 R1 \nA mesma se queixa quanto ao CNPJ , seu esposo tem participação com muitos socios. \n\nretornar para falar sobre a abertura e tentar marcar reunião com fechamento!', '2023-01-30 17:02:27');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MELEC RIOS DIAZ', '2155828586', '11941727766', NULL, NULL, '(11) 9417-27766  Em contato com cliente via whatsapp', '2023-03-22 16:29:56');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MELEC RIOS DIAZ', '2155828586', '11941727766', NULL, NULL, 'Em retorno da cliente pele whatsapp, agradece pela consultoria e informa que reduziu a categoria\ndentro da própria sulamérica para plano coparticipativo\nA mesma informa no momento não ira abrir empresa para seguro saúde.', '2023-06-07 15:19:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'POLIANNA MARA RODRIGUES DE SOUZA', '26938797870', '1134733225', '11998162126', '11972410777', 'CLIENTE TRABALHA NO EINTEIN E GOSTARIA DE ALGUMA OPÇÃO NO QUAL ELA PODERIA UTILIZAR LA. POUCO USA O PLANO ATUAL, ENTÃO NÃO POSSUI NENHUMA QUEIXA PARA FAZER. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-02-01 14:06:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'POLIANNA MARA RODRIGUES DE SOUZA', '26938797870', '1134733225', '11998162126', '11972410777', 'Cliente que ja era minha, venho tratando sobre Porto Diamante e ja estava cadastrada nesse painel\ncliente que ja retrabalho', '2023-02-13 10:18:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'POLIANNA MARA RODRIGUES DE SOUZA', '26938797870', '1134733225', '11998162126', '11972410777', 'Realizada reunião presencial com a cliente. \n\nAguardando a documentação para inicio da troca, cliente ja escolheu o produto que irá contratar \ne a mesma ficou de enviar a documentação, estou acompanhando pelo whatsapp!', '2023-03-17 11:06:33');
