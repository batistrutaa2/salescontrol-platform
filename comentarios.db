INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'GYSELLA LENARDUSSI FERREIRA', '14303401854', '11982162540', '11982162540', NULL, '(11) 9821-62540 Em novo contato com cliente, a mesma informa que está no especial 100 individual \nPagando atualmente R$ 3.000,00 para ela e seu filho \nBradesco Saúde e Porto Seguro reduziram para R$ 2.000,00 em média, a mesma incluiu seus irmãos na\ncotação para bater as idades, sanou algumas dúvidas inclusive sobre portabilidade para inclusão dos pais. \nPassado os valores para os dois na Bradesco saúde e falado sobre a inclusão no contrato social da empresa!', '2024-01-08 15:15:41');
