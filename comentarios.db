INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SERGIO ANTONIO MALAMAN', '02364611849', '11982347044', '11983940632', NULL, '(11) 9839-40632 Em retorno com esposa Marilene, cliente informa que no momento\nestá com outras questões mais importantes a serem resolvidas, e que iria adiar a transição \ndo plano de saúde. \nCliente agradeceu muito pela consultoria e informou que quando decidir trocar, será comigo. \nRetornarei futuramente!', '2023-07-19 15:51:41');
