INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'IRIS HENRIQUE MEINBERG', '27626997891', '8130978578', '11999512689', '11973390650', 'SENHOR IRIS PEDIU PARA RETORNAR NO NUMERO 99934-4244, TELEFONE DO LEAD É DA MULHER DELE.\nELE USA SAMARITANO / HCOR / OSWALDO.\nESTA INSATISFEITO COM O VALOR PAGO, REAJUSTE MUITO EXPRESSIVO.\nLIGARAM PARA ELE OFERECENDO OUTRO PLANO E ELE NAO QUIS. MAS CONVERSANDO COM ELE E FALANDO QUE É UMA PESQUISA,\nELE ABRIU AS PERNAS E FALOU QUE ESTÁ DISPOSTO A ABAIXAR O VALOR SEM CARENCIA.', '2022-10-06 16:45:54');
