INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BENJAMIM WOLF HANDFAS', '94430241872', '11991039448', NULL, NULL, '(11) 9910-39448 - EM CONTATO COM ELE, ACEITOU RECEBER COTAÇÃO DA PORTO! ESTA NA ALICE SAUDE \nIDADES 66/58/27/24 NAO QUIS FALAR VALOR. Cotei e enviei no wpp', '2023-05-12 15:32:04');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BENJAMIM WOLF HANDFAS', '94430241872', '11991039448', NULL, NULL, '(11) 9910-39448 -  em contato com ele, entendi melhor, ele ta na Alice e tem Sírio e Einstein, paga 12 mil! \n\nEle não tem empresa, disse que tem uma mais que tem mtos socios e que de jeito nenhum eles permitem \nfazer plano de saúde por essa empresa! falei pra ele sobre abertura, ficou relutante, consegui contornar e convencer ele de falar com a PATRICIA, ele disse que o plano dele ainda tem uns 6 meses para ele poder sair, ainda não tem o perido de 2 anos que eles exigem, com isso sinalizei pra sem compromisso ele já entender como funciona essa questao de abrir empresa afim somente da assistência médica. Ao que senti não é algo pra agora porem consegui gerar um alerta que ele tem outra opção além de ficar pagando 12 mil reais pra alice. \n\nCotação Ouro e Diamante enviada, e vou pedir pra patrícia falar com ele no fim da tarde!', '2023-05-22 11:22:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BENJAMIM WOLF HANDFAS', '94430241872', '11991039448', NULL, NULL, 'paricia ainda nao falou com ele disse que tava corrido devido impsoto de renda', '2023-05-30 12:55:09');
