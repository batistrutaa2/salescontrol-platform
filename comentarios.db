INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'LEONARDO SERAFIM DOS ANJOS', '24687607861', NULL, NULL, NULL, 'Em conversa com a mãe, ela disse que Leonardo esta aguardando uma proposta de emprego que tem plano, mas \nque Leonardo visualizou e assim que tiver uma resposta ela retornar', '2024-02-22 15:44:41');
