INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CYNTHIA PERES VICTORIO FERREIRA', '05439697705', '21988052164', '21988052164', NULL, '(21) 9880-52164 Em contato com Cynthia, cliente se interessa pelo projeto\nPorto Seguro Saúde, se queixa quanto aos hospitais de Niterói e compra de \ncarências para participantes acima da idade! \nRetornar com argumentos de fechamento , cotado Ouro Mais e Max, valores\nficaram bem mais atrativos do que os pagos atualmente pela mesma. \nCotação enviada via whatsapp', '2022-12-14 15:04:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CYNTHIA PERES VICTORIO FERREIRA', '05439697705', '21988052164', '21988052164', NULL, '(21) 9880-52164 - Em contato com Cynthia, cliente solicita retorno 13h para\r\ntratarmos sobre a cotação Porto Seguro!', '2022-12-20 13:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CYNTHIA PERES VICTORIO FERREIRA', '05439697705', '21988052164', '21988052164', NULL, '(21) 9880-52164 Em retorno com Cynthia, cliente pela segunda vez \ndesliga em face\nSem interesse no momento!', '2023-01-10 10:35:06');
