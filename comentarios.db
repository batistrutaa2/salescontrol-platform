INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ADRIANO CARVALHO', NULL, '11975253207', NULL, NULL, '(11) 9752-53207 - não atendeu, vou ligar como Bradesco mesmo, falar o valor e tentar entender o pq por empresa \nele não quer!', '2023-03-14 16:31:48');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ADRIANO CARVALHO', NULL, '11975253207', NULL, NULL, '(11) 9752-53207 - em contato com ele, abordei como Bradesco, pesquisa que tinha feito, queria entender o \nreceio dele quanto a empresa. O que acontece. Imposto de renda, expliquei e tal, que ele sendo sócio podia \ncontratar pra família e tal, ele informou que tinha mais uma questão quanto a empresa, ele não é sócio, \nele é só representante da empresa no brasil, e ele também não paga esse qualicorp, é essa empresa quem paga \nentão nao faz sentido abrir empresa por mais que eu tenha explicado como funcionava, enfim. Pra agr. Não faz\nsentido \na empresa nao pode usar e ele nao tem custo com o plano, nem tem pq usar. \nmandei um wpp pra me colocar a disposição caso ele precise algum dia', '2023-03-22 11:07:48');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FATIMA YAMASHIRO', NULL, '11982474929', NULL, NULL, '(11) 9824-74929 Em contato com cliente, a mesma aceita receber cotação da Porto Seguro \nInforma que utiliza metropolitano da lapa e solomoes zhoppi , o primeiro hospital não atende\nna rede Prata Mais porém ela ganha muitos outros hospitais melhores. \n\nReembolso mais alto de R$ 95,00 e também a mensalidade mais acessível, retornar a cliente com \nargumentos de fechamento .\n\nA mesma informa não possuir empresa, prestar consultoria para abertura de uma!', '2023-03-14 17:37:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FATIMA YAMASHIRO', NULL, '11982474929', NULL, NULL, 'Em retorno com Silvania, cliente informa que ja sofreu o reajuste desse ano e por hora \nnão vai trocar de plano, pra ela ainda não está um valor que compense a abertura de uma\nempresa somente para redução do custo. \n\nPediu retorno no começo do proximo ano para comparar com o proximo reajuste se irá compensar\ne também sofrerá o reajuste de faixa-etária!', '2023-03-28 16:13:47');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FATIMA YAMASHIRO', NULL, '11982474929', NULL, NULL, '(11) 9824-74929 Enviada mensagem no whatsapp da fatima para trazermos cotação!', '2024-08-02 10:55:08');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FATIMA YAMASHIRO', NULL, '11982474929', NULL, NULL, '(11) 9824-74929 Cliente retorna pela internet informando ter trocado o seu plano recentemente!', '2024-08-02 11:06:37');
