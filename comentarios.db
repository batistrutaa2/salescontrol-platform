INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'CARMEM KAWAHIRA CHINEN', '05103576872', '(11) 5044-8107', '(11) 9433-41950', NULL, 'EM NOVA TENTATIVA DE CTT CONSEGUI FALAR COM A CARMEM E ENTENDER MELHOR O CENÁRIO ATUAL DELA, SENDO ASSIM UMA DAS VIDAS QUE ESTAVAM NO PLANO NÃO ESTA MAIS, A QUEIXA DELA DO PLANO ATUAL É SOMENTE O AUMENTO DO CUSTO MESMO, ENTÃO ENVIEI UM ESTUDO COM A AMIL SOMENTE COM AS DUAS VIDAS PARA CHAMAR ATENÇÃO E NO RETORNO FALAREI MELHOR SOBRE PORTABILIDADE E A INCLUSÃO NOVAMENTE DA OUTRA FILHA QUE SAIU', '2023-11-06 11:08:39');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'CARMEM KAWAHIRA CHINEN', '05103576872', '(11) 5044-8107', '(11) 9433-41950', NULL, 'EM NOVO CTT COM A MESMA ELA DISSE QUE AINDA VAI VERIFICAR SOBRE MUDANÇA DE PLANO QUE NÃO DECIDIU NADA AINDA, DISSE PRA EU NEM ENCAMINHAR O ESTUDO MAS VOU DEIXAR SÓ UMA MENSAGEM PRA FICAR NO RADAR DELA', '2024-01-31 15:26:01');
