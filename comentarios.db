INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'DANIEL ALVES FERREIRA', '20586245804', '1130813614', '11999749155', '11996535952', 'Em contato com ele ontem, consegui falar quanto amil one, se demosntrou interessado, sanou duvidas\npediu valor do One 6500 foi legal a conversar, vou deixar ele analisar ate o final desta semana e entro em contato \npara tentarmarcar visita.', '2022-07-06 11:58:40');
