INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CLEBER PINTO CAMACHO', '04557367747', '1133756569', '11986761832', '11982033277', '(11) 9820-33277 - alegou nao ter interesse agr, mais vou continuar tentando ao que senti ele tava irritado agr', '2023-06-06 10:03:24');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CRISTIANE L DINIZ', '30894893840', NULL, '11995109299', NULL, '(11) 99510-9299 - cliente informou que o custo ta mto elevado mesmo, porem que o que deixa ela irritada\né a forma que qnd muda, logo a frente ja reajustasse. então ela disse que primeiro essa outra equipe \nmanda pelo whats, ela quer qnd será o prox reajuste e tb falar primeiro no whats. \n\nem busca no assertia \n\nnao encontrei mais numeros disponiveis \n\n00.394.460/0024-38 - ok sp', '2022-11-22 17:59:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CRISTIANE L DINIZ', '30894893840', NULL, '11995109299', NULL, 'mandei wpp : \n\nOlá Sra. Cristiane. Boa tarde! \n\nMe chamo Jaqueline Rodrigues, sou representante comercial da Bradesco Saúde e estou contatando por intermédio de uma pesquisa de satisfação que foi realizada com a Sra. a respeito do seu plano de saúde com a Sul América. \n\nOs principais pontos que me foram passados referente sua insatisfação foram preço e os reajustes que ocorrem muito rápido após qualquer alteração.\n\nTendo em vista essas queixas, levantei duas opções pra Sra. com a Bradesco e gostaria de te apresentar...Quando podemos falar? \n\nAguardo seu retorno.', '2023-01-16 15:53:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CRISTIANE L DINIZ', '30894893840', NULL, '11995109299', NULL, 'em contato com ela, conseguimos conversar um pouco, abordei como bradesco \na maior duvida dela era quanto a imposto de renda, a dedução etc. expliquei e tal tudo ok, tem cnpj \natualizou as idades sendo 50/43/07 e mandei tnqq tqn2 e tqn3. fiquei de ret semana que vem', '2023-02-08 16:28:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CRISTIANE L DINIZ', '30894893840', NULL, '11995109299', NULL, 'informou ter feito uma alteração com a sul américa, e que baixou pra 2 mil o plano que nao queria plano \npor empresa, pedi pro leandro consulta e a maldita foi pro empresarial da sul america 01/02 ela siau da quali', '2023-03-23 17:24:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CRISTIANE L DINIZ', '30894893840', NULL, '11995109299', NULL, 'sem interesse', '2023-05-04 13:38:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CRISTIANE L DINIZ', '30894893840', NULL, '11995109299', NULL, 'tentativa de contato, sem sucesso.', '2023-07-21 11:38:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'DEBORA R SILVA', '02290401870', '1158178993', '11992520338', '11999482512', '(11) 9925-20338 - nao atendeu \n(11) 9994-82512 - ndisse que no momento, esta tudo certo com o plano dela e que ela nao quer mexer\n(11) 5817-8993 - nao atendeu \n\nem busca no assertiva \n\nNão encontrei CNPJ ativo \nem pessoas relacionadas encontrei somente irmão e mae. \nabordei como pesquisa qualicorp', '2022-11-29 10:32:08');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'SILVANA VUONO DE CAMARGO REBELO', '28016647820', '1133687005', '11993903537', '11976588676', '(11) 9939-03537 - não era dela, nao quis passar telefone e disse que era só come la, falei o numero abaixo \n(11) 9765-88676 - em contato com ela, disse que de fato o valor ta complicado mesmo, que eles possuem já uma ideia de trocar de plano e para a bradesco, por hora ainda nao possuem CNPJ mais tem um plano de abrir no ano que vem, fiqueio de ja cotar empresarial tb. Perguntei se nao tinha esposo e ela informou que ele tem 50 anos e pra fazer uma cotação incluindo ele, falou da sogra tb que tinha 79. \n(11) 3368-7005 - \n\nem busca no assertiva \n\n(11) 2275-8215 - \n\nnão tem cnpj', '2022-12-13 17:24:13');
