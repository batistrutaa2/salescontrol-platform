INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'NEI BOTTER MONTENEGRO', '10128732857', '1141121455', '11999310857', NULL, 'Em conversa com Nei o mesmo me cortou e pediu que enviasse uma proposta que tenha Einstein em um plano \nhospitalar, hoje ele esta na sulamerica e em sua apolice tem vidas com as seguintes idades 59,57,31,29,22', '2023-06-16 11:18:49');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'NEI BOTTER MONTENEGRO', '10128732857', '1141121455', '11999310857', NULL, 'Foi enviado um estudo para a Secretaria Miriam para que ela compartilhasse com o Dr. Nei. neste estudo surgiu a opção da Omint pois é um produto hospitalar e que irá atender o cliente o cliente.\nRetornar na proxima semana para conversar a respeito do produto.', '2023-06-16 11:24:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'NEI BOTTER MONTENEGRO', '10128732857', '1141121455', '11999310857', NULL, 'Miriam não faz parte do quadro de funcionarios, porém em conversa com michelle a mesma informou que Miram já \nhavia entegado o estudo para Doutor Nei.\nRetornar para Doutor Nei e verificar oque o mesmo achou sobre o plano hospitalar', '2023-06-28 12:06:52');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'NEI BOTTER MONTENEGRO', '10128732857', '1141121455', '11999310857', NULL, 'Em contato com o cliente, o mesmo informou que estão pagando a metade do que oferecemos. ficou difícil.', '2023-06-30 15:07:35');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'NEI BOTTER MONTENEGRO', '10128732857', '1141121455', '11999310857', NULL, 'EM CONVERSA COM O CLIENTE O MESMO INFORMOU QUE ESTA PAGANDO MAIS BARATO. \nENTRAR EM CONTATO FUTURAMENTE', '2023-07-10 12:24:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'em conversa com messias o mesmo me interrompeu enquanto apresentava e ja adiantou que seu plano seria alice,\n com 3 vidas de 23,45 e 70 anos, também informou que a namorada possui CNPJ', '2023-06-16 11:35:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'Cotação enviada para o cliente através do e-mail e Whatsapp. cliente ja visualizou e agradeceu.\nRetornar entre hoje e proxima semana para conversar sobre o produto', '2023-06-16 11:36:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'Tentativa de contato, sem sucesso.', '2023-06-19 17:31:21');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'EM RETORNO COM O CLIENTE O MESMO FOI AFAVÉL, CONVERSAMOS SOBRE OS PRODUTOS, ADIANTEI OS \nVALORES POIS ELE NÃO TINHA VISUALIZADO.\nRETORNAR PARA VERIFICAR QUAL OPÇÃO FOI MAIS ATRATIVA E MARCAR REUNIÃO', '2023-06-28 12:05:07');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'Em contato com o cliente,  o mesmo informou que faz sentido pra ele a opção prata pró.\r\nMarcar reunião semana q vem.', '2023-06-30 14:59:32');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'tentativa de contato, sem sucesso.,', '2023-07-12 17:27:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'Retornar para Messias  para marcar a reunião e apresentar mais sobre o produto Prata Pró', '2023-07-18 14:41:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'Em contato com o cliente, foi agendado reunião para quinta-feira no endereço:\r\nRua Leonardo Mota, 100\r\nAp 92\r\nLigar as 11:00 horas da manhã para alinhar horário.', '2023-07-18 15:14:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'Em conversa com Messias o mesmo informou que sua irmã possui um CNPJ e que chega de viagem hoje, Messias \npediu um estudo incluindo sua irmã (74) e pediu para retornar na parte da noite para conversar junto a ela.', '2023-09-12 14:41:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'Em conversa com Messias, marcamos reunião para terça feira (19/09) pois sua agenda está livre e sua irmã estará \nem São Paulo também.\nMessias só pediu que ligasse na segunda para confirmar.', '2023-09-13 16:39:58');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'Messias não esta mais com marta que seria titular do CNPJ, então ele pediu que aguardasse', '2023-11-24 14:38:34');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MESSIAS LIGUORI PADRAO', '95480480863', '11999525954', NULL, NULL, 'Em conversa com messias o mesmo disse que sua filha precisará de plano também ja que não será efetivada \nentão o ele pediu que enviasse um estudo em seu WPP com opções de Fleury para exames', '2024-02-07 14:05:03');
