INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'NILO CESAR BRAGA S DE LIMA', '87446537434', '8335660181', '83986101521', '83986101520', 'Em contato com ele, ele informou que tinha plano com a sul américa ate out de 2021. Que fez um unimed, disse ele que é adesão, ele precisa fazer uma cirurgia chamada nefrectomia parcial, que tava pensando em fzr uma portabilidade pra poder voltar a sula e operar ou no sirio ou no Oswaldo cruz. Liguei no oswaldo crus, uma moça falou pra mandar a carteirinha no email dela sendo o apoiosac@haoc.com.br. Disse que ia tenta ajduar ele', '2022-05-31 12:22:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'NILO CESAR BRAGA S DE LIMA', '87446537434', '8335660181', '83986101521', '83986101520', 'Cliente ta receoso demudar e ter carência.', '2022-06-08 14:23:55');
