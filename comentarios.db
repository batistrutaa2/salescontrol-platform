INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'KATHYA MASTRANDEA DE O PASCHOAL', '38485319842', '11979827979', '11979827979', NULL, '(11) 9798-27979 Enviada cotação via email referente a amil selecionada\nA mesma se encontra no qsaude pagando valores atualizados em sistema\nse interessa pela proposta pois ganha Pro Matre, São Luiz e entre outros\nReside na zona leste \nRetornar com argumentos de fechamento na proxima semana!', '2022-11-22 11:50:58');
