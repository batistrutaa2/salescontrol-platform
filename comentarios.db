INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA MARIA DE ANDRADE', '81746474815', NULL, NULL, NULL, '(11) 99686-2376 Consegui contato com Ana , a mesma estava na feira, informa ser do interesse dela\ne solicita retorno as 12h para tratarmos! \nRetornar', '2024-04-18 11:20:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA MARIA DE ANDRADE', '81746474815', NULL, NULL, NULL, '(11) 99686-2376 Em retorno com cliente, a mesma aceita receber cotação de plano por adesão \nEnviado o AMPLA SAÚDE, pela SINPEEM, sindicato da cliente. Houve uma redução para R$ 2.700,00\nA mesma sana dúvidas sobre transição e fala em reunião, retornar para cliente para concluir e cobrar valor da\ndiferença!', '2024-04-18 13:30:11');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA MARIA DE ANDRADE', '81746474815', NULL, NULL, NULL, '(11) 99686-2376 Em novo contato, cliente informa que acabou esquecendo de olhar cotações em seu whats\nreforcei com ela os benefícios e valores e agendei retorno para sexta-feira, afim de marcar uma reunião!', '2024-04-23 10:58:51');
