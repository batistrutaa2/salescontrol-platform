INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'HUGO EDUARDO PINHEIRO PRAXEDES', '14221837349', '11968270209', NULL, NULL, '(11) 9682-70209 - em contato com a Lis, esposa dele, me informou que estão na Bradesco Saúde através de CNPJ, plano TOP nacional, não soube informar o valor! Disse que podia enviar para ela, idades 66/58/27/25 , \nperguntou se eu era da porto mesmo, falei que era a respeito e tal do projeto que prestamos serviço, porem \nque o vinculo diretamente com a porto e tal, enfim, fiquei de ret no final da semana para saber o que acharam', '2023-05-16 15:34:16');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'HUGO EDUARDO PINHEIRO PRAXEDES', '14221837349', '11968270209', NULL, NULL, '(11) 9682-70209 -  em contato com ela, informou que o Bradesco esta menor o valor, e que eles não tem custo dos dep então por isso o marido dela quer ficar mais na Bradesco, ret mais ao fim do ano', '2023-05-22 10:56:24');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'HUGO EDUARDO PINHEIRO PRAXEDES', '14221837349', '11968270209', NULL, NULL, NULL, '2023-05-22 11:01:49');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'HUMBERTO SALGADO FILHO', '08352014811', '11981411393', NULL, NULL, '(11) 9814-11393 - em contato com ele, disse que tem sul america para 60/58/27/25 disse estar ja uns dois anos\nfalei que certamente a porto ficaria melhor o custo e ele deixou eu enviar a cotação por wpp. ret ao fim da semana', '2023-05-16 16:47:58');
