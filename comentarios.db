INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'nao atendeu', '2022-08-11 17:44:12');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'Cara, nao atende mais, wpp nao ta respondendo mandei um wpp pra ela meio cheque mate: \n\nEstou conversando com bastante pessoas ai da sua região e estamos conseguindo fazer essa movimentação e ajudar muitas pessoas. \n\nNão quero que minha insistência se transforme em inconveniência. Então me coloco á disposição para tratarmos deste assunto. \n\nO valor da Qualicorp ele esta de fato impraticável e a Sra. esta com uma condição excelente para economizar no valor sem diminuir os atendimentos.\n\nMe permita te explicar como funciona e o quão simples é a movimentação. Nos quem cuidamos de tudo, em momento algum ficam descobertos. Não paga duas mensalidades dentro do mesmo mês.', '2022-08-15 14:14:07');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'em contato com ela, questionei se podíamos remarcar, ela falo novamente que quer resolver, mais de fato esta\r\nmto corrida, que a próxima semana esta impossível de conversar. fiquei de ret dia 29/8 para marcar a reunião \r\nnaquela ultima semana do mês', '2022-08-29 10:30:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'Liguei pra ela agr, ela disse que nao podia falar, falei que ia chamar no wpp e enviei perguntando se nossa \ncall pode ser sexta', '2022-08-29 11:53:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'nao atendeu, mandei wpp', '2022-09-05 11:26:37');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'numero do marido marco 71 999842144 liguei agr só chamou', '2022-09-06 16:30:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'em contato com ela, falei se podíamos marcar nossa cal pra sexta. ela falo que ia ver com a irma dela se ela \r\nconseguia entrar pra captar tudo e passar pra ela. pq ela trabalha mto, e não consegue falar disso. falei deixa\r\neu falar com seu marido, ela falo que com ele é pior ainda que ele tb é medico. msg no whats quinta pra ver \r\nse vai dar a cal na sexta', '2022-09-08 10:30:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'msg de quinta ela nao respondeu. Mandei uma nova hj', '2022-09-12 11:56:49');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'de fato ta foda conciliar ela poder flasr, ja pedi pra falar com marido ela disse que é pior ainda pois ele tb é medico, \nnao tem mto o que fazer, me faço presente para que na hora que ela tiver tempo trate comigo. mandei wpp agr p ela', '2022-09-26 15:51:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'mandei wpp pra ela novamente nao atendeu', '2022-10-06 16:43:39');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'em contato com ela, novamente ain to corrida e etc. disse que vai tentar na sexta, pra marcarmos uma call \npediu pra mandar msg na quinta feira.', '2022-10-10 10:15:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'nao atendeu mandei wpp', '2022-10-28 16:56:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'estamos abrindo um CNPJ para Irene Bruna e Daniela, a minuta esta com elas, porem vai enviar provavelmente só \nem jan, pois a irene quer que o contador dela revise a minuta para ter crtz que não va implicar em nada na aposen\ntadoria dela. faleiq ue desta forma o plano fica pra fev, pois temos que aguardar um mes apos a abertura \nda empresa', '2022-12-20 11:56:40');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'retoamando, liguei pra ela deu caixa, mandei wpp pedindo pra ela me ligar', '2023-01-09 15:51:56');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BRUNA MAGALHAES GOTARDO SALVINO', '94552266500', '7132721957', '71982762629', '71983116262', 'papeis do CNPJ chegaram hoje ao Adilson, informou dar entrada na empresa até amanha!', '2023-02-06 10:08:29');
