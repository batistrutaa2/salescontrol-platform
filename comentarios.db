INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'Jose Urquiza Terra Nogueira', '05375905876', '11985554250', NULL, NULL, 'Em conversa com o cliente através do Whatsapp foi enviado para ele um estudo da Prevent Senior apenas para sua\n vida (60) através do plano por adesão e o mesmo gostou bastante do produto oferecido.\nEm retorno feito por Caique, josé informou realmente ter gostado porém ainda esta analisando a proposta pois \ntambém recebeu outras propostas.\nRetornar entre hoje e proxima semana.', '2023-06-16 11:13:49');
