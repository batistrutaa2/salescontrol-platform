INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIANA GARCIA VILLELA', '30132180880', '1141533961', '11982650066', NULL, 'Disse que como precisa de 3 vidas, ela quer esperar o plano dela aumentar primeiro pra compensar o valor, pq o valor dela e do marido na amil atualmente deu menos que na porto, ela sabe que vai aumentar, mais vai esperar. No meio do mes que vem vou ligar pra ela e ver se ja aumentou, se ela der alguma negativa eu vou falar que podemos fazer Amil tb', '2022-07-10 10:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIANA GARCIA VILLELA', '30132180880', '1141533961', '11982650066', NULL, 'Jaqueline, bom dia! Ainda não tenho essas informações e estou viajando. Se houver interesse, entro em contato. Obrigada!\n\nainda nao reajustou, lgiar mais no meio do mes', '2022-07-16 10:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIANA GARCIA VILLELA', '30132180880', '1141533961', '11982650066', NULL, '19/07 kaique falou com ela hj e ela informou que esta vendo devido a terceira vida porto nao ta sendo opção \nvou ligar sexta e perguntar quanto a isso sondar e dizer que trabalho com outras operadoras etc', '2022-07-22 10:30:00');
