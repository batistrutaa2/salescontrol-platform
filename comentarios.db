INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', '(11) 9858-84874 Em contato com Ana, cliente passa o número do esposo Eduardo abaixo. \n(11) 9813-13400 Em contato com o mesmo, aceita receber cotação por email da Bradesco Saúde\nAbordado todo o tema da transição, o mesmo passa o email enascimento@terra.com.br \nProposta enviada, retornar com argumentos de fechamento \nCliente possui CNPJ.', '2023-10-18 14:33:58');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', '(11) 9813-13400 \ntentativa de retorno com cliente, o telefone do mesmo só chamou!', '2023-10-24 14:59:25');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', '(11) 9813-13400 \ntentativa de retorno com cliente, o telefone do mesmo só chamou!', '2023-10-24 14:59:39');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', '(11) 9813-13400 \ntentativa de retorno com cliente, o telefone do mesmo só chamou!\n\n(11) 9858-84874 Em contato com Ana, cliente passa o número do esposo Eduardo abaixo. \n(11) 9813-13400 Em contato com o mesmo, aceita receber cotação por email da Bradesco Saúde\nAbordado todo o tema da transição, o mesmo passa o email enascimento@terra.com.br \nProposta enviada, retornar com argumentos de fechamento \nCliente possui CNPJ.', '2023-11-07 15:00:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', '(11) 9813-13400 Em retorno com cliente, o mesmo aceita receber a cotação novamente \nInforma que não tinha tido tempo de olhar, ressaltado campanha de redução de 50% na segunda parcela\nretornar sexta-feira ao mesmo para novamente tratarmos o tema.', '2023-11-13 15:18:22');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', '(11) 9813-13400  Tentativa de retorno, só chamou!', '2024-01-08 10:49:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', '(11) 9813-13400   Em novo retorno com cliente, reforcei novamente os benefícios, valores\nO mesmo aceitou receber a proposta da Porto Seguro Ouro Mais e Max, abordei o tema da transição\nFalei sobre o fechamento e também reunião, cliente disse que ia analisar propostas novamente que foram\nenviadas no seu email, no retorno, ir diretamente ao fechamento, para que o mesmo tome a decisão \nEncontra-se na faria lima, tentar usar o local como gatilho para reunião!', '2024-01-17 11:03:32');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', '(11) 9813-13400 Tentativa de contato sem sucesso. \nReforçada novamente proposta por e-mail!', '2024-02-02 10:43:48');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', 'Fiz contato tanto com Eduardo quanto com esposa Ana, o mesmo pediu para reforçar mais uma vez a proposta\npor email, porém não da muito atenção conforme fiz outras vezes. \nJa a dra. Ana, ficou mais interessada, sanou dúvidas e pediu cotação pelo whatsapp, enviada a cotação a cliente\nque disse estar viajando a tailandia e iria resolver a distância. Manter-se no radar da cliente para a transição\nvalores ficaram excelentes!', '2024-06-18 17:06:26');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', '11 98588-4874 Em retorno com Dra Ana, a mesma solicitou retorno na segunda-feira no primeiro horário!', '2024-06-28 15:00:50');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', '11 98588-4874 - Em contato com Dra Ana, cliente informa que estava tratando com sua sócia a questão de \ntransição e se redime por não ter lembrado da minha consultoria. Reforcei todos os benefícios, foquei em tirar\nos concorrentes e pedi a oportunidade de passar a cotação também a sua sócia, a mesma informa que recebeu\namil e bradesco! \nEnviei novas cotações e também reforcei os benefícios, pediu retorno amanhã!', '2024-07-22 18:13:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA CLARA KNEESE V DO NASCIMENT', '15184709800', '11985884874', '11985884874', '11981313400', '11 98588-4874 Em retorno com cliente, depois de muitas tentativas, a mesma informa que sua sócia preferiu\nfechar com outro corretor, que fizeram um plano da amil', '2024-07-30 10:50:29');
