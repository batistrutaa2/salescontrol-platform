INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DANIEL VARONI SCHNEIDER', '30151521816', NULL, '11971000530', '11971005016', '(11) 9710-00530 Tentativa de retorno, só chamou , tentar novamente no final do dia!\n\nEnviado pelo whatsapp e no email : fisico12@gmail.com \nOmint e Bradesco Saúde \nO mesmo passou a idade do pai de 68 anos para a cotação junto a Bradesco Saúde\n\nRetornar ao mesmo com argumentos de fechamento!', '2023-08-28 10:28:35');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DANIEL VARONI SCHNEIDER', '30151521816', NULL, '11971000530', '11971005016', '(11) 9710-00530  Em retorno  com cliente, o mesmo informa que ainda não conversou com seu pai \nsobre proposta. \nreforcei os benefícios tanto da Bradesco, quanto da Omint, retornar contato ao mesmo!', '2023-08-30 15:02:41');
