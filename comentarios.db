INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIANA GARCIA VILLELA', '30132180880', '1141533961', '11982650066', NULL, '98265-0066 - em contato com ela, deixou enviar cotação, informou que morava perto da Unidade do Albert Einstein de Alphaville, gostaria de checar um plano que tivesse este atendimento. Ok. Outro ponto, consegui também informar que era 3 vidas e que e ela passou o esposo, então as idades são 40/04/45. mandei wpp bem completinho e ela ja respondeu agradecendo e que vai falar com o marido e me retorna', '2022-06-02 15:21:53');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIANA GARCIA VILLELA', '30132180880', '1141533961', '11982650066', NULL, '0066 - informou que esta viajando, mais que é sim um assunto que precisa tratar. Pediu que eu aguardasse mais um pouco que ate segunda ela vai entrar em contato comigo', '2022-06-14 10:35:51');
