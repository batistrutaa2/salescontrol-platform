INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MAURO SERGIO GODOY', '75944740825', '(11) 9403-36844', NULL, NULL, 'Gilvany informou que Mauro esta em tratamento oncológico e que neste momento os filhos saíram da apólice a \npassaram a pagar 8 mil para cada.\nA mesma disse que esta com pouquíssimo tempo e pediu que ligasse dentro de 1 mês.\nRetornar dia 18 para marcar a reunião', '2024-07-18 10:51:40');
