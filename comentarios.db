INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'JORGE ALEXANDRE SATO', NULL, '(11)95577-9054', NULL, NULL, 'em contato com ele disse que ta sem plano agora, que não esta tendo condição de pagar, que no plano dele agr esta só o filho. Mandei wpp com opção de sula duas vidas interior', '2022-06-13 13:55:35');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'JORGE ALEXANDRE SATO', NULL, '(11)95577-9054', NULL, NULL, 'em contato com ele, o que acontece. Vamos fazer um Qualicorp interior e já consegui passar pra ele que, ok ta barato ok, porem os aumentos sao salgados e empresarial vale smp mais a pena. Ele informou que vai se coçar de abrir uma Unipessoal então de adv e que por hora vamos aproveitar essa questão de valor de interior, conversa mto produtiva, cliente mto gnt boa acredito que façamos qualicrp agr e pme dps, ele faz 54 anos mes09 e ta ciente do pgto de duas mensalidades. to aguardando docuemntação', '2022-06-23 12:39:50');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'JORGE ALEXANDRE SATO', NULL, '(11)95577-9054', NULL, NULL, 'Informei que hj é o ultimo dia para vigencia este mes.', '2022-07-11 11:21:52');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'JORGE ALEXANDRE SATO', NULL, '(11)95577-9054', NULL, NULL, 'esta vendo de abrir uma PJ mesmo', '2022-07-15 11:41:55');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'JORGE ALEXANDRE SATO', NULL, '(11)95577-9054', NULL, NULL, 'Conversei bastante com ele hj tentando entender, explicar, dizer que numa reuniao resolvemos e esclarecemos \ntudo, ele quer porque quer ver de abrir empresa primeiro e ate agr nao viu. De qlq forma ta pra sair, hj consegui \nexplicar bem pra ele que ele ta ramelando de ficar sem plano e o valor do filho dele na sulla e ele disse que vai fr\nsó precisa se organizar pra pagar mais no plano', '2022-08-03 18:11:52');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'JORGE ALEXANDRE SATO', NULL, '(11)95577-9054', NULL, NULL, 'Olá Dr. Jorge! Boa semana... \n\nPassando para me colocar á disposição para marcarmos um almoço esta semana... \n\nBom dia ??', '2023-01-16 10:35:04');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'JORGE ALEXANDRE SATO', NULL, '(11)95577-9054', NULL, NULL, 'alegou estar abrindo um mei a algumas semanas a atras, mandei msg agr questionando se abriu e se ele ja foi \nnotificado do reajuste', '2023-04-11 11:38:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'JORGE ALEXANDRE SATO', NULL, '(11)95577-9054', NULL, NULL, '(11) 9557-79054 - liguei agr nao atendeu, wpp tb mto enrolado, sinceramente esse cara é perca de tempo \nenrola a meses e meses sempre fala que ta abrindo empresa, eu aconselho aconselho e aconselho a \nabirmos, que ele paga um vlaor somente para o filho que poderiam pagar os dois juntos..;... mais ele de fato \nnão se mexe pra resolver e eu nao tenho nem mais o que falar, já mostrei a vantagem umas 82 vezes ele de \nFato é acomodado e nunca resolve', '2023-05-29 11:32:11');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES (NULL, 'THYRSON LOUREIRO DE ALMEIDA JUNIOR', NULL, '(11)99909-7276', NULL, NULL, 'em contato com ele, informou que é corretor de seguros tb , que nao tinha CNPJ, falei um pouco da abetrtura ele disse que ia se informar e me pediu ret em 15 dias', '2022-07-01 10:00:00');
