INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'DALTON GIOIA', '08244726830', NULL, '11991093701', '11963005863', 'EM CONTATO COM O MESMO ACABEI FALANDO COM A ESPOSA QUE POR VENTURA ESTAVA TENTANDO AJUDA-LO A ENCONTRAR UMA SAIDA COM ESSE REAJUSTE DA MUTUA DE 35%, COTAÇÃO ENVIADA', '2023-07-06 14:27:20');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'DALTON GIOIA', '08244726830', NULL, '11991093701', '11963005863', 'TENTATIVA DE RETORNO COM O CLIENTE SEM SUCESSO \n\nESTAVA EM CTT COM A ESPOSA DELE POR WHATS TIREI DIVERSAS DUVIDAS DELA REF AO PRODUTO E A FORMA DE CONTRATAÇÃO VIA CNPJ, A MESMA DEIXOU BEM CLARO DIVERSAS VEZES QUE ELES NÃO VÃO ABRIR CNPJ DE FORMA ALGUMA E JÁ LOGO ENCERROU O CTT CMG, PARA TENTAR CONTORNAR A SITUAÇÃO CONVERSEI SOBRE ADESÃO COM ELA E A MESMA NUNCA MAIS RESPONDEU OU ATENDEU MINHAS LIGAÇÕES', '2023-09-27 11:36:34');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'DALTON GIOIA', '08244726830', NULL, '11991093701', '11963005863', 'ESTIVE EM CTT NOVAMENTE COM A ESPOSA QUE É QUEM ESTA CUIDANDO DO CASO E A MESMA DISSE QUE NÃO QUER NADA QUE ENVOLVA CNPJ E QUE ELES NÃO TEM INTERESSE NO MATERIAL QUE ENVIEI O MESMO INCLUSIVE ESTA PAGANGO POUCO NA SULA NO ADESÃO', '2023-11-07 15:59:31');
