INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'VERA SILVIA DE OLIVEIRA DIAS', '08582542801', '1125781927', '11995628499', NULL, 'CLIENTE ACEITOU RECEBER UM NOVO ESTUDO, DISSE QUE UMA DAS VIDAS DA APÓLICE DELA SAIU E ELA ESTA SOZINHA, SENDO ASSIM ENVIEI UM ESTUDO ADESÃO COM A SEGUROS UNIMED SOMENTE PRA VIDA DELA, E UM AMIL PME COM AS DUAS VIDAS CASO ELA TENHA INTERESSE EM COLOCAR NOVAMENTE A OUTRA VIDA', '2023-12-05 14:46:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'VERA SILVIA DE OLIVEIRA DIAS', '08582542801', '1125781927', '11995628499', NULL, 'CLIENTE DISSE QUE PELA CORRERIA AINDA NÃO CONSEGUIU ABRIR O ESTUDO MAS APRESENTEI BREVEMENTE OQUE ESTAVA SENDO OFERECIDO, TANTO CUSTO QUANTO BENEFICIO, E RETORNAREI NA PROXIMA SEMANA', '2023-12-12 10:54:53');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'VERA SILVIA DE OLIVEIRA DIAS', '08582542801', '1125781927', '11995628499', NULL, 'A MESMA ESTA CORRIDA E NÃO CONSEGUIU VISUALIZAR AINDA A PROPOSTA, APRESENTEI POR TEL E OFERECI UMA REUNIÃO OU CALL PARA MELHOR APRESENTAR O PRODUTO, ELA DISSE QUE VAI PRIMEIRO AVALIAR O MATERIAL E NA SEMANA DEPOIS DO CARNAVAL PRA EU ENTRAR EM CTT E AI SIM MARCARMOS ALGO', '2024-02-06 10:41:44');
