INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEANDRO ALVES FREITAS DOS SANTOS', 'SILVANA F MEDICI', '05095597861', '11971746401', NULL, NULL, '(11) 9717-46401 Em contato com Silvana, cliente aceita receber proposta da Bradesco Saúde A mesma\ninforma que seu esposo possui doença pré-existente na parte cardíaca Feita a cotação no TQN3, valores\nficaram bem atrativos, a mesma paga atualmente: R$ 14.820,34 Enviada via whatsapp a mesma com os\n3 participantes e com os 4 para que posteriormente o esposo venha na apólice via inclusão.\nRetornar a mesma com argumentos de fechamento, possui empresa aberta !', '2024-03-22 16:29:56');
