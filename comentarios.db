INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CYNTHIA PERES VICTORIO FERREIRA', '05439697705', '21988052164', '21988052164', NULL, '(21) 9880-52164 Em contato com Cynthia, cliente se interessa e aceita receber cotação da Porto Seguro\nOuro Mais \nInforma que ainda está no Bradesco Nacional pagando :  R$ 9.667,55\nSolicita os hospitais de Niterói : \nCHN \nNiteroi Dor\nHospital Icaraí\nEnviada cotação via whatsapp e sanada dúvidas, custo ficou bem acessível, retornar com argumentos\nfechamento!', '2024-01-09 10:32:20');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CYNTHIA PERES VICTORIO FERREIRA', '05439697705', '21988052164', '21988052164', NULL, '(21) 9880-52164 Em contato com Cynthia, cliente se interessa e aceita receber cotação da Porto Seguro\nOuro Mais \nInforma que ainda está no Bradesco Nacional pagando :  R$ 9.667,55\nSolicita os hospitais de Niterói : \nCHN \nNiteroi Dor\nHospital Icaraí\nEnviada cotação via whatsapp e sanada dúvidas, custo ficou bem acessível, retornar com argumentos\nfechamento!', '2024-01-09 10:32:57');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CYNTHIA PERES VICTORIO FERREIRA', '05439697705', '21988052164', '21988052164', NULL, '(21) 9880-52164 Mantendo contato via whatsapp, cliente não responde mais mensagens\nA mesma se interessou e depois esfriou negociação\nSolicitar ao Kaique fazer a segunda voz!', '2024-04-11 14:43:47');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CYNTHIA PERES VICTORIO FERREIRA', '05439697705', '21988052164', '21988052164', NULL, '(21) 9880-52164 Em novo contato com a Cynthia, cliente informa que passou as pessoas responsáveis, porém\nficaram com receio pelas idades mais altas na transição e preferiram não trocar agora\nDeixei todas as informações possíveis para reverter e enviei novamente a proposta em seu whats\n\nManter-se no radar', '2024-05-08 11:35:16');
