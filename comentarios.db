INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GABRIELA ALMEIDA HUET BACELLAR', '27841339828', '1155052349', '11956962349', '11997094366', '(11) 99709-4366 - em contato com ela, disse que tem usado bastante o plano, que fez uma cirurgia recentemente e que recebe inúmeras propostas para mudar de plano, porem ela é amarrada devido a pré existente mais gostaria sim de sair, falei que ia pedir que fosse enviado pra ela opções por portabilidade para que não tenha carências, ela informou que o esposo tem CNPJ, então vou ligar na qualicorp e pedir opções \npor portabilidade \n(11) 95696-2349 - \n(11) 5505-2349 - \n(11) 3537-4743 - \n\nem busca no assertiva \n\nnao encontrei cnpj ativo', '2022-11-29 14:44:07');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GABRIELA ALMEIDA HUET BACELLAR', '27841339828', '1155052349', '11956962349', '11997094366', 'liguei na qualicorp duas vezes e os dois atendentes derrubaram a droga da ligação', '2022-12-02 12:38:24');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GABRIELA ALMEIDA HUET BACELLAR', '27841339828', '1155052349', '11956962349', '11997094366', 'em contato com ela, no final 4366 - trouxe opções com portabilidade, abordei como amil, e dei ideia de trazer\n o filho e o esposo via portabilidade, porem ela precisa concluir na sul america, pq outra operadora vai entender como cirurgia estética, então como faltam duas, ela prefere terminar com a sul américa, falei ok, dei opção\n também de vim somente o esposo e filho e ela dps, ela ficou mais adepta a esta opção, mandei wpp e retorno \nna proxima semana', '2023-01-18 14:29:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GABRIELA ALMEIDA HUET BACELLAR', '27841339828', '1155052349', '11956962349', '11997094366', 'nao atendeu, mandei wpp', '2023-01-31 13:57:23');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GABRIELA ALMEIDA HUET BACELLAR', '27841339828', '1155052349', '11956962349', '11997094366', '(11) 99709-4366 -  nao atendeu', '2023-03-24 15:06:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GABRIELA ALMEIDA HUET BACELLAR', '27841339828', '1155052349', '11956962349', '11997094366', '(11) 99709-4366 -  contato mto bacana, conversamos bastante, sugeri de fazer amil esposo e filha\nele tem empresa, e os 3 juntos estao apgando 7 mil, ela é amarrada devido a um procedimento estetico \nque ela pode fazer na sul america e nao vai sair antes de resolver,falei de portabilidade, mais o dela, ela\nnao vai mexer msm agr, pediu que mandasse um auduo rno wpp resumindo tudo que falamos pois ele acredita \nque se fizer pela empresa os outros socios precisam entarr tb. expliquei e ir acompanhando tentar marcar \nreuniaão.', '2023-05-04 14:45:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GABRIELA ALMEIDA HUET BACELLAR', '27841339828', '1155052349', '11956962349', '11997094366', 'nao atendeu', '2023-06-02 17:42:18');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GABRIELA ALMEIDA HUET BACELLAR', '27841339828', '1155052349', '11956962349', '11997094366', 'em contato com ela, o que acontece, o esposo ta fazendo alguns exames e precisará fazer uma cirurgia \neletiva, pediu pra esperarmos pq se for ela vai querer fazer no plano atual mesmo. Disse tb que ja tem mta gnt \nligando pra ela que ta chato até isso, falei que conosco marcamos reunião e matamos a nota fia de deus vem que vem \nret dia 20/06 pra saber se o abençoado vai ter que operar msm, falou algo do cunhado dela que tem um bradesco pra 10 vidas e paga 5 mil kkk msm preço que ela falei pois é amada seu valor ta osso', '2023-06-05 16:57:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GABRIELA ALMEIDA HUET BACELLAR', '27841339828', '1155052349', '11956962349', '11997094366', NULL, '2023-06-05 16:57:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'GABRIELA ALMEIDA HUET BACELLAR', '27841339828', '1155052349', '11956962349', '11997094366', 'Em contato com a cliente, a mesma falou que seu plano subio para mais de 9 mil reais. Vai fazer a mudança porém tem pré existente. Falei sobre a portabilidade usando na implantação apenas marido e filha e ela por inclusão\r\nmandei pelo whats e retornar para reunião.', '2023-07-24 14:55:42');
