INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'RITA DE CASSIA SCRAMIN', '08556672817', NULL, NULL, NULL, '96849-4433 - Ana (secretaria de Rosana) informou que ela e Dr. Gustavo estão em viagem e só retornam após o\n dia 15, mas adiantou que ja fizeram algumas reuniões e que já receberam um reajuste e o plano passou dos 20k \npara os dois. \nQuem decide tudo é o Dr., fiquei de enviar o material no email da clinica e conversar no WPP para tentar marcar \nreunião', '2024-07-01 15:17:45');
