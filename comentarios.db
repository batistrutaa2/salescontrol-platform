INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOAQUIM JHONNY VARGAS VILLARROE', '06906673882', '1126776898', '11971059475', '11999772151', 'Em retorno com Dr. Joaquim , cliente informa que mesmo \ncom as reduções de custo, quer permanecer no seu plano \natual, questionado motivo, o mesmo informa não ter um \nmotivo específico, somente não quer trocar seu plano. \nRetornar futuramente', '2022-07-29 11:12:39');
