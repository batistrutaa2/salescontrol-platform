INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'MARCIO LUIZ BECCARINI', '27304377895', '1129250507', '11970831542', '11981398884', 'TELEFONE 3 - ALESSANDRA MULHER DELE.\nAFAVEL E EDUCADA.\nCLIENTE ESTA INSATISFEITA COM O VALOR DE REEMBOLSO QUE POSSUI HOJE. E OS MEDICOS QUE ELA PASSAVA\nHOJE NÃO ESTÃO ATENDENDO MAIS.\nVALOR ALTO DO PLANO. ESTÁ JA VENDO OUTRAS POSSIBILIDADES DE PLANOS JUNTO DO MARIDO E FILHO.\nQUANDO PRECISA UTILIZAR, USA O OSWALDO CRUZ E NOVE DE JULHO, PRA CRIANÇA SABARA.\nCLIENTE COM POSSIVEL TROCA DE PLANO SE DEMORAR PARA UM RETORNO.\n\nCLIENTE POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-04-05 11:41:20');
