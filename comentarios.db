INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'EDUARDO PEREIRA L FILHO', NULL, NULL, '(11)99689-4149', '(11)4617-3935', 'em contato com ele, questionei se havia recebido meu email e tal da amil e da Bradesco, falou que sim \nporem que a esposa esta acompanhando algumas coisas do joelho, sugeri de fazer portabilidade, usar o filho \npra fazer ele e Eduardo e incluir a mulher via portabilidade, falei de marcarmos reunião para que o filho entendesse tb a alternativa. que evitássemos o aumento de julho e tal e ainda trocamos com segurança, vendi o peixe, possa ser que ele nao queira agr agr porque ta acomodado, mais quando o reajuste vir certamente ele vai querer. mandei email salientando opção de portabilidade e aguardar um pouco.', '2023-04-24 11:52:47');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'EDUARDO PEREIRA L FILHO', NULL, NULL, '(11)99689-4149', '(11)4617-3935', 'em contato com ele, disse que a esposa vai ter que operar mesmo e que não vai poder trocar agr, que além \ndo joelho, ele vai operar o ombro rpa tirar uma placa que tem. E que nao ia poder mexer agr, vai matar isso \nprimeiro, dps troca. Ret em torno de 1 mes pra irmos se falando e ver como ta', '2023-06-14 10:56:40');
