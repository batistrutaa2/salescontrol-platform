INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA PAULA DE CAMPOS KAROAUK', '14777370810', '1155460124', '11999318724', '11981930131', 'KAIQUE EM CONTATO COM O CLIENTE, APRESENTOU VALORES DE PORTO SEGURO E BRADESCO ATRAVES DE UM PLANO EMPRESARIAL.\nINFORMOU A CLIENTE QUE PARA UTILIZAR OS VALORES SERIAM NECESSARIO DETALHES A SEREM PONTUADOS.\nCLIENTE SE INTERESSOU PELOS VALORES, SOLICITOU COTAÇÕES VIA E-MAIL E HORARIO E DATA DO AGENDAMENTO DE UMA REUNIAO VIRTUAL PARA CONCLUIRMOS A NEGOCIAÇÃO.', '2022-10-10 10:52:49');
