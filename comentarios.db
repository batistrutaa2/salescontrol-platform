INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIA LUIZA BLANQUES PETTY DA SILVA', NULL, NULL, '(11)98339-7468', '(11)4505-2276', '(11) 9833-97468 - esta gravida não pode mudar agr, pedi pra deixar eu enviar no whats ela falou que ok\n podia enviar \n(11) 4505-2276 - não era ela e o marido informou não ter interesse de mudar agr \n\nNão tem benf com a Porto abordei como Bradesco \n\n44.813.358/0001-09 - ok sp', '2022-07-12 16:10:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIA LUIZA BLANQUES PETTY DA SILVA', NULL, NULL, '(11)98339-7468', '(11)4505-2276', 'nao atendeu mandei wpp \n\n\nOlá Dra. boa tarde! \n\nTudo bom ? Feliz 2023. Um ano de muita saúde a Dra. e a família. \n\nEu sou representante da Bradesco Saúde, nos falamos no mês 07 do ano passado, apresentei uma alternativa a respeito de um trabalho que a Bradesco estava com nutricionistas. Porem, a Dra. estava gravida o que impossibilitou de continuarmos nossa conversa. \n\nTe envio esta mensagem para checar se podemos retomar, se o bebe já nasceu e se já é o momento de pensar em outras alternativas dentro do seu plano de saúde. Ainda esta com a Sul América? executivo né a Dra. tinha ? Ainda tem ?', '2023-01-10 15:21:17');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIA LUIZA BLANQUES PETTY DA SILVA', NULL, NULL, '(11)98339-7468', '(11)4505-2276', 'SÓ CHAMOU.\nFAZER A PESQUISA.', '2023-03-16 11:29:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'DAYANA KIRILIUK CARLESSE ALVES', NULL, NULL, '(11)99913-8526', '(11)4688-2672', '015 63 99913 8526 numero dela é esse, estava falando com ela, disse que eu podia falar mais precisava ser \nrápido, qnd comecei falar desligou na cara retornei só deu cai postal \n\ntem empresa em SP', '2022-07-11 18:18:11');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'DAYANA KIRILIUK CARLESSE ALVES', NULL, NULL, '(11)99913-8526', '(11)4688-2672', 'disse que tem dois planos, sula e Bradesco, informou que quem custe-a os dois é a empresa que trabalha \nachei estranho, vou pedir ao kaique que liguei dps', '2022-07-13 14:09:55');
