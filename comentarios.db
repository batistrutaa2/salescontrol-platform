INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'JOYCE ZIMMERMANN', '21323262822', NULL, NULL, NULL, 'EM CONTATO COM A MESMA NO 0(11) 3662-1686 ELA AO MENOS DEIXOU EU TERMINAR DE FALAR E DISSE PRA EU NEM PERDER MEU TEMPO QUE ELA NÃO TINHA INTERESSE ALGUM E DESLIGOU', '2023-11-30 11:39:35');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'JULIANA RODARTE PONTES', '63355302104', NULL, NULL, NULL, 'TROCOU DE PLANO RECENTEMENTE PARA UM PLANO INTERNACIONAL, FRISEI DEIXAR O MATERIAL SEM COMPROMISSO PARA QUE ELA ESTUDASSE MAS A MESMA DISSE QUE NO MOMENTO NÃO TEM INTERESSE', '2023-10-24 15:36:56');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'JULIANA RODARTE PONTES', '63355302104', NULL, NULL, NULL, 'EM NOVO CONTATO A MESMA DISSE QUE NÃO ESTA TENDO PROBLEMA ALGUM COM O PLANO INTERNACIONAL DELA QUANTO A UTILIZAÇÕES NEM NADA, DISSE QUE CONSEGUIU REDUZIR O CUSTO DELA PORÉM ESTA ABERTA A RECEBER UM NOVO ESTUDO PELA OMINT, A MESMA INFORMOU SER SOZINHA E TER A IDADE DE 48 ANOS, IREI ENVIAR O ESTUDO PELO WHATS', '2024-01-15 16:42:32');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'JULIANA RODARTE PONTES', '63355302104', NULL, NULL, NULL, 'NA VDD A PESSOA COM QUEM EU VINHA FALANDO É UMA CONHECIDA DA JULIANA E ATÉ MESMO OFERECI PRA ELA PORÉM NÃO FEZ SENTIDO OS VALORES POR ELA ESTAR EM UM PLANO INTERNACIONAL... ELA DIZ QUE NÃO PODE PASSAR O CTT DA JULIANA E ATÉ O MOMENTO NÃO CONSEGUI LOCALIZAR A MESMA, APENAS UM HOSP EM DIADEMA QUE ELA TRABALHA PORÉM AS VEZES QUE TENTEI ACHAR ELA LÁ A MESMA NÃO ESTAVA', '2024-01-30 16:14:12');
