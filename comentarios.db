INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'PEDRO DE LIMA JUNIOR', '29733219800', '1125060963', '11999719188', '11941402544', 'Em contato com o cliente, o mesmo insatisfeito com descredenciamento e valor. Quer trocar para a Bradesco mas tem receio por conta de Melanoma em 2013.\nTem interesse em conhecer novas possibilidades de plano. Solicitou novo contato com a Andrea conforme registro de telefone abaixo.\nPrecisamos levantar a melhor opção de custo e benefício e entrar em contato.', '2022-10-19 10:36:56');
