INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LEOPOLDO ROSSI AZEREDO TELO', NULL, '1198548-4648', NULL, NULL, 'PESQUISA  08-03-2023\r\n\r\n292.019.408-90 46 ANOS. CLIENTE AFAVEL E UM POUCO SÉRIO. SEMPRE TEM PROBLEMAS COM REEMBOLSO E ISSO INCOMODA MUITO ELE. O VALOR QUE ESTÁ PAGANDO, É O QUE MAIS INCOMODA. (NÃO CONSEGUI CONFIRMAR VALOR E NO SITE DA BRADESCO ELE NÃO ESTÁ) ESTÁ ESPERANDO PELA LIGAÇÃO, TEM INTERESSE EM REDUZIR O CUSTO. CLIENTE NÃO POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE NÃO POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-09 10:42:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LEOPOLDO ROSSI AZEREDO TELO', NULL, '1198548-4648', NULL, NULL, '(11) 9854-84648 Em contato com Leopoldo na sexta dia 17/03 \r\nCliente solicita retorno na próxima sexta dia 24', '2023-03-21 10:35:03');
