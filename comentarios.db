INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'RICARDO ANTONIO LOUREIRO VELOSO', '78405211853', '13997034129', NULL, NULL, 'Em contato com ele, informou que esta vendo ainda se de fato consegue aumentar o custo do plano, \nele queria um plano melhor, atendimento nacional etc. Questionei se o filho dele estava no contrato social e ele \ninformou que sim. Pedi então a Lu que cotasse no site porem com 2 titulares.', '2022-07-19 10:46:09');
