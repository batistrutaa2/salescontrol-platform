INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA MARIA DE O SANCHES', '03057521894', NULL, '11999968009', '11997655909', 'Em contato com o Felipe, o mesmo informou que sua mãe irá fazer uma pequena cirurgia no ombro agora em dezembro e iremos retomar as negociações em Janeiro.', '2022-12-01 14:50:33');
