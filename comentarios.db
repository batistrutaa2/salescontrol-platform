INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CARLOS KENRO HIGUCHI', NULL, '(11)99678-9288', '(11)5041-0563', NULL, 'Em contato com ele, informou que esta pra acontecer reajuste no plano dele e que esta preocupado, porem as idades são 75 e 71, amil nao compra carência, nem porto, vou contatar segunda informando que nessa configuração porto nao aceiita nem amil, que temos que cotar  bradesco com umfilho dele e abrimos um CNPJ', '2022-06-10 15:53:11');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CARLOS KENRO HIGUCHI', NULL, '(11)99678-9288', '(11)5041-0563', NULL, 'Em contato com ele, informei que nesta configuração não tinha aceitação, que precisaríamos fazer pela Bradesco e incluir mais um participante, consegui puxar o filho, ele pediu pra cotrar com ele sem compromisso, pedi a Lu que cotasse 42/71/75 TNQQ, ele infomrou que nao tem CNPJ, possa ser que o filho tenha não sei, um passo de cada vez vamos ver quanto da, ele paga 6mil sula adesão', '2022-06-27 10:33:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CARLOS KENRO HIGUCHI', NULL, '(11)99678-9288', '(11)5041-0563', NULL, 'meu nao tem o que fazer, eu liguei na qualicorp eles pagam 3.000 total 6 mil, bradesco ficou mais caro, eles nao tem cnpj, pedi pra cotar com o filho porem o filho é funcionario publico tb e nao tem cnpj, mto caroço', '2022-06-28 15:30:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CARLOS KENRO HIGUCHI', NULL, '(11)99678-9288', '(11)5041-0563', NULL, 'reajuste dele vai ser mes 09', '2022-09-01 10:00:00');
