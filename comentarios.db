INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIA DO CARMO CARDIA JULIAO', '24873727880', '6733214011', '67984834011', '67984551192', 'Olá Dra. boa tarde... \n\nTudo bom ? \n\nPassando para me colocar a disposição e checar se esta semana conseguimos... Pode ser horário após as 18h até as 20h ok.', '2023-05-15 14:52:51');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIA DO CARMO CARDIA JULIAO', '24873727880', '6733214011', '67984834011', '67984551192', 'sigo tentando esse raio dessa reunião, ela é medica, o marido tb, e ela quer a ruenião com os dois porem \nnunca conseguem horário e porque o fuso deles é diferente, qnd aqui é 18h lá ainda é 16h \nja falei pra ela quer podemos fazer as 20h porem ela nunca consegue conciliar com o esposo \ndei a sugestao agr dele mesmo me ligar, que o rejauste ta ai e tal que quero ajudar', '2023-06-29 11:37:54');
