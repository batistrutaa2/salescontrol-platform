INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'LUCIANA CHAIN SABONGE', '25704513808', '1239233843', '11982080201', '11992113370', '(11) 96963-0973 Em contato com Luciana, cliente informa que não possui interesse\nem troca por ser filho ser autista e estar acostumado com a SulAmérica. \nOferecido a troca administrativa para cliente, a mesma se interessa pelo projeto, e \nsolicita a cotação por e-mail para fazer uma avaliação. Possui CNPJ ativo e falado sobre\na cobrança da diferença no valor. \nRetornar em 3 dias conforme agendado com cliente para falar sobre a troca e argumentar\nfechamento .', '2022-08-30 11:08:37');
