INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'DANIEL ALVES FERREIRA', '20586245804', '1130813614', '11999749155', '11996535952', 'Jaqueline, boa noite! Eu estou de férias com a família. Gostaria de tratar negócios só na próxima semana. \nMuito obrigado! \nMSG DELE', '2022-07-25 10:00:00');
