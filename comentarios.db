INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CARLOS KENRO HIGUCHI', NULL, '(11)99678-9288', '(11)5041-0563', NULL, '(11) 9967-89288 - mandei a cotação pelo WhatsApp ele alegou: \nNão tem diferença de preço com Sul América. Sendo assim não vale a pena trocar 6 por 1/2 dúzia. Concorda? \n\nrespondi que sim concordo, mais ainda sim aconselharia a trocar para a amil devido a compra de carencia para \nidosos, me coloquei a disposição e é isso, retomar mais pra frente.', '2023-03-23 11:01:14');
