INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'SANDRA SENAMO', '00654802874', '1138541259', '11955897779', '11911485849', 'TELEFONE 3 É O DELA.\nCLIENTE DISSE QUE ESTA EM PROCESSO DE TROCA DE PLANO. AGRADECEU O MEU CONTATO REFERENTE A PESQUISA DE SATISFAÇÃO.\nLIGAREI NUM FUTURO PROXIMO, MAS ANTES LIGAR NA CENTRAL QUALICORP E VE SE ELA REALMENTE TROCOU.', '2022-10-17 10:42:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'SANDRA SENAMO', '00654802874', '1138541259', '11955897779', '11911485849', 'CLIENTE NÃO TEM NADA PARA RECLAMAR DO PLANO, NEM VALORES, NEM UTILIZAÇÃO.\nREEMBOLSO ESTÁ OK.\nPESQUISA SEM SUCESSO.', '2023-02-06 10:49:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA RITA GOMES KEITERES', '08556389821', NULL, '11940038024', '11939395384', 'FAZENDO A PESQUISA, O CLIENTE MOSTROU INSATISFEITO COM O VALOR QUE ESTÁ PAGANDO.\nTINHA UM RECEIO REFERENTE A CIRURGIA QUE ELE FEZ HA 8 ANOS ATRAS, MAS EXPLIQUEI QUE NAO SERIA UM PROBLEMA.\nFALOU QUE ESTA CHATEADO COM A SULAMERICA, QUANDO PRECISOU ELES NAO O AJUDARAM NUMA INTERNAÇÃO QUE TEVE.\nFALEI QUE DIVERSOS CLIENTES ESTÃO CHATEADOS TAMBEM E ESTÃO INDO PARA A BRADESCO.\nDIRIA QUE ESTÁ 80% VENDIDO.', '2022-10-11 15:20:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA RITA GOMES KEITERES', '08556389821', NULL, '11940038024', '11939395384', 'Em contato com o cliente, o mesmo se interessou pelo Bradesco Saúde pelos valores disponíveis e pelo atendimento. Fiz comparação em linha com o cliente sobre a SulAmerica e o mesmo identificou a grande diferença entre ambos. Solicitou as informações por e-mail e WhatsApp e posteriormente marcarmos uma reunião para alinharmos o fechamento.\r\nTambém solicitou cotação incluindo Albert Einstein e Sírio Libanês.\r\n\r\nAtenciosamente,\r\n\r\nKaique Albertin', '2022-10-17 17:24:48');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA RITA GOMES KEITERES', '08556389821', NULL, '11940038024', '11939395384', '11939395384 - Enviar no WhatsApp', '2022-10-17 17:26:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA RITA GOMES KEITERES', '08556389821', NULL, '11940038024', '11939395384', 'Em contato com o cliente, o mesmo solicitou retorno na próxima segunda feira para agendarmos uma reunião.', '2022-11-01 15:33:23');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA RITA GOMES KEITERES', '08556389821', NULL, '11940038024', '11939395384', 'Tentativa de contato, sem sucesso.', '2022-11-09 16:27:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ANA RITA GOMES KEITERES', '08556389821', NULL, '11940038024', '11939395384', 'Em contato com o Rogério, o mesmo informou que vai fazer as transferências para Bradesco Porém só no início do ano que vem.', '2022-11-18 15:19:29');
