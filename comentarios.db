INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARCIO KOTT GOLDENSTEIN', '99519755853', '1130689530', '11999810410', '11999810407', '(11) 9998-10410 Em contato com cliente, o mesmo desconfiou da abordagem como qualicorp \nSanou algumas dúvidas e ao retornar o contato ao mesmo, falou que o número era de sua advogada e \nque não iria alterar o plano de saúde no momento!', '2023-07-20 14:52:16');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARCIO KOTT GOLDENSTEIN', '99519755853', '1130689530', '11999810410', '11999810407', '(11) 9998-10410 Em contato com o mesmo, cliente informa que ja fez suas alterações sem \npassar maiores informações e que não irá alterar o plano, está satisfeito com o que tem!', '2024-01-10 13:22:07');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARCOS M R CAMPOS', '17372018870', '1123690980', '11984189222', NULL, '(11) 9841-89222 Em contato com cliente, o mesmo informa que não tem interesse em sair\nda sulamérica, embora o custo não esteja do seu agrado\nTratei a proposta da Amil saúde, o mesmo não quis recebe-la!', '2023-07-20 16:52:01');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIO CORONA FILHO', '94030367887', '1129533946', '11991840179', NULL, '(11) 9918-40179 Em contato com o mesmo, cliente informa que está avaliando a troca do seu plano\nse demonstra muito insatisfeito com o valor pago e com a qualicorp, informa estar tratando com outra\ncorretora a troca do seu seguro \n\nEnviei uma proposta no email passado pelo mesmo : corona.eng@outlook.com.br\nPorém proposta da Amil S750 está voltando no email, tentar um novo contato para reenviar a proposta! \n\nRetornar!', '2023-07-20 16:37:58');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIO CORONA FILHO', '94030367887', '1129533946', '11991840179', NULL, '(11) 9918-40179 Em contato com o mesmo, alega que no momento não irá fazer a transição\ninforma que caso queira irá me contatar e trocaria comigo \nTentar futuramente!', '2023-07-26 13:49:51');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIO SIXTO ISMAEL R QUIROZ', '89738594804', '1150447779', '11997877531', '11968659783', '(11) 9686-59783 Em contato com cliente, o mesmo aceita receber proposta da Amil Saúde S750 R1 \n Está pagando atualmente R$ (11) 13.757,51\n\nValores ficaram atrativos, informa que tem empresa baixada, solicita cotação tanto por email quanto via\nwhatsapp \nSolicita retorno na próxima semana na data de quinta-feira ou sexta-feira\nCliente de potencial pagando caro, retornar com argumentos de fechamento!', '2023-06-22 16:53:33');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIO SIXTO ISMAEL R QUIROZ', '89738594804', '1150447779', '11997877531', '11968659783', '(11) 9686-59783 Em contato com cliente, o mesmo aceita receber proposta da Amil Saúde S750 R1 \r\n Está pagando atualmente R$ (11) 13.757,51\r\n\r\nValores ficaram atrativos, informa que tem empresa baixada, solicita cotação tanto por email quanto via\r\nwhatsapp \r\nSolicita retorno na próxima semana na data de quinta-feira ou sexta-feira\r\nCliente de potencial pagando caro, retornar com argumentos de fechamento!', '2023-06-22 16:53:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIO SIXTO ISMAEL R QUIROZ', '89738594804', '1150447779', '11997877531', '11968659783', '(11) 9686-59783 Em retorno com Mario, cliente fala do seu reajuste porém alega estar ocupado\nSolicita retorno em momento mais oportuno para tratarmos de uma possível transição!', '2023-07-11 15:55:47');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIO SIXTO ISMAEL R QUIROZ', '89738594804', '1150447779', '11997877531', '11968659783', '(11) 9686-59783 Em retorno com cliente, o mesmo informa que sua filha médica deu queixas quanto\nao plano da Amil. O mesmo informa que está mudando de sulamérica físico para sulamérica empresarial!', '2023-07-19 15:49:20');
