INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO OLIVEIRA MACHADO', 'MARIA CONCEICAO DE SOUZA SILVA', '64444910887', '(11) 4432-1288', '(11) 9964-30598', '(11) 2598-4611', '(11) 2598-4611 - EM CONTATO COM A CLIENTE A MESMA ESTÁ INSATISFEITA NA QUALICORP PORÉM DISSE NÃO TER MAIS ALGUÉM PARA ADICIONAR AO PLANO, POSSUI EMPRESA COM 3 SOCIOS, NÃO CITEI A OPÇÃO JUNTO, MANDEI COTAÇÃO I LOVE PDF 1 VIDA BRADESCO, \nABORDAR TEMOA NO PROXIMO CONTATO, APRESENTANDO REDUÇÃO NO CUSTO E UNINDO OS SOCIOS AO MESMO PLANO.', '2023-09-19 15:37:24');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO OLIVEIRA MACHADO', 'MARIA CONCEICAO DE SOUZA SILVA', '64444910887', '(11) 4432-1288', '(11) 9964-30598', '(11) 2598-4611', '12.271.513/0001-16', '2023-09-19 15:39:12');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO OLIVEIRA MACHADO', 'MARIA CONCEICAO DE SOUZA SILVA', '64444910887', '(11) 4432-1288', '(11) 9964-30598', '(11) 2598-4611', '(11) 2598-4611 - não estava em casa, liguei no celular e deu caixa, retornar amanhã cedo.', '2023-09-21 15:38:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO OLIVEIRA MACHADO', 'MARIA CONCEICAO DE SOUZA SILVA', '64444910887', '(11) 4432-1288', '(11) 9964-30598', '(11) 2598-4611', 'EM CONTATO COM A MESMA, DISSE QUE IA CONVERSAR COM A FILHA SABER QUAL CAT ESTÁ NA AMIL, VISANDO PODER FAZER PORTABILIDADE. FILHA VAI ENTRAR EM CONTATO.', '2023-09-26 15:33:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO OLIVEIRA MACHADO', 'MARIA CONCEICAO DE SOUZA SILVA', '64444910887', '(11) 4432-1288', '(11) 9964-30598', '(11) 2598-4611', 'Em contato com a cliente informamos a forma de fazer a portabilidade para o contrato da filha, a mesma não se sentiu segura para passar login e senha. Me mantive a disposição e pontuei a respeito da empresa.', '2023-10-20 15:25:08');
