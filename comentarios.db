INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIA FELICIA G TADDEI', '86309684868', '2130886094', '11996546444', '11974409040', '11 99654-6444 Consegui contato com cliente, a mesma se interessou pela proposta e falou que valores \natuais estão inviáveis! Passada a Porto Seguro Diamante, agregando a idade do Genro na mesma de sua filha. \nCliente informa que teve câncer no intestino em 2015, porém no momento está cuidando de várias questões\npessoais, casamento da filha, que só poderá tratar da transição em OUTUBRO! \n\nRETORNAR EM OUTUBRO PARA A MESMA!', '2024-07-02 15:17:32');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIO LEONE', '53255852820', '1125896636', '11991059647', '11991291131', '(11) 9912-91131 Em contato com cliente, o mesmo se interesse pelo tema da  PORTABILIDADE\nCliente com tratamento de cancer e alto valor, gostou da Bradesco Saúde e também Amil Selecionada\nCliente informa que irá conversar com seu advogado para marcarmos uma reunião \nO mesmo solicitou cotação no email acima e pediu retorno na próxima semana para uma reunião detalhada!', '2024-06-27 15:36:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIO LEONE', '53255852820', '1125896636', '11991059647', '11991291131', '(11) 9912-91131 Em retorno com cliente, o mesmo informa que seu advogado está viajando e ainda não pode\nabordar o tema com o mesmo. Solicita um retorno no começo de agosto para tratarmos a respeito do tema e quem\nsabe fazermos uma transição!', '2024-07-15 11:56:31');
