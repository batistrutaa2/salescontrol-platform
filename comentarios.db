INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FERNANDO LEVINO PEREIRA', '29516742874', '(11) 4667-5758', '(11) 99998-4737', '(11) 98558-1392', '(11) 9855-81392 - Em contato com Fernando, cliente informa que irá realizar uma cirurgia\r\ne solicita retorno no final do dia!', '2022-11-09 17:30:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FERNANDO LEVINO PEREIRA', '29516742874', '(11) 4667-5758', '(11) 99998-4737', '(11) 98558-1392', '(11) 9855-81392 Em contato com Fernando, cliente bem receptivo passa informações do seu plano\n\nO mesmo encontra-se na Porto Seguro Ouro Max  atualmente pagando R$ 7.591,61. Informa que seu sócio \ncom mais 4 participantes estão inclusos no plano. CNPJ : 34.042.810/0001-22\n\nFeito cotações com ele em linha comparado as idades dele que pagam : R$ 4.981,90. \nTodas as operadoras não bateram o valor, a que chegou mais próxima foi a sulamérica porém\no mesmo perde o Sírio, o que não é do interesse dele\n\nInforma que seu reajuste é no final do ano, pede retorno para sabermos como foi e quem sabe melhorarmos\nsuas condições.', '2023-03-21 16:09:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FERNANDO LEVINO PEREIRA', '29516742874', '(11) 4667-5758', '(11) 99998-4737', '(11) 98558-1392', '(11) 9855-81392 Tentativa de retorno, só chamou!', '2023-11-07 11:05:13');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FERNANDO LEVINO PEREIRA', '29516742874', '(11) 4667-5758', '(11) 99998-4737', '(11) 98558-1392', '(11) 9855-81392 Tentativa de contato sem sucesso, enviada mensagem em seu whatsapp \nTentar com cliente proposta da Amil, o mesmo tem 4 vidas mais o grupo do sócio na Porto, podendo aproveitar\na tabela de 5 vidas da Amil com propostas de baixo valor comparado ao preço atual\nRetrabalho !', '2024-07-24 16:54:14');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'GABRIELA DA SILVA R YOKOMIZO', '14663303846', NULL, '(11) 99987-6226', '(11) 99282-5075', 'Tentativa de contato sem sucesso \nPossui benefícios com a Porto\n(11) 9998-76226 caixa postal \n(11) 96623-3533 só chamou\n(11) 9928-25075 Só chamou \nPossui participação em empresa', '2022-08-11 14:06:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'GABRIELA DA SILVA R YOKOMIZO', '14663303846', NULL, '(11) 99987-6226', '(11) 99282-5075', '(11) 96623-3533 Em contato com Gabriela, a mesma se interessa pelo projeto. \nFalado sobre Bradesco Saúde e Amil selecionada, cliente se queixa quanto a \nutilização dos reembolsos atuais para fisioterapia, fono e terapia . \nA mesma informa ter DPAC, e fazer alguns tratamentos de fono atualmente \nCliente possui CNPJ com esposo, enviada cotações com prévias de reembolsos \nda Bradesco e agendado um retorno para segunda feira para falarmos sobre \nas propostas enviadas. Retornar com argumentos de fechamento!', '2022-08-17 15:17:12');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'GABRIELA DA SILVA R YOKOMIZO', '14663303846', NULL, '(11) 99987-6226', '(11) 99282-5075', 'Retorno agendado', '2022-08-22 11:00:00');
