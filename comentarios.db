INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CARLOS ALBERTO HENRIQUES ASCENSAO', NULL, '1199872-2152', NULL, NULL, 'PESQUISA  08-03-2023\r\n\r\n054.285.828-20 CLIENTE ESTÁ COM 59 ANOS. CLIENTE AFAVEL E UM POUCO EXTROVERTIDO. ELE RECLAMOU DO VALOR, E SE POSSIVEL, QUERIA PAGAR A METADE. ELE FALOU QUE MUDOU EM NOVEMBRO, EU SÓ CONCORDEI FINGINDO SABER. DISSE QUE ALGUEM RETORNARIA TRAZENDO OPÇÕES COM REDUÇÃO DE CUSTO. NÃO TEVE PROBLEMAS COM UTILIZAÇÕES NEM REEMBOLSO, POIS ELE NEM USA. CLIENTE POSSUI DIVERSOS BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-09 10:44:17');
