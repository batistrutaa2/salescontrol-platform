INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MIGUEL APARECIDO D ANGIOLI', '58885870872', '1140220113', '11995826689', NULL, '(11) 9958-26689 Em contato com o mesmo e também com o seu filho João \n 11 99911-1233 Contato do filho joão\n\nQuem trata referente ao assunto é seu filho João, cliente pede retorno para a próxima semana e informa que \nse interessou pelas propostas enviadas da Amil S750 R1 e também da Amil One S1500 \nIrei retornar o contato pois valores em comparação ao que o pai paga ficaram bem atrativos\n\nFilho possui o antigo plano sompo seguros .', '2023-07-28 16:45:55');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MIGUEL APARECIDO D ANGIOLI', '58885870872', '1140220113', '11995826689', NULL, 'RETORNAR NA SEMANA DO DIA 22/07  PARA TRAZER DOCUMENTOS \n11 99911-1233 - Em contato com filho João, o mesmo se interessa bastante no tema citado. \nCom cenário atual de CNPJ de JUNDIAÍ, o mesmo passou idades do irmão de 44 anos, esposa 42 e duas\nfilhas de 0 a 18 anos, inclusas com o mesmo e o pai , fizemos cotações com AMIL e BRADESCO SAÚDE. \nExplicado ao mesmo todo processo de portabilidade de plano para o pai, sem carências para nada\nRETORNAR NA SEMANA DO DIA 22/07  PARA TRAZER DOCUMENTOS', '2024-07-12 15:59:11');
