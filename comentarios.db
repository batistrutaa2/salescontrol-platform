INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PAULINO DE OLIVEIRA N FILHO', '18693440810', '1146168352', '11999991297', '11999829756', 'TELEFONE 3\nCLIENTE ESTÁ TENDO MUITOS PROBLEMAS COM UTILIZAÇÕES, DEMORA EM APROVAÇÕES TAMBEM.\nMAS NO DECORRER DA CONVERSA ELE FALOU QUE SE A SULAMERICA QUE ESTA FAZENDO ISSO TUDO, ELE \nNÃO TEM O QUE CONVERSAR COMIGO E DESLIGOU.\n\nCLIENTE NÃO POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI DIVERSAS EMPRESAS - ASSERTIVA.', '2023-03-10 13:16:57');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PAULINO DE OLIVEIRA N FILHO', '18693440810', '1146168352', '11999991297', '11999829756', '(11) 9998-29756 Em retorno com Sr. Paulino, cliente informa que esposa Betina junto com \ndois filhos ingressaram e já estão na companhia. \nO mesmo informa que tentou migrar e não passou na entrevista médica sem a aplicação de CPT\nPassou ter pressão alta, sopro no coração e um problema crônico no seu joelho. \nInformou que não iria tentar mudar novamente e prefere ficar no seu plano \n\nAbordei sobre portabilidade, inclusão na apólice da esposa cobrando uma mensalidade o mesmo\nfalou que não quer.', '2023-03-22 10:00:13');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PAULINO DE OLIVEIRA N FILHO', '18693440810', '1146168352', '11999991297', '11999829756', 'Em contato, cliente solicitou contato em outro momento para falarmos sobre a Portabilidade.', '2024-07-08 12:12:20');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CELSO CALDAS MARTINS XAVIER', '25864883859', '1127697648', '11963886837', '11996555790', 'Em contato com esposa do Celso: 11 96388-6837 - Cliente informa estar corrida, porém solicita chamada no whatsapp para tratar assunto, enviada cotação Bradesco interior 1 TNP8', '2022-06-02 11:03:22');
