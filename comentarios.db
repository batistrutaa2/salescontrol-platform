INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'LUIZ CARLOS DUARTE', '6912456812', '1938922157', '11971104242', '11996119560', 'PESQUISA  06-03-2023\r\n\r\nCLIENTE AFAVEL. (11) 99612-7555 (MULHER DELE) E COMO ELE ESTAVA PROXIMO NA HORA, CONSEGUI FALAR POR LA. (11) 99611-9560 ESSE É O TELEFONE DELE, E ESTA ESPERANDO O RETORNO LA. CLIENTE TEVE O REAJUSTE AGORA POR FAIXA ETARIA E SUBIU MUITO, ELE JA ESTÁ COM INTERESSE EM TROCAR DE PLANO, E ELE MESMO FALOU QUE TEM CNPJ POIS É ADVOGADO, E GOSTARIA DE USAR, ELE SABE QUE DA PRA REDUZIR MUITO O CUSTO. NAO TEVE PROBLEMAS COM UTILIZAÇÕES NEM REEMBOLSO (NUNCA SOLICITOU) ENTÃO O FOCO É SÓ CUSTO CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-09 10:23:32');
