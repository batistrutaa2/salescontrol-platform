INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LIZIA MANHAES DE ALMEIDA', '07586720800', NULL, NULL, NULL, '(11) 99492-0606 Em contato com Lizia, a mesma sana muitas dúvidas, informa que não pode usar suas \nempresas por um contrato, e fala ter receio da transição por ter tido um câncer a 10 anos atrás. \nA mesma passa as idades da apólice de sua filha que está na Amil One Health 2500 através de um MEI\nCotado Porto Seguro Diamante para todos que reduziu muito, idaides 37 , 08, 09 , 13 e 40 \nCliente informa que irá conversar e comparar custos com a apólice da filha para passar retorno', '2024-03-20 12:06:41');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LIZIA MANHAES DE ALMEIDA', '07586720800', NULL, NULL, NULL, '(11) 99492-0606 Em retorno com cliente, a mesma informa que seu genro a incluiu em seu plano \natual com a Amil One, manter-se próximo a cliente para verificar se realmente foi o que ocorreu !', '2024-03-27 10:39:36');
