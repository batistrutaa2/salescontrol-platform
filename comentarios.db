INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'RICARDO ANTONIO LOUREIRO VELOSO', '78405211853', '13997034129', NULL, NULL, 'em contato com ele, ta ruim de falar hj. Mais informei que agr tinha valores imperdiveis pra ele e que ia \nenviar \ntudo por email, fiz o envio de um email pra ele agr que se ele nao fechar é de fato caroço. \n(Aguardo seu retorno para iniciarmos o processo. Pois agora de fato ficou imperdível. \n\nSalientando que estou com disponibilidade destes valores até o dia 25/08. \n\nAtt, )', '2022-08-15 16:32:57');
