INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ANTONIO DO AMARAL PACHECO', '07636326868', '1124855892', '11972451116', '75991910859', '(11) 9724-51116 - abordei como sul america pra tentar uma retenção, falou um monte, que nao é cliente \nmais a anos, que saco que isso que aquilo ficam ligando pra ele e ele nao quer', '2023-03-20 10:39:04');
