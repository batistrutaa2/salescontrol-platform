INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'MARIA CAROLINA CORREIA LIMA PIVA', '04242731876', NULL, NULL, NULL, 'EM CTT COM A MESMA CONSEGUI ENTRAR COM OUTRA ABORDAGEM, CONSEGUI SANAR TODAS AS OBJEÇÕES DA CLIENTE REFENTE AO BENEFICIO E SENDO ASSIM ELA ACEITOU RECEBER UMA COT JUNTO A OMINT POR WHATS COMO ELA PEDIU', '2023-11-07 15:09:54');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'MARIA CAROLINA CORREIA LIMA PIVA', '04242731876', NULL, NULL, NULL, 'EM NOVO CTT COM A CLIENTE QUE JÁ CONVERSOU COM O KAIQUE UM POUCO, ENTENDEU O MATERIAL, TIROU AS DUVIDAS QUE TINHA, PORÉM HOJE ENTRANDO EM CTT PARA MARCAR UMA REUNIÃO ELA DISSE QUE NÃO VIU NADA AINDA...', '2023-11-23 14:51:00');
