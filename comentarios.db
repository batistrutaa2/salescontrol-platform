INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CLEBER PINTO CAMACHO', '04557367747', '1133756569', '11986761832', '11982033277', '(11) 9867-61832 - não atendeu \n(11) 9820-33277 - em contato com ele, disse que chegou a pensar mesmo a fazer bradesco com a esposa \nela tem 50 anos, porem tinha acabo de mexer e nao quis mudar dnv, pediu pra enviar pelo whats cotando \nincluindo ela e sem incluir. FALEI PRA ELE QUE EU MESMA MANDO, VOU AMNDAR PELO WHATS \n(11) 3375-6569 - nao atendeu \n\nem busca no assertiva \n\n(11) 2865-5552 - nao atendeu', '2022-11-21 12:02:04');
