INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANTONIO LYNDON JOHNSON ROCHA DE LIMA', '10492630810', '11999510532', '11971329096', '1139045947', '(11) 9995-10532 CLIENTE DOS NOMES LISTAGEM AMIL QUALICORP. \n\nO mesmo encontra-se na sulamérica saúde pagando valor atualizado porém esposa trata câncer, o mesmo\nsolicita cotação em seu email e sana dúvidas sobre abertura de CNPJ . \nTrazer o interesse, para posteriormente vir com um terceiro participante e conclusão da portabilidade! \n\nCotação Amil S750 Enviada pelo whatsaapp!', '2024-05-13 16:40:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANTONIO LYNDON JOHNSON ROCHA DE LIMA', '10492630810', '11999510532', '11971329096', '1139045947', '(11) 9995-10532 Em contato com cliente, o mesmo informa que devido aos tratamentos da esposa, \nnão se sente seguro em mexer no seu plano atualmente, ter que abrir empresa e etc\nInforma que ligou na qualicorp e reduziram R$ 900,00 do seu plano. \nSolicita retorno no próximo ano no reajuste de Abril para poder tratar a respeito de uma transição novamente!', '2024-05-27 16:32:18');
