INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'VIVIANE FLORES DOS SANTOS', '27916044803', '(11) 2896-0931', '(11) 96842-9977', '(11) 97689-8157', '(11) 9684-29977 - nao podia falar, pediu ret em 20 min \n(11) 9768-98157 - desc \n(11) 2896-0931 - nao atendeu \nabordando como porto', '2023-03-28 10:18:53');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'VIVIANE FLORES DOS SANTOS', '27916044803', '(11) 2896-0931', '(11) 96842-9977', '(11) 97689-8157', NULL, '2023-03-28 10:19:32');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'VIVIANE FLORES DOS SANTOS', '27916044803', '(11) 2896-0931', '(11) 96842-9977', '(11) 97689-8157', '(11) 9684-29977 - em contato com ela, abordei projeto Porto, ela ouviu e tal. Porem informou estar na sul \namerica via empresa, pagando 1.200,00 no especial 100. Acreditava que a porto nao bateria o preço. \nFiquei de mesmo assim enviar no Whats para que ela tenha opção, vou fazer no ilovep e mandar valor dela \ne filho só e me colocar a disposição para qnd sul america reajustar.... pedi pro le checar tambem que dia ela \nsaiu da quali pra eu ter ideia de qnd retornar. \n(11) 9768-98157 - desc \n(11) 2896-0931 - nao atendeu \nabordando como porto', '2023-03-28 10:59:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE LICCIARDI', '5047405800', '11970729505', NULL, NULL, 'AFAVEL E MUITO ANALITICA. CLIENTE FALOU SOBRE O VALOR CARO E O REAJUSTE DE "22,5%". ESTÁ DESDE 2010 NA SULAMERICA. VALOR DO PLANO É EM TORNO DE 28.000,00 MAS ELA TEM UM PROCESSO E CONSEGUIU REDUZIR (MAS ELA NÃO DISSE O VALOR ATUAL) (LEANDRO PUXOU E VALOR ESTÁ 14.464,55) HOJE O REEMBOLSO DELA É 510,00 E ELA UTILIZA BASTANTE O REEMBOLSO. PRINCIPAL QUESITO ALEM DO VALOR, VIAGENS INTERNACIONAIS, ELA NAO CONSEGUE PEDIR O SEGURO VIAGEM ENROLAM ELA, FICAM EMPURRANDO PARA OUTRO NUMERO, MANDA ELA ENTRAR EM CONTATO POR EMAIL E FICAM NESSA.. E JA FAZ 3 ANOS QUE ELA NÃO CONSEGUE SOLICITAR SEGURO VIAGEM. O MARIDO DELA FOI NO EINSTEIN E NAO CONSEGUIU FAZER 2 EXAMES LA DENTRO, TEVE QUE SAIR E IR NO FLEURY. ELES NÃO USAM MUITO, E QUANDO USAM APENAS EINSTEIN E FLEURY. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO.', '2023-02-13 10:17:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE LICCIARDI', '5047405800', '11970729505', NULL, NULL, 'Amil e todas as outras operadoras em cotação não batem o preço atual pago pela cliente\n\nTentar futuramente!', '2023-03-17 10:31:33');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE LICCIARDI', '5047405800', '11970729505', NULL, NULL, '(11) 97072-9505 Consegui contato com esposa Heloisa, a mesma informa que quer tratar do assunto porém\ncasa está em obras, barulho estava muito alto. A mesma informa que depois das 17h estará mais tranquila\ne conseguirá dar uma atenção. VENDER CNPJ DE BELO HORIZONTE COTANDO AMIL S2500 R1 E R2 \nCLIENTE PAGANDO ALTO VALOR.', '2024-08-01 10:49:56');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE LICCIARDI', '5047405800', '11970729505', NULL, NULL, '(11) 97072-9505 Tentativa de retorno, telefone para contato só chamou, tentar novamente!', '2024-08-01 17:16:49');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE LICCIARDI', '5047405800', '11970729505', NULL, NULL, '(11) 97072-9505 Consegui contato com cliente, passado todo cenário do mercado e cotação da Amil One\nS2500 com tabela de Minas Gerais, com e sem coparticipação. A mesma se interessou e informou que irá \nconversar com seu esposo. Passada a consultoria para abertura de empresa em Minas e usar os valores de la. \nRetornar em breve!', '2024-08-01 18:24:41');
