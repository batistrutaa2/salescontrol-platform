INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ANTONIO FERREIRA APOLONIA', '59124350834', NULL, '11991146960', NULL, 'Retornou o contato, me informou que esta na sula, pagando 4.500 por pessoa, 68-64 \ndeixou mandar cotação da Bradesco no e-mail, enviei e já informei que na simulação cotei com uma vida de 0 a 18 e que é por CNPJ, então no segundo contato abordar esses dois potnos, e em ultimo caso partir pra um adesão \nret amanha', '2022-07-05 15:30:00');
