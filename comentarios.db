INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'NORIKO SHIMABUKURO', '84040564804', '1155316964', '11994329311', '44991461758', 'Em conversa com cliente via WPP a mesma disse que não gosta da opção AMIL e nem UNIMED pois não teve boas experiências com a companhias.\nNoriko também não possui CNPJ e disse não ter outra vida para incluir.\nPortanto não há muito oque fazer', '2024-01-15 17:18:10');
