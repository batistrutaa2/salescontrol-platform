INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BERENICE BASTA', '11344153895', NULL, '(11) 9711-45213', '(11) 9997-59930', '(11) 9997-59930 - em ctt com ela, disse que vários corretores ligam pra ela e que nunca possuem um plano \ncompatível, falei de porto ou Bradesco, porto ela ja cortou disse que não aceitam médicos , \nem ctt via wpp, mandei Bradesco, expliquei tudo rede e aceitação de familiares para ela incluir, e ela alegou \nque o plano que mandei não era compatível, vários hospitais somente com H ou somente PS. \nmandei omint e expliquei tal que os diferenciais e que aceitava somente ela mas nao respondeu \nir acompanhando, \n(11) 9711-45213 - \n(11) 97114-5213 - \n(11) 97399-5906 - \n(11) 99936-1268 - \n02.018.826/0001-03 - AMOGI ASSISTENCIA MEDICA, OBSTETRICA E GINECOLOGICA S/S', '2024-06-04 14:22:15');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'BERENICE BASTA', '11344153895', NULL, '(11) 9711-45213', '(11) 9997-59930', 'em ctt ela alega ue o bradesco não supri o sul américa, mandei omint, porem ela nao responde mais, mandei msg agr pra ela tentando rever, mandei uma nova rede tb da Bradesco, salientei reajuste... To tentando trazer', '2024-06-12 10:38:56');
