INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'CAROLINE G BERTACCHINI', '36311625881', '(11) 9817-93282', NULL, NULL, 'Em conversa com Caroline a mesma foi muito afavél e conversamos bastante sobre o plano.\nApresentei todos os detalhes, todas as vantagens e a mesma gostou bastante porém deixou claro que a \nassistencia medica de sua filha não pode ter onus pois esta em processo judicial com seu ex marido.\nEnviar um material no email e retornar na proxima semana para marcar a reunião', '2023-11-09 17:21:08');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'CAROLINE G BERTACCHINI', '36311625881', '(11) 9817-93282', NULL, NULL, 'Em conversa com Mãe de Caroline, a mesma disse que a filha não esta em SP e pediu que enviasse o material no \nWPP para vizualizar e conversar com Caroline, ela também informou que a filha gostou da proposta e até mesmo \nhavia conversado com a mãe.', '2023-11-16 15:34:34');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'CAROLINE G BERTACCHINI', '36311625881', '(11) 9817-93282', NULL, NULL, 'Mae informou que o numero e dela e da filha e informou que nao pode falar mas pediu para caroline entrar em contato', '2023-11-21 15:17:17');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'CAROLINE G BERTACCHINI', '36311625881', '(11) 9817-93282', NULL, NULL, 'Mãe de Caroline atendeu e disse que não podia falar no momento, mais informou que caroline esta em reunião e que a filha entrará em contato assim que possivel', '2023-11-22 09:54:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'CAROLINE G BERTACCHINI', '36311625881', '(11) 9817-93282', NULL, NULL, 'Mae informou que caroline esta no trabalho e ela ira retornar assim que possivel', '2023-11-28 11:02:14');
