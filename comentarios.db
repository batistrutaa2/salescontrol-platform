INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'ANDREA P M CAMPOY', '07089688801', '(12) 4141-0551', '(12) 9812-72257', '(12) 9814-39108', 'Apresentação feita no whats: \r\n\r\nAndrea, boa-tarde ! \r\nSou o Leandro especialista de seguros e parceiro da Qualicorp, falamos agora pouco...\r\nRealizei uma pesquisa bem minuciosa sobre oportunidades de planos através da entidade\r\nde classes e infelizmente hoje não conseguimos te trazer algo similar e com valores \r\nmelhores, o que estamos conseguindo proporcionar para os clientes através destes \r\ncontatos são melhorias um plano via CNPJ. Vou deixar apenas um estudo aqui para\r\nsenhora identificar estes diferenciais através desta opção e em um futuro oportuno\r\nfalamos mais sobre até mesmo a evolução de uma empresa para efeito de assistência\r\nmedica se for do interesse. Desde já agradeço e conte comigo.\r\n\r\nAcompanhar', '2023-06-29 15:52:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'ANDREA P M CAMPOY', '07089688801', '(12) 4141-0551', '(12) 9812-72257', '(12) 9814-39108', 'Em conversa com Leandro a cliente informou não ter interesse pois achou que esta caro', '2023-07-04 11:30:54');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'ANDREA P M CAMPOY', '07089688801', '(12) 4141-0551', '(12) 9812-72257', '(12) 9814-39108', 'TENTATIVA DE CONTATO SEM SUCESSO', '2024-01-09 16:46:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'ANDREA P M CAMPOY', '07089688801', '(12) 4141-0551', '(12) 9812-72257', '(12) 9814-39108', 'tentativa de contato sem sucesso', '2024-01-11 10:20:05');
