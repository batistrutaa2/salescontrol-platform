INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'TOMAS PATRICIO SMITH HOWARD JUNIOR', '35214543808', '13996039577', NULL, NULL, '(13) 99603-9577 – Ele esta na Sul América, e ela estava na Amil 34 idade dela.... \nAte o fim deste mês o plano dela sera cancelado, este sul américa que ele esta, é pelo cnpj do pai dele, \ne como estão com planejamento dela engravidar, ele quer desvincular para um plano somente eles dois,\n passar pro painel e enviar cotação na amil alegando que é o melhor cenário a eles....\n hospital de preferencia é a maternidade \n\nKa enviar cotação eles dois na Amil', '2024-05-08 17:39:25');
