INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CHRISTIAN ALBERTO HINDERBERGER CARDOSO DE ALMEIDA', NULL, '(11)99219-8621', NULL, NULL, 'Nao atendeu, enviei wpp \n\n[11:46, 01/08/2022] Jaqueline Gois: Olá Christian, bom dia. \n\nBoa semana! É a Jaqueline do plano de saúde da Porto. Como vai ?\n[11:48, 01/08/2022] Jaqueline Gois: Passando por aqui para checar se o PDF abriu certinho pro Sr. ver o\n valor que ficaria para seu grupo familiar na porto... Se ficou bacana, me da um retorno Christian se\n conseguiu ver e o que achou... ?', '2022-08-01 11:48:49');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CHRISTIAN ALBERTO HINDERBERGER CARDOSO DE ALMEIDA', NULL, '(11)99219-8621', NULL, NULL, 'Não atendeu', '2022-08-08 14:15:11');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CHRISTIAN ALBERTO HINDERBERGER CARDOSO DE ALMEIDA', NULL, '(11)99219-8621', NULL, NULL, 'Não atendeu', '2022-08-15 17:16:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CHRISTIAN ALBERTO HINDERBERGER CARDOSO DE ALMEIDA', NULL, '(11)99219-8621', NULL, NULL, 'Olá Jaqueline td bem? Obrigado pela proposta e já revisei\r\nNo momento não vou alterar meu plano até final de janeiro 2023\r\nVoltamos a falar no início do ano \r\n\r\nperguntei \r\n\r\nEntendi Sr. Christian. Obrigada pelo retorno. \r\n\r\nNão ficou bacana pra vocês já fazerem ? Estão tratando algum problema de saúde algo do tipo ? \r\n\r\nPergunto só para justificar a Porto ok, não quero ser invasiva. E de qualquer forma agendei aqui para retornar\r\n ao Sr. em Jan tabom, depois do dia 15.\r\n\r\nnem chegou pq ele deu blok  \r\n11 99219-8621 esse numero', '2023-01-18 10:30:00');
