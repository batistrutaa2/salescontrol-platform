INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'LUCILAINE DE OLIVEIRA', '19070222876', '(11) 3807-1736', '(11) 95104-4888', '(11) 97616-4561', 'CLIENTE TENTOU EFETUAR A TROCA PARA A PORTO SEGURO E NÃO CONSEGUIU POIS NÃO HAVERIA A POSSIBILIDADE DA TERCEIRA PESSOA PARA O PLANO. EU VENDO A SITUAÇÃO, SIMULEI AMIL E GNDI E ENVIEI MESMO ASSIM, AGORA AGUARDAR UM POSICIONAMENTO DELA OU RETORNAREI.', '2022-09-13 16:04:04');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'LUCILAINE DE OLIVEIRA', '19070222876', '(11) 3807-1736', '(11) 95104-4888', '(11) 97616-4561', 'MANDEI UMA COTAÇÃO E A CLIENTE SE INTERESSOU, ESTAMOS FAZENDO UMA NEGOCIAÇÃO POR WHATSAPP. KAIQUE ACOMPANHANDO TUDO.', '2022-09-13 16:55:20');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'LUCILAINE DE OLIVEIRA', '19070222876', '(11) 3807-1736', '(11) 95104-4888', '(11) 97616-4561', 'CLIENTE DEU BAIXA NO CNPJ HÁ ALGUNS ANOS ATRÁS. NÃO HÁ POSSIBILIDADE DA TERCEIRA VIDA. \nELA TAMBÉM FAZ TRATAMENTO DO CÂNCER E AINDA NÃO TEVE ALTA.\nNÃO GOSTOU DA PROPOSTA, E TENTAMOS TAMBÉM PF E QUALICORP, MAS NÃO CONSEGUIMOS ALGO QUE SEJA BOM.', '2022-09-14 10:33:45');
