INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'RENATA NIDALCHICHI DE ALMEIDA', '05461217648', NULL, NULL, NULL, '(11) 98134-3032 Em contato com cliente, a mesma informa que seu filho nasceu prematuro ao extremo\nde 24 semanas. O mesmo se alimenta por uma sonda e precisa do home care, ela só conseguiu o benefício\natravés de uma ação judicial, onde não pode fazer mas nenhuma alteração dentro da sulamérica. \nTem interesse em migrar, porém não compensa alteração onde ela perca esse benefício conseguido judicialmente\nPassado para o Kaique, onde por enquanto vamos deixar esse cliente de lado!', '2024-01-11 10:07:58');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROGERIO RUSSI BLOIS', '11563134810', NULL, NULL, NULL, '(11) 99609-3069 Em contato com cliente, o mesmo informa que precisa falar com seu contador para\nsaber sobre proposta, questionei sobre seu plano, o mesmo informa estar na qualicorp \nContornei objeção e falei sobre a Amil e demais, o mesmo disse que tem mais pessoas em seu plano e que \nseu contador quem tem as informações \n\nCombinei de retornar em breve e enviei uma mensagem em seu whats com uma simulação da Amil\nRetornar em breve !', '2024-01-11 09:55:41');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROGERIO RUSSI BLOIS', '11563134810', NULL, NULL, NULL, '(11) 99609-3069  Em tentativa de retorno, cliente informa não ter interesse', '2024-04-10 10:06:23');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROGERIO STIVAL MORGADO', '18279206884', NULL, NULL, NULL, '(11) 97107-3529 -  contato com cliente como Porto Seguro , o mesmo informa que não pode mexer\npois seu filho faz utilizações. Tentado contornar objeção o mesmo permanece dizendo que não pode mexer\nem seu plano .', '2024-01-11 09:41:09');
