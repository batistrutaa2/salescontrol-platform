INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'AMERICO M CRAVEIRO', '76525341868', '1131011141', '61996474453', '61996730063', '011964735198 Em contato com Americo, cliente aceita receber via email proposta\nAmil Saúde S750 no email : americocraveiro@uol.com.br \n\nEnviado ao mesmo, sanou dúvidas sobre plano empresarial, disse que teve uma experiência\nruim no mesmo modo de contratação, por isso voltou ao plano físico \n\nEnviada proposta com custo muito mais acessível, irei fazer o retorno para saber a opinião do cliente\nRetornar com argumentos para levar ao fechamento!', '2023-03-15 12:02:21');
