INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LEANDRA STEINMETZ', '14773412852', '11991872290', '11991872290', NULL, '(11) 9918-72290 Em contato com cliente , a mesma solicita retorno depois do dia 15 . \nInforma que o assunto é de seu interesse mas está sem tempo até essa data, retornar \nNa semana do dia 15 a cliente para abordar novamente as duas propostas enviadas . \nTanto porto seguro quanto Bradesco ficaram atrativas!', '2023-05-11 14:28:03');
