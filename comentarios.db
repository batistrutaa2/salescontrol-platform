INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'JAIME AUGUSTO DA SILVA', '24563638846', '1158442468', '11980415125', '11996761680', 'Em conversa com Jaime o mesmo disse que fez uma redução com a Qualicorp e passou pagar 7.200, então \ncomecei explicar para jaime sobre os reajustes e beneficios e o mesmo disse que vai aguardar e pediu que \nretornasse próximo a junho', '2024-01-30 17:04:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'JAIME AUGUSTO DA SILVA', '24563638846', '1158442468', '11980415125', '11996761680', 'Jaime foi para a Prevent Senior e não tem interesse', '2024-07-02 11:43:59');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'JANAINA FERREIRA LUCIN TEODOROV', '29878465845', '(11) 3155-0204', '(11) 9768-03604', '(11) 9915-71912', '9768-03604 - TELEFONE DO MARIDO	9915-71912 - TELEFONE DE JANAINA\nEm conversa com Janaina a mesma foi afavél e pediu que lhe enviasse um estudo incluindo a vida de seu \nmarido(45) alem das vidas de sua apolice, que atualmente é da sulamerica na categoria especial 100 com duas\n vidas de 42/12, janaina também informou que é do ABC.', '2023-06-02 10:14:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'JANAINA FERREIRA LUCIN TEODOROV', '29878465845', '(11) 3155-0204', '(11) 9768-03604', '(11) 9915-71912', 'Cotação enviada para a cliente atravès do Whatsapp, retornar segunda feira para conversar sobre o produto', '2023-06-02 10:15:22');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'JANAINA FERREIRA LUCIN TEODOROV', '29878465845', '(11) 3155-0204', '(11) 9768-03604', '(11) 9915-71912', 'Caique conversou com Janaina e a mesma demonstrou interesse pelo produto porém pediu uma cotação sem o \nmarido para analisar e conversar com ele.\nRetornar entre hoje ou amanhã.', '2023-06-13 11:23:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'JANAINA FERREIRA LUCIN TEODOROV', '29878465845', '(11) 3155-0204', '(11) 9768-03604', '(11) 9915-71912', 'Cliente estava entrando em reunião. Pediu retorno parte da tarde.', '2023-06-14 11:03:48');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'JANAINA FERREIRA LUCIN TEODOROV', '29878465845', '(11) 3155-0204', '(11) 9768-03604', '(11) 9915-71912', 'Leandro entrou em contato com Janaina e a mesma informou estar aguardando o retorno de seu marido que esta \nem viagem, ja que le é quem possui um CNPJ e o mesmo não possui plano de saúde. Estão aguardando para \nconversar e verificar se é viavel a troca do plano.', '2023-06-29 16:25:47');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'JANAINA FERREIRA LUCIN TEODOROV', '29878465845', '(11) 3155-0204', '(11) 9768-03604', '(11) 9915-71912', 'em contato, solicitou retorno em outro instante.', '2023-07-11 16:16:45');
