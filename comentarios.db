INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROBERTA CAPPELLANO', '6306435808', '1138492023', '11952008222', '11998905958', 'PESQUISA  06-03-2023\r\n\r\nAFAVEL 951735463 - TELEFONE DELA CLIENTE NÃO PAGOU O PLANO EM JUNHO, E FOI ACERTAR EM NOVEMBRO. FALARAM QUE ESTAVA CANCELADO. PASSOU ESSE TEMPO TODO SEM PLANO E AGORA TEM INTERESSE EM FAZER UM NOVO. INFORMAÇÕES ATRAVÉS DE UMA CONVERSA COM A CLIENTE, E NÃO POR PESQUISA QUALICORP. CLIENTE NÃO POSSUI BENEFICIO NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-09 10:21:38');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROBERTA CAPPELLANO', '6306435808', '1138492023', '11952008222', '11998905958', '11-951735463 Em contato com Roberta, cliente aceita receber proposta Porto Seguro \nA mesma informa ter um sobrinho de 14 para incluir na cotação, alega estar sem plano\natualmente e se interessa muito pelo produto Ouro Max. \n\nA mesma está com a empresa inapta e precisa rever a abertura de uma nova empresa para \nvincular ao plano, sana dúvidas sobre carências e pede um retorno na segunda-feira para\ntratarmos sobre o assunto . \n\nCotação enviada em seu whatsapp e retornarei na segunda-feira para ir ao fechamento com a cliente!', '2023-03-09 17:36:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROBERTA CAPPELLANO', '6306435808', '1138492023', '11952008222', '11998905958', '11-951735463 Em contato com Roberta, a mesma informa que ainda não teve tempo de analisar\njuntamente com a sua filha, solicita retorno na próxima semana para ter o tempo de tratar com a sua filha\nirei retornar!', '2023-03-17 14:54:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROBERTA CAPPELLANO', '6306435808', '1138492023', '11952008222', '11998905958', '11-951735463 Em contato com Roberta, a mesma informa que está muito corrido seu tempo\nMe falou que momentaneamente não conseguirá dar atenção devida a essa questão \n\nMas que tem certeza que irá migrar e será comigo, irei manter o contato com a mesma para que \nela faça essa troca\nRetornar em 15 dias para verificar como estamos em questão do tempo .\n\nAbordar que a cada mês que ela permanece no seu plano atual são valores que ela deixa de economizar!', '2023-03-23 16:10:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROBERTA CAPPELLANO', '6306435808', '1138492023', '11952008222', '11998905958', '11-951735463 Em contato com cliente, a mesma passou que por ser somente uma vida não quer\nmudar para plano empresarial pela redução dos custos. Tentei contornar a objeção falando dos benefícios\nda Omint, porém a mesma permaneceu sem interesse. \nRetornar após o reajuste!', '2023-05-11 14:29:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROBERTA CAPPELLANO', '6306435808', '1138492023', '11952008222', '11998905958', '11-951735463 Em contato com cliente, a mesma solicita retorno para amanhã\r\nRetornar!', '2023-07-18 11:15:12');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROBERTA CAPPELLANO', '6306435808', '1138492023', '11952008222', '11998905958', '11-951735463  Reenviada cotação a cliente da Bradesco, a mesma informa que futuramente iria\ntratar sobre a transição, solicitou reenvio para ficarmos no radar da mesma', '2023-09-20 15:59:45');
