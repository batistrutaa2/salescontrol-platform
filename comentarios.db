INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'JANAINA FERREIRA LUCIN TEODOROV', '29878465845', '(11) 3155-0204', '(11) 9768-03604', '(11) 9915-71912', 'Janaina disse que não visualizou ainda pois é algo complexo, a empresa arca com os custos então precisa \napresentar para eles primeiro e também verificar com o marido se ele esta disposto a ingressar junto nesta apólice', '2024-03-13 16:02:05');
