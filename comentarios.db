INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'CRISTIANE DI MARCO FERREIRA', '16778817801', NULL, '11981690912', '11983050713', 'CLIENTE AFÁVEL NÃO ESTÁ COM NENHUM PROBLEMA COM UTILIZAÇÃO NEM REEMBOLSO. ESTÁ APENAS ACHANDO O VALOR ALTO. E CONFORME FUI EXPLICANDO O REAJUSTE, ELA MESMO FALOU QUE ESTA QUERENDO FAZER UM ESTUDO NO MERCADO PARA ENTENDER MELHOR OS VALORES QUE É POSSIVEL PAGAR. EXPLIQUEI QUE IRÃO RETORNAR O CONTATO COM UMA SOLUÇÃO DENTRO DA SULAMERICA E CASO ELES NÃO POSSAM FAZER ALGO PARA MELHORAR, RECEBERÁ RETORNO DE OUTRAS SEGURADORAS. CLIENTE NÃO POSSUI BENEFICIO NA PORTO SEGURO. CLIENTE NÃO POSSUI EMPRESA ABERTA - ASSERTIVA. 11981690912 - Retornar em outro momento.', '2023-07-31 10:35:53');
