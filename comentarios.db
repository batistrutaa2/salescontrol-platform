INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ANTONIO FERREIRA APOLONIA', '59124350834', NULL, '11991146960', NULL, 'CLIENTE AFAVEL MAS MUITO ANALITICO - UM POUCO RECEIOSO.\nELE ESTÁ COM PROBLEMAS EM REEMBOLSO, SOLICITOU HÁ MAIS DE 2 MESES E NAO RECEBEU UMA CIRURGIA.\nAPOS FALAR QUE AMANHÃ IRIAM ENTRAR EM CONTATO, ELE DISSE QUE NAO QUER TROCAR E NEM OUVIR\nOUTRAS OPÇÕES, ELE SÓ QUER SE FOR ATUALIZAR DENTRO DA SULAMERICA.\n\nCLIENTE POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-13 17:36:14');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ANTONIO FERREIRA APOLONIA', '59124350834', NULL, '11991146960', NULL, 'mandei uma msg para a Sra. ligia pois como tratava com ela, ja vim com opção de fazer sula pra sula', '2023-03-14 11:28:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ANTONIO FERREIRA APOLONIA', '59124350834', NULL, '11991146960', NULL, 'em contato com ele, abordei ser plano de saude ele ja cortou falou que nao queria \ncontatei ela no whats, Sra ligia, falei sobre plano na sula msm duas vidas, que fiz pra um cliente e deu certo e tal ela disse \nMeu marido está fazendo quimioterapia \nNo momento não vamos mexer no plano de saúde \nGrata', '2023-04-03 14:24:14');
