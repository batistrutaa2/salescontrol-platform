INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEANDRO ALVES FREITAS DOS SANTOS', 'ROBIN ALAN ZEGER', '4918663800', '11976103672', '11976288207', '1138250280', 'Em contato com esposa Ivany, a mesma disse que está muito ocupada, retornar na próxima semana com argumentos de fechamento .', '2022-06-13 10:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEANDRO ALVES FREITAS DOS SANTOS', 'ROBIN ALAN ZEGER', '4918663800', '11976103672', '11976288207', '1138250280', '11 99133-2018 - Em contato com Ivany, cliente não quis falar e alegou que iria retornar, cliente esfriou. Tentar contato com esposo Robin para trazer interesse de volta e ir ao fechamento. Tentar marcar reunião!!', '2022-06-21 10:49:11');
