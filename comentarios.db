INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'LUCIANE CRISTINA L PISANELLI', NULL, '(11)99637-4066', '(11)2097-7261', NULL, 'consultei e cliente ta na porto pme desde 03/2022 ligar daqui dps prox do reajuste oferecer ou sula ou brad', '2022-02-02 10:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'LUCIANE CRISTINA L PISANELLI', NULL, '(11)99637-4066', '(11)2097-7261', NULL, '(11) 9963-74066 - Em contato com ela, não podia falar, pediu pra ligar ao fim da tarde', '2022-07-04 17:45:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'LUCIANE CRISTINA L PISANELLI', NULL, '(11)99637-4066', '(11)2097-7261', NULL, 'não atendeu', '2022-07-04 18:09:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'LUCIANE CRISTINA L PISANELLI', NULL, '(11)99637-4066', '(11)2097-7261', NULL, 'Em contato com ela, bem receptiva, informou que esta na porto que tem um plano Top reembolso quase 400\n reais, diamante tem tudo, nao sabe quanto paga e nao sabe se é por CNPJ, informei que a sula ta bem\n interessada em ter ela de volta, que qnd reajustar o porto ela ja tem opção. Ela disse mto a questão do \ncusto, que gostava mto da sula, eu disse que se tivesse endereço interior dava pra abrir empresa e tal \nconsegui explicar bem como funcionava. E salientei, que a sula quer trazer ela de volta e pra ela checar com \no marido o valor que ta o porto e se o CNPJ é SP. Vou mandar pra ela valor de sp e praia grande e ver tb itu o \nsogro dela tem casa', '2022-07-11 16:45:27');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'LUCIANE CRISTINA L PISANELLI', NULL, '(11)99637-4066', '(11)2097-7261', NULL, '(11) 9963-74066 - nao atendeu', '2023-01-10 14:51:50');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'LUCIANE CRISTINA L PISANELLI', NULL, '(11)99637-4066', '(11)2097-7261', NULL, 'nao atendeu, mandei isso: \n\nOlá Luciane, boa tarde! Tudo bom ?? \n\nNos falamos no passado a respeito de uma proposta da Sul América para retorno de vocês a companhia... Passando para checar se o Porto Seguro de vocês já reajustou e se agora seria o momento de quem sabe retomarmos este assunto.', '2023-04-11 17:21:21');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'MARIA FRANCISCA ANTONIA ROMANO VICTORINO DA SILVA', NULL, '(11)99946-4914', NULL, NULL, 'Em contato com esta abençoada, disse olha bemnao tenho nada da Bradesco Saúde e desligou na cara. Vou ligar semana que vem informando que sou da qualicorp', '2022-06-15 10:00:00');
