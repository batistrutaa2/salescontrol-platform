INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'PEDRO HENRIQUE MENEZES TAKIUTI', '32754484809', '11989092616', '1139262895', NULL, 'Em contato com o cliente para conversar sobre a Porto. O mesmo informou que gostou do beneficio porem não deu preço, pois hoje eles se encontram na Bradesco pelo CNPJ do interior de SP - Garça\r\nCom essa informação precisamos optar pela SulAmérica Saúde pois somente esse produto corresponde a tabela do interior de SP.\r\n\r\nEstou aguardando o Leonardo fazer a consulta de quanto exatamente o cliente esta pagando na Bradesco Saúde para fazermos o comparativo e retomar com fechamento.', '2023-05-23 12:22:37');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'PEDRO HENRIQUE MENEZES TAKIUTI', '32754484809', '11989092616', '1139262895', NULL, 'CNPJ - 11.770.451/0001-24', '2023-05-23 12:24:41');
