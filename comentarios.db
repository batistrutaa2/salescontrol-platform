INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE CARLOS MISORELLI', '85861227853', '1141538277', '11999712547', NULL, '(11) 96067-8343 Em contato com Dr Carlos após falar com esposa, o mesmo passa que tem corretor a 20\nanos, e que não quer ouvir proposta de outro corretor. Alega que o mesmo ja esta trocando com o seu corretor\nEsposa também bem rude não quis tratar muito e passou que esposo trata cancer e assunto era com ele!\nCheguei a enviar cotação no whatsapp dela antes de conseguir contato com o titular', '2024-07-23 15:48:09');
