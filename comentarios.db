INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LEOPOLDO ROSSI AZEREDO TELO', NULL, '1198548-4648', NULL, NULL, '(11) 9854-84648 Em tentativa de retorno, telefone para contato está indisponível!', '2023-03-27 14:59:30');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LEOPOLDO ROSSI AZEREDO TELO', NULL, '1198548-4648', NULL, NULL, '(11) 9854-84648 Em contato com cliente, o mesmo se queixa que sofreu um reajuste de 30% \nAceita receber cotação da Bradesco saúde\nAbordado todos os assuntos em linha, o mesmo gostou dos valores, passou a idade da esposa, na mesma faixa etária que a sua. \nSanou dúvidas para a abertura da empresa e informou que irá avaliar com a esposa. \n\nRetornar para tentar marcar uma reunião e quem sabe abrir a empresa!', '2023-04-11 16:01:45');
