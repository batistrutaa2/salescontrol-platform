INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'VANIA PIANCA', '04928908899', NULL, '11999434799', '11999436495', '9994-34799 - Vania esta internada a 2 meses e tem alta quarta feira, na ligação expliquei que as seguradoras \nestão flexiveis na questão de patologia então Vania pediu que ligasse em 2 semanas para conversar com calma \npois ela ira usar homecare', '2023-06-22 11:21:36');
