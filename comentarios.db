INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'EDUARDO GOES NEVES', NULL, '(11)99998-4891', NULL, NULL, '(11) 9999-84891 - em contato com ele, consegui explicar quanto a movimentação, que o reajuste é menor\nque o vinculo é com a Bradesco, que é por CNPJ, que é o mesmo plano, passei valor. a esposa tem cnpj ele \ncomentou. Pediu pra enviar no wpp, bem bomzinho.', '2022-07-28 15:40:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'EDUARDO GOES NEVES', NULL, '(11)99998-4891', NULL, NULL, 'Nao atendeu, enviei wpp questionando se ele conseguiu ver, se o valor ficou bacana e se podíamos agendar\n uma reunião esta semana!', '2022-08-01 11:55:15');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'EDUARDO GOES NEVES', NULL, '(11)99998-4891', NULL, NULL, 'Em contato com ele, questionei quanto ao CNPJ, se ele estava abrindo, ele disse que ja enviou a documentação \npara a contabilidade e que esta indo. Questionou quanto a carência, pois a mulher fez uma cirurgia a 3 meses da \nretirada de um câncer no rim. Pedi a ele que preenchesse uma declaração de saúde para que pudéssemos \navaliar, ele falou que qlq coisa deixa a mulher na qualicorp e troca ele e os filhos. Vamos ver!', '2022-08-03 09:59:01');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'EDUARDO GOES NEVES', NULL, '(11)99998-4891', NULL, NULL, 'desconsiderar o registro abaixo, pois tabulei e refere-se a outro Eduardo ( como a indicação é em nome da esposa alinne eu acabei me confundindo e tabulando neste eduardo)', '2022-08-03 10:07:09');
