INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANDREA DORIA CONTE - ME', NULL, NULL, NULL, NULL, 'ANDREA DORIA CONTE - ME Cliente possui MEI em são paulo e empresas LTDA\nPorém custos não ficaram menores do que o atual\nTentar futuramente pós reajuste', '2024-02-21 11:51:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ASSIS CONSTRUCOES LTDA', NULL, NULL, NULL, NULL, '97.538.332/0001-66 Empresa de cuiabá, a mesma não teve reduções nos custos em nenhuma operadora\nconcorrente, mesmo cotando com coparticipação\nReajuste será no final do ano, retornar contato para tentar novamente!', '2024-02-21 11:33:25');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ASSIS PROCESSAMENTO DE DADOS LTDA', NULL, NULL, NULL, NULL, '(61) 98427-7151 Em contato com Silvia, a mesma informou que usa o hospital DF Star de Brasilia\nEmpresa do DF, porém apenas a sulamérica mantém atendimento nesse hospital e o custo não ficou acessível\nRetornar no próximo ano, depois do reajuste para tentar formalizar acordo!', '2024-02-21 11:50:25');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'BAITA ACELERADORA CONSULTORIA EM GE', NULL, NULL, NULL, NULL, 'Empresa de Campinas, houve bastante redução tanto na Amil  S2500 : R$ 16.865,50   \nComo também na Sulamérica R$ 16.860,42\nEm contato com titular oswaldo no numero : (19) 98114-4420\nO mesmo solicita retorno para amanhã no periodo da tarde para tratarmos sobre o assunto, pois estava em \nreunião \nRetornar', '2024-02-21 17:21:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'BAITA ACELERADORA CONSULTORIA EM GE', NULL, NULL, NULL, NULL, 'Empresa de Campinas, houve bastante redução tanto na Amil  S2500 : R$ 16.865,50   \r\nComo também na Sulamérica R$ 16.860,42\r\nEm contato com titular oswaldo no numero : (19) 98114-4420\r\nO mesmo solicita retorno para amanhã no periodo da tarde para tratarmos sobre o assunto, pois estava em \r\nreunião \r\nRetornar', '2024-02-21 17:22:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'BAITA ACELERADORA CONSULTORIA EM GE', NULL, NULL, NULL, NULL, '(19) 98114-4420 Em contato com Oswaldo, cliente aceita receber cotação via whatsapp da Amil One\nO mesmo informa que esposa faz tratamento de quimioterapia, passado todo esquema de portabilidade\no mesmo sanou diversas dúvidas, pediu apresentação da linha one e também da brazil \nEnviado o material em seu whatsapp, manter contato com o mesmo para apresentar alternativas e soluções\npara o custo benefício\nEsposa com pré-existente está no contrato social atual!', '2024-02-22 15:45:13');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'BAITA ACELERADORA CONSULTORIA EM GE', NULL, NULL, NULL, NULL, '(19) 98114-4420 Em contato com cliente, o mesmo solicitou retorno amanhã na parte da tarde!', '2024-05-14 15:53:39');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'BAITA ACELERADORA CONSULTORIA EM GE', NULL, NULL, NULL, NULL, '(19) 98114-4420 Em retorno com cliente, o mesmo pede nova ligação amanhã, pois está em reunião\nTabela de 3 vidas na Amil One 2500 reduziu para os dois idosos o valor de R$ 7.371,81 para cada. \n\nEntrar em contato novamente amanhã a tarde!', '2024-06-10 11:11:50');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'BAITA ACELERADORA CONSULTORIA EM GE', NULL, NULL, NULL, NULL, '(19) 98114-4420 Em retorno com cliente, o mesmo pede nova ligação amanhã, pois está em reunião\r\nTabela de 3 vidas na Amil One 2500 reduziu para os dois idosos o valor de R$ 7.371,81 para cada. \r\n\r\nEntrar em contato novamente amanhã a tarde!', '2024-06-10 11:12:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'BAITA ACELERADORA CONSULTORIA EM GE', NULL, NULL, NULL, NULL, '(19) 98114-4420 Em retorno com cliente, o mesmo informa que sogro está internado e ainda não teve tempo\nde analisar e conversar com o sócio. Informa que provavelmente próxima semana estará a disposição para tratar!\nRetornar na próxima semana com reforço no whatsapp e reenvio das cotações para um desfecho!\n\nUsar tabela de 3 vidas Amil One', '2024-06-26 14:20:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'BAITA ACELERADORA CONSULTORIA EM GE', NULL, NULL, NULL, NULL, '(19) 98114-4420  Em contato com cliente, marcado reunião virtual para quinta-feira as 15h00 \nRetornar o contato para fazermos a mesma!', '2024-07-02 11:29:55');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'BAITA ACELERADORA CONSULTORIA EM GE', NULL, NULL, NULL, NULL, '(19) 98114-4420 Leandro realizou reunião com o mesmo, sanou diversas dúvidas e questões, o mesmo\npediu referências sobre a Portabilidade com nossos clientes, apresentação do produto Amil One e novas cotações\nEnviada ao mesmo e na próxima semana chegar ao desfecho das referências da portabilidade para o ingresso\ncom a transição de seu plano', '2024-07-04 16:46:53');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'BAITA ACELERADORA CONSULTORIA EM GE', NULL, NULL, NULL, NULL, '(19) 98114-4420  Em contato, cliente informa que esta resolvendo algumas questões familiares e pede \npara nos retornarmos próximo ao dia 20 para o tema ser abordado novamente!', '2024-08-07 17:05:25');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'BALLET CARLA PEROTTI LTDA', NULL, NULL, NULL, NULL, '(11) 98558-4920 - Em contato com Sabrina, cliente informa que está querendo mesmo migrar pois\nestá se separando e vai trocar o plano. \nEnviado Porto Seguro Ouro Max, que reduziu para : R$ 4.890,79*\nA mesma questionou quais documentos precisaria, enviado o chek-list, acompanhar ao fechamento', '2024-02-21 14:37:55');
