INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCIO MASSAMICHI NAGAO', '54445558672', '1238671166', '11999462791', NULL, '(11) 99962-2311- SÓ FEZ QUEIXAS SOBRE VALOR, QUE ESTÁ BEM FORA DO CERTO. TEM DIABETE, MAS É PRECISO ENTENDER MELHOR, USA 2 REMEDIOS QUE ELE PAGA DO BOLSO. JA ESTA CONVERSANDO COM OUTRAS ASSESSORIAS, E PRECISA DE UM CORRETOR PRA AUXILIAR. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLEINTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-02-01 14:06:59');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCIO MASSAMICHI NAGAO', '54445558672', '1238671166', '11999462791', NULL, '(11) 99962-2311-  Em contato com cliente, o mesmo aceita receber cotações Amil saúde \ne também cita Unimed Sorocaba\nEnviada cotação com os dois participantes descritos, o mesmo está residindo em Sorocaba e \ntambém frequenta São Paulo, cita atendimento regional. \nO mesmo possui empresa ativa, e fala em troca após o carnaval, enviada um email no: \nlucio_nagao@hotmail.com\n\nRetornar após o carnaval com argumentos de fechamento para uma troca, cliente interessado\nCusto ficou acessível pelo mesmo benefício \nPossuí sócio, tentar trazê-lo.', '2023-02-07 11:17:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCIO MASSAMICHI NAGAO', '54445558672', '1238671166', '11999462791', NULL, '(11) 99962-2311 Em contato com Lucio, cliente informa que ainda não teve tempo de \nvisualizar proposta. Solicito que o mesmo compare e analise esse final de semana! \nRetornar na próxima semana para sanar dúvidas e falar sobre o fechamento.', '2023-02-10 17:01:11');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCIO MASSAMICHI NAGAO', '54445558672', '1238671166', '11999462791', NULL, '(11) 99962-2311 O mesmo pede retorno amanhã as 09h', '2023-02-23 15:56:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCIO MASSAMICHI NAGAO', '54445558672', '1238671166', '11999462791', NULL, '(11) 99962-2311 Kaique passou email do cliente a contadora Patricia \nLucio cliente havia pedido as informações sobre a abertura de empresa e apresentação \nda contabilidade em seu e-mail: lucio_nagao@hotmail.com \nRetornar para tratar sobre a abertura da empresa e fechamento de seu novo plano.', '2023-03-01 15:33:46');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCIO MASSAMICHI NAGAO', '54445558672', '1238671166', '11999462791', NULL, '(11) 99962-2311 Em contato com esse abençoado, cliente fala que ligou na qualicorp\ne mandou a documentação para troca do plano a eles\nO mesmo informou que queria migrar para a unimed usando a empresa e que dessa forma\neles iriam fazer a troca por la mesmo \n\nAcabei com a alma dele e desliguei o contato!', '2023-03-21 17:02:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCIO MASSAMICHI NAGAO', '54445558672', '1238671166', '11999462791', NULL, '(11) 99962-2311 O mesmo informa que está na unimed sorocaba com outra corretora!', '2024-01-09 15:55:12');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'REGINA DE OLIVEIRA CANDELORO', '29000846870', '1138072622', '11996588809', NULL, 'CLIENTE COMENTOU QUE O MARIDO ESTÁ COM PROBLEMAS COM UTILIZAÇÃO, MAS É OUTRO CONTRATO. E POR CONTA DISTO, ELA ESTA COM RECEIO DE USAR, MESMO NÃO USANDO A ANOS. ESTÁ DISPOSTA A OUVIR OPÇÕES. NÃO RECLAMOU DE VALOR OU BENEFICIO. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-02-01 14:08:22');
