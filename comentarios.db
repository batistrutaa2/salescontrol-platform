INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'DIRLEY BARRETO DE CERQUEIRA', '92216285587', '71981298458', '71981938558', '71981976230', 'em contato com ele. disse que tem uma liminar pra sair dia 30. que ele em si já tem uma corretora tb da Bradesco \ne que a sula vai ficar 3.300. menor que o Bradesco. fiquei de retornar na primeira semana do mes que vem pra \nsaber que que deu', '2022-09-21 10:26:05');
