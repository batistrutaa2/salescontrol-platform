INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'CELIA ANTONIA XAVIER DE MORAES', '06648927879', '1138322535', '11999464265', '11944855055', 'Em contato, cliente informou que não vai permanecer na Qualicorp. Vai mudar para Porto ou Amil. Irei enviar as alternativas que mencionei por telefone e iremos marcar reunião para a próxima semana.\r\nCliente esta pagando por volta de 9 mil reais.', '2023-07-21 12:08:23');
