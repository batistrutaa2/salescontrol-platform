INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'EDUARDO PEREIRA L FILHO', NULL, NULL, '(11)99689-4149', '(11)4617-3935', 'Em contato no celular, me identifiquei como quali porque nao achei nada de informação dele, porem ele falou\n que ta pensando em fazer um plano empresarial, falei que nas idades a melhor é bradesco porem ter vidas,\n ele passou idade do filho de 30 pra cotar, e disse que a esposa marcia tem cnpj, mandei cota~çao no email \nvamos ver', '2022-07-12 17:58:10');
