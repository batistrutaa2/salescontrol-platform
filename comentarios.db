INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'Jose Urquiza Terra Nogueira', '05375905876', '11985554250', NULL, NULL, 'Esta no Rio de Janeiro e quando voltar irá entrar em contato.', '2023-07-18 15:52:09');
