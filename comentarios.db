INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'SUELY I TAKAMATSU', '15472788897', '1142241153', '11988634143', '11988323887', 'TELEFONE 2 AFAVEL POREM EXTREMAMENTE OBJETIVA. POUCAS PALAVRAS. CLIENTE NÃO TINHA NADA PRA FALAR SOBRE O PLANO, UTILIZAÇÃO TUDO CERTO. ME PERGUNTOU SE EU PODERIA FALAR SOBRE PLANOS, EXPLIQUEI QUE EU SOU APENAS DA PESQUISA, MAS VOU ENCAMINHAR O CONTATO DELE PARA UM DOS CORRETORES. ELA DISSE QUE QUER REDUZIR O CUSTO, QUE ESTÁ MUITO CARO. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-05-31 16:20:14');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'SUELY I TAKAMATSU', '15472788897', '1142241153', '11988634143', '11988323887', 'CLIENTE ESTA EM TRATAMENTO DE CANCER DE MAMA', '2023-06-01 11:24:46');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'SUELY I TAKAMATSU', '15472788897', '1142241153', '11988634143', '11988323887', 'EM NOVO CONTATO COM A CLIENTE A MESMA AINDA SE MOSTRA INTERESSADA NA TROCA PORÉM AINDA ESTA EM TRATAMENTO DE CANCER DE MAMA, SEGUNDO ELA JÁ FINALIZANDO, EXPLIQUEI SOBRE PORTABILIDADE, EXPLIQUEI SOBRE A ABERTURA DO CNPJ PORÉM PRA REALIZAR A PORTABILIDADE ELA NÃO TEM NENHUMA OUTRA VIDA PARA INDICAR, MAS IREI DE TODA FORMA ENVIAR NOVAMENTE O ESTUDO E BUSCAR UMA SAIDA', '2023-12-04 10:53:25');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'SUELY I TAKAMATSU', '15472788897', '1142241153', '11988634143', '11988323887', 'TENTATIVA DE CTT SEM SUCESSO', '2024-01-17 11:21:26');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'MARIANNA FRANCISCA M MONTEIRO', '93780931834', '1137428013', '24993268965', '11985208430', 'CLIENTE AFÁVEL. ELA ESTÁ COM MUITA DIFICULDADE EM PAGAR O PLANO QUE ESTÁ COM UM VALOR MUITO ALTO. EM TERMOS DE UTILIZAÇÕES NÃO TEM PROBLEMA ALGUM, MAS SÓ FALAVA DE VALOR VALOR E VALOR. ESTÁ ESPERANDO POR UM RETORNO PARA REDUÇÃO DE CUSTO. CLIENTE POSSUI SEGURO AUTO NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA. 11985208430- Retornar em outro momento.', '2023-05-31 16:23:06');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'MARIANNA FRANCISCA M MONTEIRO', '93780931834', '1137428013', '24993268965', '11985208430', 'TEM PORTO,\nCAIXA POSTAL', '2023-05-31 17:00:01');
