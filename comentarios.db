INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'OLGA MARIA DE A MEHLMANN', '11646544897', '11983812177', NULL, NULL, '11 5072-2727 Em contato com Fabio, cliente informa que valores pagos atualmente estão altos porém\nnão se interessa pelo plano empresarial, se demonstra bem insegura em relação ao tema, grupo familiar \ntem uma empresa baixada no nome e apesar de valores da Porto ficarem ótimos, o mesmo insistiu em receber\nproposta de plano por adesão. \n\nEnviado no email fabio_abrantes@hotmail.com três propostas, com Bradesco, Porto e  Ampla saúde\n\nCliente disse que iria avaliar junto a família e solicitou retorno, retornar em breve!', '2024-05-08 11:05:26');
