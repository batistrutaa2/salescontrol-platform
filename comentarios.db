INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'VLADIMIR TONELLO DE VASCONCELOS', '28291475881', '(28) 2914-75881', NULL, NULL, 'Acabou de fazer Bradesco pela empresa do pai, idades 69 – 67 ele de 45 esposa de 42 e duas filhas menores de 18, é somente hospitalar e disse que faz 3 meses que fizeram. Enviar cotação Kaique como porto só pra ele \nSaber o valor', '2024-05-08 16:49:03');
