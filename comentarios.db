INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ORLANDO SANDI MAGALHAES', '2837325805', '(11) 5547-0929', '(11) 99998-6164', '(11) 99978-3932', '(11) 9999-86164 Enviada mensagem no whats referente a cotação!', '2024-08-01 16:41:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PAULA RODRIGUES', ' 10641121881', '1143180048', '11996679067', NULL, 'SUPER AFAVEL. CLIENTE ESTÁ MUITO DESCONTENTE COM O PLANO. VALOR ALTO, DESCREDENCIAMENTOS... GOSTARIA DE USAR SÃO LUIS, MAS ACHO DIFICIL POR CONTA DA CATEGORIA QUE HOJE ELA SE ENCONTRA. ELA É PSICOLOGA, E NA CONVERSA FALOU QUE A AMIL É UM LIXO, PORQUE NÃO PAGAM OS PROFISSIONAIS. ENTÃO TALVEZ FALAR DE AMIL COM ELA, PODE SER ALGO NEGATIVO. ESTÁ ESPERANDO PELA LIGAÇÃO COM SOLUÇÃO. CLIENTE NÃO POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE NÃO POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-02-13 10:12:33');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PAULA RODRIGUES', ' 10641121881', '1143180048', '11996679067', NULL, 'Em contato com Paula, passado a proposta da Bradesco saúde empresarial\napesar de ter ficado muito atrativo o custo, cliente foi firme e disse que não tem nenhum \ninteresse no plano empresarial seja com a Bradesco ou com qualquer outra operadora\nTentei contornar a objeção e a  cliente reforçou dizendo que prefere ficar no seu plano atual do \nque migrar para outro plano empresarial', '2023-02-13 11:57:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'PAULA RODRIGUES', ' 10641121881', '1143180048', '11996679067', NULL, '(11) 9966-79067 Em contato com cliente, a mesma disse que saiu da qualicorp e está em um plano\nsem custo por empresa CLT \nTentei pegar contatos de pessoas próximas, a mesma disse que não tem indicações.', '2024-01-09 14:15:21');
