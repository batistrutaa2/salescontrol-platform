INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'RICARDO ANTONIO LOUREIRO VELOSO', '78405211853', '13997034129', NULL, NULL, 'informou que o plano dele é 3.400, que não ta achanado vantagem ir pra um de um plano da Unimed que nao \ntem coparticipação, para um da bradesco que tem, que ta apertado agr pra subir esse valor. Porem \nbradesco é nacional, expliquei os atenimentos que ele ganharia, expliquei tudo, pra ele, o que pega o é \ncusto que sobe, nao o benf, ele quer algo nacional pelo mesmo preço. Porem o dele é regional nao da', '2022-07-25 13:55:16');
