INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIO BARONNI', '18790666887', '8738359057', '11996268306', '11982897661', '(11) 9962-68306 Em contato com cliente, o mesmo aceita receber proposta da Amil One Executivo \n\nO mesmo paga atualmente : R$ 37.582,66   Solicita cotação no email: manuelvitorsantos@bol.com.br\nEnviado amil One S1500 e S2500 , pode ser também apresentado o S6500 Black\n\nSolicitou retorno na próxima semana, retornarei o contato para saber a opinião do mesmo!', '2023-07-20 14:36:18');
