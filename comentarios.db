INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LILIAN HISSAE N DE LIMA', '06115967848', '1145147552', '11998348015', NULL, '(11) 99834-8015 Em contato com cliente, a mesma aceita receber proposta da Amil S580 com copar\nA mesma está pagando em média R$ 3.500,00 atualmente, sofrerá o seu reajuste no próximo mês\n\nCliente havia encerrado seu MEI, porém poderá ser reutilizado caso a mesma o abra novamente!', '2023-06-22 14:05:05');
