INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIA ROSELI ZANUTTO', '10750526882', '1141259069', '11995046593', '11999983902', 'FOI FEITO A PESQUISA NO ANO PASSADO COM A CLIENTE, E TENTEI CONTATO POR DIVERSAS VEZES. ELA É AFAVEL, CONVERSA PELO TELEFONE, MAS PEDE PARA ENVIAR NO WHATSAPP, E O TELEFONE É DE UM PETSHOP, NO QUAL ELA É PROPRIETARIA. IDEAL JA LIGAR COMO SEGUNDO CONTATO FALANDO DA PESQUISA QUE PARTICIPOU NO FINAL DO ANO PASSADO. CLIENTE POSSUI SEGURO AUTO COM A PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-02-06 18:20:47');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIA ROSELI ZANUTTO', '10750526882', '1141259069', '11995046593', '11999983902', 'Em contato com CLaudia, a mesma responde de forma grossa e diz não querer trocar de plano\ninforma que ja esta resolvida com seu plano de saúde e desliga!', '2023-02-10 14:55:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'SENIR APARECIDA RAMALHO DE SOUSA', '91191815668', NULL, '11998297094', NULL, 'CLIENTE AFAVEL, GOSTA DE CONVERSAR. ESTÁ EXTREMAMENTE INSATISFEITA COM O VALOR PAGO, PROCEDIMENTOS QUE NAO PODE FAZER EM ALGUNS HOSPITAIS E LABORATORIOS. UTILIZA SÃO LUIS QUANDO PRECISA. TELEFONE 2 O DELA. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-02-06 18:21:29');
