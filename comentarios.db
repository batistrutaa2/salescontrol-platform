INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'CLAUDIA SILVA PERES', '22176058879', '1130790410', '11999886244', '11974714843', '(11) 9998-86244 Em contato com cliente\na mesma informa que seu esposo tem 53 anos e está no espcial 100 pela qualicorp \nEnviado Bradesco Qualicorp e Amil S2500 r2\nRetornar com argumentos de fechamento', '2022-09-26 11:41:06');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'CLAUDIA SILVA PERES', '22176058879', '1130790410', '11999886244', '11974714843', '11 98430-2222 - Em contato com esposo Rodrigo via whatsapp  .\nEnviado opções como Bradesco Saúde qualicorp e Amil One Health empresarial\ncliente informa que irá optar pelo Bradesco qualicorp e que irá fazer o envio dos docs.\nAguardando documentação para cobrar taxa de angariação!', '2022-10-03 11:48:22');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'CLAUDIA SILVA PERES', '22176058879', '1130790410', '11999886244', '11974714843', 'Fechamos plano individual para o esposo, a mesma não tem interesse em sair da sulamérica!', '2022-11-22 16:40:54');
