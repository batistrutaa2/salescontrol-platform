INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MARCUS AUGUSTUS GIANULLO', '81781610878', '(11) 2973-1583', '(11) 9991-95059', '(11) 9697-31583', 'Em conversa com Marcus ele decidiu aguardar um pouco pois esta aguardando liminar, informei para ele sobre os reajustes e as opções que temos então marcus ficou de retornar', '2023-10-09 17:11:38');
