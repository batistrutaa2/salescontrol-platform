INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ERTON RIVO BANCHER', '25541206847', '1147294526', '11999436789', '11996555643', '(11) 9965-55643 Fiz contato com provável esposa, a mesma disse que o Dr. Erton nesse numero só fala\ndepois das 20h. Não quis me passar mais informações!', '2024-05-29 13:14:55');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ERTON RIVO BANCHER', '25541206847', '1147294526', '11999436789', '11996555643', '(11) 9965-55643 Em contato com Ivone, a mesma aceita receber propostas para melhorias, alega que estava\nconversando com seu esposo realmente sobre a condição inviável do reajuste, a mesma fez acordo com a \nqualicorp e valores ja estão inviáveis novamente, cotações enviadas PORTO, AMIL E BRADESCO\nretornar contato em breve para um cal ou fechamento!', '2024-08-01 19:27:25');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MAXWEL CABRAL', '98647644700', '11996149966', '11941561900', NULL, 'Em contato com Max 11996149966 - Cliente se interessou nos produtos Ouro, agendada visita para hoje com Kaique, o mesmo fechou Ouro Mais e informou que irá separar os documentos para fazer o envio! Aguardando documentação.', '2022-06-23 11:06:04');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ALINE SCHROTER FUENTES', '21554513855', '11992346808', '11989175234', NULL, '(11) 9923-46808 - Em contato com Aline, negociação e propostas enviadas pelo whatsapp. Agendada reunião virtual juntamente com Kaique, reunião feita! Cliente gostou dos produtos e ficou de escolher entre opções da Porto Seguro Diamante ou SulAmérica executivo. Retornar com argumentos de fechamento a mesma!', '2022-06-23 11:12:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ALINE SCHROTER FUENTES', '21554513855', '11992346808', '11989175234', NULL, 'Em contato com Aline, cliente informa que gosta dos valores e solicita retorno \r\npara sexta-feira afim de passar valores ao seu esposo e conversarmos com o mesmo\r\nAgendado retorno, SulAmérica tombamento com valores exclusivos!', '2022-08-19 12:00:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ALINE SCHROTER FUENTES', '21554513855', '11992346808', '11989175234', NULL, 'Em contato semana passada, cliente solicita retorno para falarmos com seu esposo\nNas tentativas de retorno, telefone só chamou \nContinuar tentando contato com seu esposo Dimitrius', '2022-08-24 14:58:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ALINE SCHROTER FUENTES', '21554513855', '11992346808', '11989175234', NULL, 'Mantendo contato com Aline via whatsapp , cliente ficou de dar um retorno quanto \nao esposo aceitar a proposta projeto Sulamérica tombamento.', '2022-09-05 11:13:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ALINE SCHROTER FUENTES', '21554513855', '11992346808', '11989175234', NULL, 'Em contato através do Kaique, cliente informa que não tem interesse\nna utilização dos valores de Curitiba, alega que prefere ficar no seu próprio plano\ncom a Bradesco saúde\nTentar futuramente!', '2022-09-26 16:08:45');
