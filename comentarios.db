INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JULIO CESAR CESARINI', '16966768863', NULL, NULL, NULL, '(11) 99558-6450 Em contato com Julio, o mesmo se interessa pelo assunto e aceita receber proposta! \nCliente não possui CNPJ, porém seu esposo de 30 anos possui, como o seu esposo ja tem plano, ele \nsolicita uma categoria inferior da Amil para o marido e a ele S450A, pois ele utiliza o BP Mirante \n\nEnviada proposta e apresentação da BrazilHealth via whatsapp, e passado que o mesmo constando no registro\nou no contrato social, conseguimos vincular o plano com categorias diferentes. Retornar com argumentos de\nfechamento!', '2024-06-10 10:55:56');
