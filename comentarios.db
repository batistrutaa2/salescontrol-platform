INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA C A LAVIERI', '94148520859', NULL, NULL, NULL, '1199128-8414 Em contato com esposo José, o mesmo aceita receber pela esposa proposta de melhoria\njunto a Amil Saúde S750 R1 . Cliente alega não ter interesse em entrar na cotação, solicita somente para \nesposa e filho. \n\nApesar de não ter tido redução muito alta, retornar o contato para saber opinião do cliente!', '2023-09-20 14:52:10');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA C A LAVIERI', '94148520859', NULL, NULL, NULL, '1199128-8414 Em contato com o mesmo, informa que não teve tempo de fazer comparação\nEnviei nova mensagem no whats para que a proposta fique no seu radar, retornar em breve!', '2023-09-26 14:45:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA C A LAVIERI', '94148520859', NULL, NULL, NULL, '1199128-8414 Em contato com cliente novamente, abordado a transição\nsanado algumas dúvidas e receios, falado bastante sobre plano empresarial, questões da amil\nO mesmo pede novo retorno em breve, pois novamente iria abordar o tema com a família\nTentar marcar reunião!', '2023-10-10 16:26:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA C A LAVIERI', '94148520859', NULL, NULL, NULL, '1199128-8414 Em contato José, o mesmo informa que seu filho Carlos está precisando de uma consultoria\npois seu filho ( neto do josé ) saiu do plano da esposa e o mesmo está querendo agregar o filho ou verificar \ncomo está o mercado atualmente.\nCarlos\n11993633111', '2023-11-07 14:39:31');
