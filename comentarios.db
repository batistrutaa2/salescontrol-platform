INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA CLARA VOEGELI', '21934736848', NULL, NULL, NULL, 'Cliente padrão porto seguro, tentar contato\nPossui Porto Seguro, abordar como Porto \nPossui CNPJ \n(11) 99998-8596 Não pertence a cliente \n(11) 97623-4663 Só chamou', '2024-01-11 15:15:46');
