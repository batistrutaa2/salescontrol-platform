INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'GISELE MONTEIRO BARADEL', '28836386830', '1123387493', '11944686857', '11999336857', '9993-36857 - em contato com ela, disse pra enviar wpp, me identifiquei como da sul america e que tinhamos uma opção de um novo produto, no caso sompo', '2022-05-18 15:05:39');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'GISELE MONTEIRO BARADEL', '28836386830', '1123387493', '11944686857', '11999336857', 'Em contato com ela, não estava me respondendo mais, liguei, consegui falar. Questionei se havia analisado meu orçamento da Sompo, ela falou que sim porem que a Qualicorp fez uma proposta pra ela dentro do Adesão mesmo, que ela ta a anos na Sula e que não quer sair de jeito nenhum, falei filha, PME então. Mandei, sanei por wpp duvidas quanto a fidelidade e quanto a IR, que ela entendia que não dava pra restiuir. Não abordei taxa de angariação, pois quero primeiro ver se ela muda mesmo pro PME. Usei todos os argumentos para que ela vejaa vantagem na contratação pela sula e nao mais pela quali', '2022-06-06 12:33:55');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'GISELE MONTEIRO BARADEL', '28836386830', '1123387493', '11944686857', '11999336857', 'disse que fechou com a qualicorp mesmo que eles cobriram a oferta', '2022-07-13 11:00:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'GISELE MONTEIRO BARADEL', '28836386830', '1123387493', '11944686857', '11999336857', 'Cliente estava entrando em reunião, solicitou retorno após as 17:00 horas.', '2023-01-09 17:30:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'GISELE MONTEIRO BARADEL', '28836386830', '1123387493', '11944686857', '11999336857', 'SÓ CHAMOU.', '2023-02-14 11:41:04');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'GISELE MONTEIRO BARADEL', '28836386830', '1123387493', '11944686857', '11999336857', 'TELEFONE 3 \nCLIENTE BEM OBJETIVA E UM POUCO RISPIDA.\nELA FALOU QUE UNICO PROBLEMA QUE ELA TEM É COM O REEMBOLSO, QUE É BAIXO E QUE ESTA DEMORANDO\nRESTANTE TUDO OK, ATÉ MESMO O VALOR... "O QUE ESTOU PAGANDO ESTÁ TUDO BEM PARA MIM"\nNÃO DEIXOU EU FINALIZAR E DISSE "VOCÊ AINDA TEM PERGUNTAS? SE NÃO PRECISO DESLIGAR"\nAI FUI FINALIZAR DIZENDO QUE IRIAM ENTRAR EM CONTATO ELA SÓ DISSE: "TA TA TA" E DESLIGOU.\n\nCLIENTE POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-06-05 16:46:45');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'GISELE MONTEIRO BARADEL', '28836386830', '1123387493', '11944686857', '11999336857', 'Tentativa de contato, sem sucesso;', '2023-08-02 10:48:31');
