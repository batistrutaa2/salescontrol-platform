INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'FABIO ULHOA COELHO', '4755922801', '1131513616', '11963541112', '11985069980', '(11) 9850-69980 - Em contato com a Liandra, secretaria do Fabio. A mesma solicitou envio de Porto Diamante R2 por e-mail.\n\nE-mail:\nfabio@ulhoacoelho.com.br\nliandra@ulhoacoelho.com.br', '2022-07-13 14:54:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'FABIO ULHOA COELHO', '4755922801', '1131513616', '11963541112', '11985069980', 'Em contato com a Liandra, a mesma informou que passou a Proposta para o Dr. Fabio porém ainda não teve nenhum retorno.', '2022-07-28 14:03:40');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'FABIO ULHOA COELHO', '4755922801', '1131513616', '11963541112', '11985069980', 'Tentativa de contato, sem sucesso.', '2022-10-19 11:20:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'FABIO ULHOA COELHO', '4755922801', '1131513616', '11963541112', '11985069980', 'TELEFONE 3 - SECRETARIA LIANDRA.\nELA É AFAVEL. NÃO QUERIA CONVERSAR POIS ACHOU QUE IRIA FALAR SOBRE PLANO DE SAUDE. MAS AO \nEXPLICAR QUE SE TRATA DE UMA PESQUISA, ELA ME OUVIU E FALOU SOBRE O REEMBOLSO DELE QUE ESTÁ \nBAIXO, E ELE ESTÁ MUITO INSATISFEITO, HOJE ELE NÃO ESTÁ EM SÃO PAULO, MAS RETORNA EM BREVE.\nELA FALOU QUE ELE VEM FAZENDO ALGUMAS PESQUISAS E VIU QUE O BRADESCO TEM UM REEMBOLSO \nMELHOR, E O IDEAL É RETORNAR FALANDO QUE É DA BRADESCO.\nPONTO IMPORTANTE, FALAR QUE O CONTATO É REFERENTE A PESQUISA, POIS SE FALAR DIRETO DE PLANO\nDE SAUDE, ELA NÃO IRÁ QUERER FALAR.\n\nCLIENTE POSSUI DIVERSOS BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI DIVERSAS EMPRESAS ABERTAS - ASSERTIVA.', '2023-03-31 17:01:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'FABIO ULHOA COELHO', '4755922801', '1131513616', '11963541112', '11985069980', 'Em contato com a Liandra,  a mesma informou que já tentou apresentar ao cliente algumas vezes o beneficio, Mas o mesmo se encontra irredutivel.\nMesmo assim pediu e-mail com a Proposta. Irei encaminhar via e-mail:  liandra@ulhoacoelho.com.br', '2023-04-05 15:46:30');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'FABIO ULHOA COELHO', '4755922801', '1131513616', '11963541112', '11985069980', 'Tentativa de contato, sem sucesso.', '2024-01-18 15:44:19');
