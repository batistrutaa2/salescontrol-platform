INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ALESSANDRA B DE O L B R SANTOS', '07056491723', NULL, '11976169550', '11992861388', 'Em contato com ele, informou disse que queria apenas saber quem iria fazer a gestão do plano, informei que seria tudo com a própria porto seguro. Que retiraria a intermediação da Qualicorp e que o vinculo seria direto na operadora, que a nossa corretora faz apenas a movimentação mas boleto contrato tudo da porto mesmo. E', '2022-07-04 17:27:21');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ALESSANDRA B DE O L B R SANTOS', '07056491723', NULL, '11976169550', '11992861388', 'Em contato com ele, informou disse que queria apenas saber quem iria fazer a gestão do plano, informei que seria tudo com a própria porto seguro. Que retiraria a intermediação da Qualicorp e que o vinculo seria direto na operadora, que a nossa corretora faz apenas a movimentação mas boleto contrato tudo da porto mesmo. E', '2022-07-04 17:27:22');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ALESSANDRA B DE O L B R SANTOS', '07056491723', NULL, '11976169550', '11992861388', 'Em contato com ele, informou disse que queria apenas saber quem iria fazer a gestão do plano,\n informei que seria tudo com a própria porto seguro. Que retiraria a intermediação da Qualicorp\n e que o vinculo seria direto na operadora, que a nossa corretora faz apenas a movimentação\n mas boleto contrato tudo da porto mesmo. Ele falo que ok, pedi pra marcar reunião ele nao quis \npedi pra retornar por email a ele quinta ele falo que ok', '2022-07-07 10:00:00');
