INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'LEONARDO SERAFIM DOS ANJOS', '24687607861', NULL, NULL, NULL, 'Em conversa com a Mae de Leonardo a mesma informou que paga cerca de 6 mil para ela e o esposa num plano com eistein e sirio, o plano é da empresa que o esposo trabalhou.\nLeonardo ainda não viu o material mas disse que me retorna assim que possivel', '2024-01-23 16:13:21');
