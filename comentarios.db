INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'KAREN VOLTAN', '26063201823', '1130574050', '11997972211', '11985559009', 'mandei wpp, nao esta atendendo: \n\n(Não consegui mais falar contigo. Gostaria de checar o que achou das opções na Bradesco, se estas\n ficaram mais atrativas que a Porto. Se surgiu algum receio quanto a uma possível troca, vamos conversar\n Dra. me de um retorno quando puder. Estou á disposição, bom dia!)', '2022-08-22 11:14:03');
