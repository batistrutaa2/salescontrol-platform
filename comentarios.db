INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'MARIA FRANCISCA ANTONIA ROMANO VICTORINO DA SILVA', NULL, '(11)99946-4914', NULL, NULL, 'em contato com ela, informei ser da Sul América que devido insatisfação dos clientes gostaríamos de oferecer nossos produtos diretamente na nossa operadora, ela falo que nao tem CNPJ e nao vai abrir pra eu nem oferecer que ela sabe que isso é errado e anti etico, nem pude argumentar ela ja encerrou o ctt', '2022-06-29 15:16:21');
