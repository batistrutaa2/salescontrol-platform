INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'CARLOS MARSI HORUATH', '07549215812', '1150618207', '11999658535', '11951081290', '(11) 9996-58535 - Em contato com João. Disse que o pai dele não fala mais ao telefone e que quem \ncuidava era Cristina 999658549 liguei e ela informou que tem uma liminar e que ela queria posição \nquanto a reclamação na ouvidoria do plano ter reajustado mais nao ter aumentado o reembolso. Vou ligar \npra ela dps oferecendo sula com reembolso maior sei la \n(11) 9510-81290 - Chamada encerrada\n(11) 5061-8207 - atendente informou que com ele só por e-mail, ai pedi, ele disse um momento e disse que \nfoi informado que ele nao tem interesse. abordei como porto \n\n\nEm busca no assertiva\n\n08.626.568/0001-24 - CNPJ ok', '2022-08-24 16:52:21');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'CARLOS MARSI HORUATH', '07549215812', '1150618207', '11999658535', '11951081290', 'le puxou, tiraram o filho. e estão pagando 7.276. vou ligar dps dizendo que o que ela flao da ouvidoria nao é \r\ncmg mais que da pra trocar todos para sula cnpj pra melhorar o reembolso', '2022-08-25 15:30:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'CARLOS MARSI HORUATH', '07549215812', '1150618207', '11999658535', '11951081290', 'em contato com ela, falei que pedi ne que a ouvidoria retornasse a ela, ela falo que retornaram mais que disseram \nque de fato o reembolso não aumentou (aumentou reajuste porem não aumentou reembolso e ela ta puta)\ndisse que o marido tem doença grave e não pode sair, falei sai só vc e o filho que ela falo que não podia conversar\nnaquela hora e que ia perguntar s epodia enviar a ligação ciau e ela nao atendeu mais', '2022-09-09 14:52:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'KAREN VOLTAN', '26063201823', '1130574050', '11997972211', '11985559009', 'Em contato com ela final 9009 contato foi bom.  Deixou eu falar, falou que ta na Sul américa desde 2008\nque gosta ate da operadora, porem ta um preço mto alto, ela nao quis falar o valor. Apresentei ouro mais \nouro max e diamante, disse que de saúde estao todos bem. confirmou idades 45-43 e dois menores. \ndisse que usa mto o sta cataria pq mora perto, falei que podemos agendar reunião, ela pediu pra enviar \nprimeiro; Vou retornar na sexta feira. \nInformei que somos da Brazil porem que trabalhamos com outras operadoras qnd ela me deu a negativa \nque Porto ela tem dor de cabeça sempre com reembolso. Então acho que é ret marca reunião e tenta vende \nbradescao, vamos ver.', '2022-07-20 16:31:41');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'KAREN VOLTAN', '26063201823', '1130574050', '11997972211', '11985559009', '(11) 9855-59009 - em contato com ela, usei a estratégia que estava retornando, pois havia acabado de agendar \numa reunião próximo ao Sta Catarina na quarta 14h, sendo um local prox a residência dela e gostaria de\n saber se ela poderia atender meu gestor para tratar deste assunto pessoalmente. Ela informou que quarta é mto \ncorrido a ela e que tb analisou com o esposo e eles nao gostariam de migrar pra porto devido a dificuldades \nque els como médicos tem com os pacientes que tem porto, "que o plano nao é tao bom" \nEnfim, parti então apra Bradesco e ela informou que neles possui mais confiança, pediu para enviar p ela \ne ela vendo os valores com o esposo alinhamos uma reunião.', '2022-08-01 10:45:33');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'KAREN VOLTAN', '26063201823', '1130574050', '11997972211', '11985559009', 'Nao atendeu', '2022-08-03 14:45:00');
