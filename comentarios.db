INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'HUMBERTO SALGADO FILHO', '08352014811', '11981411393', NULL, NULL, '(11) 9814-11393 - em contato com ele, informou que o custo da porto da péssimo kkk que ele paga 5.500,00 \nna sul américa, não sei como, pq empresa dele tudo de sp.... 27.340.429/0001-84 / 08.641.774/0001-03. \n\nque por agr nao faz sentido mais agradeceu eu ter tentando e tal, fiquei de ret fim do ano', '2023-06-05 12:02:32');
