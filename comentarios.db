INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOAQUIM JHONNY VARGAS VILLARROE', '06906673882', '1126776898', '11971059475', '11999772151', '(11) 9997-72151 Em contato com cliente\n O mesmo se interessa no assunto e ao \nsolicitar idades, pede um retorno para segunda-feira no primeiro\nhorário. Retornar para apresentação de valores e benefícios. \nCliente possui CNPJ ativo . Falado de Porto Seguro !', '2022-07-18 10:30:00');
