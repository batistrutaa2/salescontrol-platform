INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'TIAGO ALVES SERBETO DE FREITAS', '80996620591', '1239416448', '12996204703', '12996207670', 'em ctt com ele, quer opção via pessoa fisica, expliquei que bradesco esta aceitando apenas médicos e que \nnao enquadra no sindicato dele, só se caso a esposa dele fosse medica tb, falei de abrir empresa novamente\nque a região deles favorece mto e vamos ver,', '2023-07-03 10:45:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'VILMA DA GUIA N R DO NASCIMENTO', '15304994884', '1158195401', '11992618416', NULL, 'PESQUISA - cliente chateada pois o esposo foi fazer exame no CDB e descredenciou. disse que tem cnpj e queria \nver opção tb, disse que pra ligar pra ela precisa ser dps das 18h ou antes das 9h ou mandar no email\nfalei que enviariam bradesco e amil e ela falo que ok, pra enviar nos dois cenarios cassp e cnpj sp', '2022-11-17 15:11:40');
