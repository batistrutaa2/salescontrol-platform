INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'RITA DE CASSIA ALVES PUGLIESE', '19887846899', '1150711949', '11938009920', NULL, 'Cliente INFORMOU QUE POSSUIA PLANO COM A SUL AMERICA, APENAS 2 VIDAS, SENDO ELA DE 49 E A FILHA DE 10. QUESTIONEI SE ELA POSSUIA UMA TERCEIRA VIDA,ELA DISSE QUE TINHA O ESPOSO MAS QUE ELE JA ESTA EM UM PLANO PJ, PEDI PRA PODER COTAR INCLUINDO ELE SEMCOMPROMISSO,ELA DISSE QUE OK E INFORMOU A IDADE DELE SENDO 68 ANOS. INFORMOU QUE SOFREU REAJUSTE RESCENTEMENTE PELA SULA. Whats enviado com a cotação.', '2022-05-16 13:50:14');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'RITA DE CASSIA ALVES PUGLIESE', '19887846899', '1150711949', '11938009920', NULL, 'esperando email pra enviar cotação pra essa cliente, wpp dela nao abriu ela pediu pra mandar no email : rc-pugliesi@uol.com.br', '2022-05-23 15:00:53');
