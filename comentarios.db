INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JACQUELINE TAKAYANAGI GARCIA', '11942249896', '1150934149', '11984024036', NULL, '(11) 9840-24036 Em contato com cliente, a mesma se interessa por vários produtos\nEnviada cotações de todas as concorrentes, cliente insatisfeita com valor do seu plano, informa que está com \nvárias cotações de outra corretora, shift \n\nA mesma aborda sobre reunião amanhã, irei verificar para recebê-la!', '2023-07-21 15:44:10');
