INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'VERA SASSON', '11754691811', '(11) 3801-1760', '(11) 9987-06288', '(11) 9990-40809', 'CLIENTE AFAVEL TELEFONE 2 CLIENTE FEZ UM DOWNGRADE E MUDOU PARA CNU, E ESTÁ NO MODO COPARTICIPATIVO, NAO FALOU O VALOR MAS DISSE QUE NAO PODE FAZER CONSULTA E RETORNO NO MESMO MES, NAO CONSEGUE ACESSAR NO SITE DELES, AS REDES CREDENCIADAS FORA DE SP... MUITAS QUEIXAS. TROCOU PARA CNU EM JANEIRO.', '2023-09-19 10:52:20');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'VERA SASSON', '11754691811', '(11) 3801-1760', '(11) 9987-06288', '(11) 9990-40809', 'Em conversa com Vera a mesma confirmou o dowgrade e informou que seu plano seria o mais básico da CNU com o valor de 2700.\nVera pediu que enviasse no email e adiantou que só poderá conversar na próxima semana.', '2023-09-19 14:57:45');
