INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ALFREDO YUKIO ANDO', '28217088829', NULL, NULL, NULL, 'Não consegui puxar telefones nem pelo assertiva!', '2023-08-29 11:02:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA MARIA VERCOSA REBELLO', '23001445220', '1141247210', '11992865632', '14998565566', '11 992910803 Enviada cotação no whatsapp referente a Amil One \nCliente informa que não possui empresa e não possui segunda vida\nMas gosta dos valores e solicita cotação em seu whatsapp \nA mesma alega que irá fazer uma comparação e pede retorno em uma horário mais oportuno \nPrestada consultoria sobre abertura do cnpj', '2023-09-14 15:24:40');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA MARIA VERCOSA REBELLO', '23001445220', '1141247210', '11992865632', '14998565566', '11 99291-0803 Em contato com cliente, a mesma informa novamente não ter mais ninguem e não ter\ncomo abrir empresa. \nInforma ser funcionária pública, cotado Unimed Q Superior Nacional pela AFPESP no valor de R$4.323,37\nValores ficaram atrativos. Retornar segunda-feira pela manhã para passar a mesma e cobrar valor de \nangariação de uma mensalidade cheia.', '2024-01-12 11:23:51');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA MARIA VERCOSA REBELLO', '23001445220', '1141247210', '11992865632', '14998565566', '11 99291-0803 Em retorno, a mesma informa que só consegue falar na segunda-feira\nPede retorno na próxima segunda para passarmos a proposta a mesma!', '2024-01-16 09:55:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA MARIA VERCOSA REBELLO', '23001445220', '1141247210', '11992865632', '14998565566', 'Em contato com cliente, a mesma solicitou retorno para quinta-feira 14/03/2024', '2024-03-12 16:37:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA MARIA VERCOSA REBELLO', '23001445220', '1141247210', '11992865632', '14998565566', '11 99291-0803 Em contato com Ana, cliente solicita retorno para amanhã as 16h30!', '2024-05-08 10:08:41');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA MARIA VERCOSA REBELLO', '23001445220', '1141247210', '11992865632', '14998565566', '11 99291-0803 Fiz novo contato com cliente, a mesma aceita receber proposta pela Unimed Q Superior\nvia qualicorp APM, não possui empresa e não tem mais ninguém. \nReduziu para R$ 4.400,00 , a mesma fez bariatrica e disse que ano que vem pretende realizar cirurgia reparadora.', '2024-06-10 14:21:24');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA MARIA VERCOSA REBELLO', '23001445220', '1141247210', '11992865632', '14998565566', '11 99291-0803 Em retorno com cliente, a mesma informa que ouviu referências negativas da Unimed , \nReforcei a ideia da abertura do cnpj, a cliente sanou novos receios e duvidas de abertura, pagamento de\nmensalidade para contador, a questão da taxa de sinistralidade. \nPediu um retorno amanhã depois das 15 horas para falarmos novamente, verificar se cliente não teria \nmais um dependente para incluir no plano empresarial!', '2024-06-20 14:34:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANA MARIA VERCOSA REBELLO', '23001445220', '1141247210', '11992865632', '14998565566', '11 99291-0803 - Em contato com Dra, a mesma solicita um retorno na quinta-feira a tarde para tratarmos.', '2024-07-02 10:13:59');
