INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'BASILIO ROSA CARVAS', '06347784807', '1137444649', '11997163182', '11999328708', 'EM CONVERSA COM BASILIO O MESMO INFORMOU QUE ESTA ATRAS DE OUTRA PESSOA QUE POSSA ENTRAR NA APOLISE JUNTO COM ELE.\nAGUARDAR RETORNO', '2023-07-31 16:30:55');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'BASILIO ROSA CARVAS', '06347784807', '1137444649', '11997163182', '11999328708', 'Durante a ultima conversa com Basilio, apresentei a ideia de sua companheira entrar junto com ele em sua apólice para que ele se enquadre na regra da Amil, mesmo ela já tendo plano, pois a redução sera significativa  em sua apólise. A maior dificuldade é encontrar alguém.\nBasilio possui CNPJ e tem bastante interesse em sair da Mutua  e Qualicorp.', '2023-08-07 16:20:34');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'BASILIO ROSA CARVAS', '06347784807', '1137444649', '11997163182', '11999328708', 'Tentativa de contato sem sucesso', '2023-09-14 11:23:32');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'BASILIO ROSA CARVAS', '06347784807', '1137444649', '11997163182', '11999328708', 'Em conversa com Basílio, o mesmo informou que realizou a transição para o plano de sua filha que é uma apólice \nPME e teve uma redução interessante, Basílio ficou aberto a novas condições futuramente', '2023-09-22 15:49:38');
