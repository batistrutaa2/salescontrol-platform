INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CINTIA MARIA PIVA', '974276839', '11997062447', '11982291734', NULL, '(11) 997062447 - Em contato com filha Gabriela, a mesma informa ter interesse\nSolicita reenvio de cotação com Diamante executivo para as duas idades \nInformado sobre terceira vida, a mesma disse que iria tratar comigo por e-mail \nCliente pagando caro, manter contato e retornar com argumentos de fechamento .', '2022-08-03 11:54:18');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CINTIA MARIA PIVA', '974276839', '11997062447', '11982291734', NULL, 'Filha Gabriela passa contato da mãe 11 98114-9100 \nA mesma pede para mandar e-mail antes de ligar , como não obtive retorno \nentrei em contato por ligação, só caixa postal, enviada mensagem no whats \nda cliente', '2022-08-16 11:04:59');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CINTIA MARIA PIVA', '974276839', '11997062447', '11982291734', NULL, 'Em contato com Cintia via whatsapp .\nCliente solicita cotação via e-mail e fala sobre seus benefícios atuais\nReenviada cotação via whatsapp da cliente e falado sobre os benefícios!\nRetornar com argumentos de fechamento', '2022-08-16 14:13:53');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CINTIA MARIA PIVA', '974276839', '11997062447', '11982291734', NULL, 'Tentativa de contato por telefone sem sucesso \nEnviada mensagem no whats referente a cotação enviada\ntentando marcar reunião com cliente!', '2022-08-24 10:03:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CINTIA MARIA PIVA', '974276839', '11997062447', '11982291734', NULL, 'Em contato via whatsapp com cliente \nA mesma se interessa pelo projeto e passa as idades do seu irmão e família\n57, 57, 32, 29, 10, 06\nCliente se interessa pela Porto Seguro para todo o grupo e também pela \nAmil One Black S6500R3 para ela e filha . \nCliente informa que irá analisar juntamente com irmão para efetuarem uma troca\nNo CNPJ :  04.150.524/0001-10 , estão como sócios a filha Gabriela e o irmão Celso\npossibilitando a formalização de uma apólice para as duas famílias \nCotação enviada para 8 participantes na Porto Seguro Diamante Executivo R2 \nRetornar com argumentos de fechamento para marcar reunião .', '2022-08-30 16:57:33');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CINTIA MARIA PIVA', '974276839', '11997062447', '11982291734', NULL, 'Em contato com Cinthia, cliente informa que sua mãe está em uma fase terminal . \nA mesma alega que não poderá tratar desse assunto no momento, retornar futuramente!', '2022-11-22 16:39:21');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CINTIA MARIA PIVA', '974276839', '11997062447', '11982291734', NULL, '11 98114-9100 Enviada mensagem no whats referente a cotação', '2023-01-10 13:45:56');
