INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'RAPHAEL GENDLER', '4162730849', NULL, '11971625777', NULL, 'JOSE LUIZ PINTO LIMA GENDLER - 311.354.688-50 - (11) 99685-2823 (FILHO)\nAFAVEL MAS UM POUCO LENTO NA FALA.\nCLIENTE DIZ ESTAR PAGANDO EXTREMAMENTE CARO, ELE É MEDICO E ESTA PELA APM, ELE FALOU ESTAR \nPENSANDO EM MUDAR DE ENTIDADE DE CLASSE, SÓ PRA REDUZIR O CUSTO E MELHORAR OS BENEFICIOS.\nENTENDI COM ISSO, QUE ELE ESTÁ EM OUTRA APOLICE, MAS FALOU SOBRE O VALOR DE AMBAS PARTES.\nA MAE DELE TEVE DIFICULDADES PARA FAZER EXAMES, POIS A SULA, NÃO ESTAVA LIBERANDO.\nOBS: OLHA A IDADE DO SR. RAPHAEL.\n\nCLIENTE NÃO POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-04-04 17:35:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'RAPHAEL GENDLER', '4162730849', NULL, '11971625777', NULL, 'Ligação pessima. Mas o cliente pediu q ligasse em outro momento.', '2024-01-18 16:00:46');
