INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'SENIR APARECIDA RAMALHO DE SOUSA', '91191815668', NULL, '11998297094', NULL, 'em contato com ela, disse que queria atualizar e tal as infos, ela faz 53 em nov e pediu pra enviar cotações a ela \nporem nao tem mto o que fazer, falei de notredame ela ja soltou um deus me livre, fecomercio tem quase nada \nde plano mais. mandei sami e perguntei qual a formação dela considerando outros sindicatos', '2023-06-06 11:56:08');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'SENIR APARECIDA RAMALHO DE SOUSA', '91191815668', NULL, '11998297094', NULL, '(11) 9982-97094 - não atendeu mandei wpp', '2023-06-19 15:52:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SUELI DOS SANTOS OLIVEIRA', '25777336825', '1147328175', '11947328175', '11940359432', 'CLIENTE ESTÁ EXTREMAMENTE INSATISFEITA COM O VALOR PAGO. ESTÁ A 4 ANOS SOFRENDO REAJUSTE. ELA DISSE QUE SABE QUE A QUALICORP FICA COM 50% DO VALOR PAGO, QUE É INJUSTO. NÃO TEM INTERESSE EM OUTRAS OPÇÕES NEM OUTRAS OPERADORAS. QUER O MESMO QUE TEM SÓ QUE COM O VALOR MENOR. UTILIZA O BP, NÃO FALOU SOBRE REEMBOLSO. DISSE SABER QUE É POSSIVEL PAGAR PELO MESMO BENEFICIO 2.700,00. CLIENTE AFAVEL SÓ QUE AZEDA, ELA CONVERSA MAS TUDO ELA TA CERTA, TUDO ELA JA SABE. TELEFONE 2 O DELA. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-02-06 18:22:04');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SUELI DOS SANTOS OLIVEIRA', '25777336825', '1147328175', '11947328175', '11940359432', 'Em contato com cliente, a mesma possui doença auto imune\nPassado a cliente todo passo a passo para conseguir medicamento em farmacia de auto custo\npelo SUS. \nCliente informa dar muito trabalho e com isso prefere permanecer no seu mesmo plano\n\nCliente antiga onde ja tentamos fazer sulamerica para sulamerica e deu desinteresse comercial!', '2023-02-13 10:05:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROSANGELA MACEDO FOLTRAN', '06306815899', '11999843051', '11945305860', '1125072218', 'CLIENTE ANALITICO MAS AFAVEL SE DEMONSTRAR AFETO POR ELA. NÃO TEM QUEIXAS SOBRE UTILIZAÇÃO NEM VALORES, MAS NO DECORRER DA CONVERSA DISSE ESTAR UM POUCO ELEVADO O VALOR. ERA UNIMED POR MAIS DE 10 ANOS E TROCOU HÁ 2 PELO SULAMERICA. ELA E OS FILHOS VIERAM. O MARIDO TEM DOENÇA ONDE UTILIZA HOME CARE, E POR ISSO FICOU NA UNIMED. É NECESSARIO SER FIRME E FALAR SOBRE DESCREDENCIAMENTOS QUE VEM ACONTECENDO. ELA TROCANDO DE PLANO, SERÁ APENAS PELO MOTIVO DA SULAMERICA DEIXAR ELA NA MÃO. CLIENTE POSSUI DIVERSOS BENEFICIOS NA PORTO SEGURO. CLIENTE NÃO POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-02-06 18:22:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROSANGELA MACEDO FOLTRAN', '06306815899', '11999843051', '11945305860', '1125072218', '(11) 9453-05860 - NAO ATENDEU \n(11) 9998-43051 - NAO ATENDEU \n(11) 2507-2218 - NAO ATENDEU', '2023-02-10 10:55:38');
