INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'RITA DE CASSIA SCRAMIN', '08556672817', NULL, NULL, NULL, 'Em conversa com Rita, conversamos sobre o estado atual da Sul américa, valores e beneficio com a Amil saúde \npara duas vidas, então Rita pediu um material envolvendo um sobrinho para visualizar opções com a Bradesco e \nPorto.\nEnviei a ela um material atualizado e também a lista de documentos necessários para inclusão da propostas.\nAcompanhar este caso de perto, muita possibilidade de fechar!', '2024-05-10 16:08:57');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'RITA DE CASSIA SCRAMIN', '08556672817', NULL, NULL, NULL, 'TENTATIVA DE CONTATO SEM SUCESSO', '2024-05-14 11:51:23');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'RITA DE CASSIA SCRAMIN', '08556672817', NULL, NULL, NULL, 'Em conversa com secretaria a mesma disse que Rita chega após as 13H', '2024-05-16 10:25:06');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'RITA DE CASSIA SCRAMIN', '08556672817', NULL, NULL, NULL, 'Em conversa com cliente, a mesma descartou a possibilidade de inclusão da sobrinha e disse que quer receber um\nmaterial envolvendo outra irma de 57 e o cunhado 63.\nEnviar e na proxima semana marcar reunião', '2024-05-16 15:28:16');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'RITA DE CASSIA SCRAMIN', '08556672817', NULL, NULL, NULL, 'Rita não esta na empresa hoje.\nRetornar amanha após as 13H', '2024-05-22 14:09:14');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'RITA DE CASSIA SCRAMIN', '08556672817', NULL, NULL, NULL, 'Retomei o assunto com Rita, apresentei as opções e a mesma disse que só vai se reunir com a família neste final \nde semana, portanto, Rita pediu que enviasse uma projeção no WPP 11 997803983 para que fique mais fácil a \ncomunicação.', '2024-05-23 15:48:27');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'RITA DE CASSIA SCRAMIN', '08556672817', NULL, NULL, NULL, 'Rita esta em reunião, mas a secretaria irá passar o recado', '2024-05-28 14:18:11');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'RITA DE CASSIA SCRAMIN', '08556672817', NULL, NULL, NULL, 'Rita não esta na empresa e nem atende ligação em seu numero.', '2024-06-03 15:44:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'RITA DE CASSIA SCRAMIN', '08556672817', NULL, NULL, NULL, 'Em conversa com Rita a mesma ainda não conseguiu se reunir com a irma e cunhado e não teve tempo para \nanalisar também, fiquei de pegar o contato da irmã para apresentar a proposta.\nAcompanhar pelo WPP', '2024-06-04 15:21:58');
