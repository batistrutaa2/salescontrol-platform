INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SAMIR GASPARINI ORRA', '29785414825', '11984617400', '1135697400', NULL, 'Possui benefícios com a Porto! Enviada proposta ao mesmo, Ouro Mais, porém a 2 meses não conseguia o retorno. Fazer retrabalho com cliente visando os reajustes e reforçar propostas com agressividade.', '2022-06-23 14:34:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SAMIR GASPARINI ORRA', '29785414825', '11984617400', '1135697400', NULL, '(11) 9846-17400 - Em contato, cliente não quis ouvir e pediu mensagem via whats. Reenviada proposta e salientado os reajustes de seu plano!', '2022-06-28 14:21:49');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SAMIR GASPARINI ORRA', '29785414825', '11984617400', '1135697400', NULL, '(11) 9846-17400 Ao me apresentar como Bradesco seguros\ncliente informa não ter interesse de receber proposta\nAo tentar contornar, cliente informa que mesmo assim está sem interesse!', '2023-01-18 15:37:26');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SAMIR GASPARINI ORRA', '29785414825', '11984617400', '1135697400', NULL, '(11) 9846-17400 Ao me apresentar como Bradesco seguros\ncliente informa não ter interesse de receber proposta\nAo tentar contornar, cliente informa que mesmo assim está sem interesse!', '2023-01-18 15:37:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SAMIR GASPARINI ORRA', '29785414825', '11984617400', '1135697400', NULL, 'CLIENTE UM POUCO GROSSO.\nELE DISSE QUE O PLANO DELE ESTA CANCELADO, E QUESTIONOU SE REALMENTE EU SOU DA QUALICORP\nPOIS EU DEVERIA SABER DESTA INFORMAÇÃO.\nNÃO CONSEGUI SABER SE HOJE ESTA NO PME OU ESTÁ SEM PLANO.\n\nCLIENTE POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-10 11:53:10');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SAMIR GASPARINI ORRA', '29785414825', '11984617400', '1135697400', NULL, '(11) 9846-17400  Ao retornar sobre pesquisa, cliente informa não ter interesse \nem contratar seguro saúde e desliga em face!', '2023-03-22 10:04:27');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SAMIR GASPARINI ORRA', '29785414825', '11984617400', '1135697400', NULL, '(11) 9846-17400  Ao retornar sobre pesquisa, cliente informa não ter interesse \nem contratar seguro saúde e desliga em face!', '2024-01-09 14:08:30');
