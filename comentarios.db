INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ELIZABETH DOMINGUES CHIODE', NULL, NULL, '(11)97695-9419', NULL, '(11) 9769-59419 - contato bem bacana, cliente ta insatisfeito com qualicorp. falamos de bradesco abertura de \ncnpj, tem a questao de ser só duas vidas, ele falo que o filho dele ja tem bradesco e que ele ja disse pra ele \nentrar na empresa com fgts, ele ja estudou entrar no plano do filho. o grande ponto é que ele tem end litoral \ne abordei com a ideia de abrir la, ambos aposentados, tem que ver nesta parte, pediu pra enviar valores \nsp vapital ele e a mulher que ele ia conversar com o filho dele que é adv', '2022-08-24 11:42:37');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ELIZABETH DOMINGUES CHIODE', NULL, NULL, '(11)97695-9419', NULL, 'Boa Tarde Jaqueline \nPor aqui tudo bem.\nBoa Tarde \nEu falei com ele e com os responsáveis pelos Planos de Saúde do Escritório e disseram que estão com contrato em andamento com a Corretora atual até o próximo ano e estão vendo a possibilidade de inclusão minha e da minha esposa no Plano Bradesco Saúde que está em vigência no Escritório.\n\nele me falo isso no whats quando cobrei, ja ja entro em contto pra saber que que deu', '2022-09-28 15:48:27');
