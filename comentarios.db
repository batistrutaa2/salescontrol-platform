INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIANA GARCIA VILLELA', '30132180880', '1141533961', '11982650066', NULL, 'mandei wpp de voz pedindo rpa retomar e tal ela falou : \n\nOi Jaqueline. No momento não, mas se for mudar te procuro para uma cotação. Obrigada!', '2023-02-28 12:16:02');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIANA GARCIA VILLELA', '30132180880', '1141533961', '11982650066', NULL, 'TELEFONE 2 CLIENTE.\nAFAVEL.\nELA FALOU SOBRE REEMBOLSO E REDES, ESTA COM DIFICULDADE EM PASSAR NUM PEDIATRA, MORA EM \nALPHAVILLE, E O PEDIATRA DA FILHA, ACEITA PLANOS INFERIORES MAS NAO ACEITA O DELA.\nDEPOIS DELA FALAR ATÉ MESMO DE VALOR, ELA FALOU QUE NAO QUERIA QUE NINGUEM RETORNASSE.\nELA QUER PERMANECER NO PLANO DELA, E SE POSSIVEL, COLOCAR QUE ELA NAO PARTICIPOU DA PESQUISA\nSO PRA NAO TER NINGUEM LIGANDO PRA ELA, QUE ELA NUNCA TEM TEMPO.\n\nCLIENTE POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE NÃO POSSUI EMPRESA - ASSERTIVA.', '2023-03-13 16:14:12');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIANA GARCIA VILLELA', '30132180880', '1141533961', '11982650066', NULL, '(11) 9826-50066 - liguei pra ela, como porto, se tendo em vista o reajuste e tal ela nao quer retomar. \nfalou que não, que não vai mudar agr que tem meu contato e que qnd for trocar me contata', '2023-03-20 11:41:58');
