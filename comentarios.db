INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MARCUS AUGUSTUS GIANULLO', '81781610878', '(11) 2973-1583', '(11) 9991-95059', '(11) 9697-31583', 'Marcus informou que nao pode falar pois sua esposa esta internada e disse que retornaria', '2023-11-30 11:11:22');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MARCUS AUGUSTUS GIANULLO', '81781610878', '(11) 2973-1583', '(11) 9991-95059', '(11) 9697-31583', 'Em conversa com marcos explique para ele sobre os futuros reajustes então o mesmo pediu que enviasse em seu WPP', '2024-01-12 15:51:24');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MARCUS AUGUSTUS GIANULLO', '81781610878', '(11) 2973-1583', '(11) 9991-95059', '(11) 9697-31583', 'Em conversa com marcus o mesmo disse que esta em tramite judicial com a sulamerica pois sua esposa esta em tratamento de cancer de mama a um tempo e o mesmo deciciu reduzir os custos.\nExpliquei para ele sobre portabilidade e sobre a DS, o mesmo disse que vai aguardar até fevereiro e qualquer coisa me retorna', '2024-01-16 11:06:16');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MARCUS AUGUSTUS GIANULLO', '81781610878', '(11) 2973-1583', '(11) 9991-95059', '(11) 9697-31583', 'Marcus pediu que enviasse uma projeção para marcar uma reunião para a proxima semana', '2024-02-29 16:32:56');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MARCUS AUGUSTUS GIANULLO', '81781610878', '(11) 2973-1583', '(11) 9991-95059', '(11) 9697-31583', 'Marcus informou que esta aguardando noticias sobre a liminar mas ainda sim disse que não quer permanecer com \na Qualicorp e me tem como seu corretor, acompanhar o caso de perto trazendo as novidades e no melhor \nmomento iniciar a transição', '2024-03-05 11:14:55');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MARCUS AUGUSTUS GIANULLO', '81781610878', '(11) 2973-1583', '(11) 9991-95059', '(11) 9697-31583', 'Marcus informou que ja conseguiu reduzir o plano para 9 mil e que o juiz determinou que não será aplicado \nreajuste até o fim do processo, o mesmo decidiu aguardar para fazer a transição', '2024-06-14 15:42:31');
