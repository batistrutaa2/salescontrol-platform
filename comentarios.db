INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANTONIO CARLOS PONCE', '44797940859', NULL, NULL, NULL, '(11) 98272-8758 - Em contato com cliente, o mesmo informa que tem interesse mas sana alguns receios \ndo plano empresarial\nCliente fala sobre seu filho que tem MEI e passa a idade de 45 anos, informa que o mesmo ja estava vendo do \nassunto e que tem esposa e filho. Tentar trazer todos a Porto e usar tabela de 5 vidas com dois acima da idade\n\nRetornar!', '2024-07-16 17:15:13');
