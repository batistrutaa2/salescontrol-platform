INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'APARECIDA TAVARES DE TOLEDO', '00339668857', '1139663252', '11981214636', '11969526018', 'aparecida ficou sussetivel a abri um cnpj e disse que tem a filha de sua vida de 44 anos mas que ela ja tem plano.\ncomecei fazer as comparações na linha com aparecida e a mesma viu vantagens porém disse que não pode fazer a troca esse ano pois tem diversos exames ja marcados, fiquei de enviar um material no email e ir acompanhando durante esse final de ano', '2023-11-09 15:20:30');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'APARECIDA TAVARES DE TOLEDO', '00339668857', '1139663252', '11981214636', '11969526018', 'Em conversa com Aparecida expliquei para ela sobre os exames agendados não impactarem na transição, \nexpliquei todas as vantagens dessa troca e Aparecida gostou bastante, a mesma ficou de confirmar com sua filha \num horário marcamos uma reunião amanhã', '2023-11-21 15:07:54');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'APARECIDA TAVARES DE TOLEDO', '00339668857', '1139663252', '11981214636', '11969526018', 'Em conversa com Aparecida a mesmo informou que entrará no plano de saúde de seu genro após conversar com \nsua filha.\nLigar futuramente para verificar situação', '2023-11-23 14:57:34');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'APARECIDA TAVARES DE TOLEDO', '00339668857', '1139663252', '11981214636', '11969526018', 'Mensagem enviada por Aparecida\n"Olá.  Boa tarde. Já está tudo ok com meu plano de saúde.  Muito obrigada."', '2024-01-15 17:12:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'CAROLINE G BERTACCHINI', '36311625881', '(11) 9817-93282', NULL, NULL, '(62) 9957-52849 ATENDEU PORÉM NÃO ME ESCUTAVA NÃO CONFIRMOU SE ERA CAROLINE', '2023-09-19 17:45:47');
