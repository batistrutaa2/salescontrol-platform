INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'JANAINA FERREIRA LUCIN TEODOROV', '29878465845', '(11) 3155-0204', '(11) 9768-03604', '(11) 9915-71912', 'Em conversa com Janaina a mesma disse que conversou com a empresa que é quem paga seu plano e eles \ndecidiram aguardar um pouco mais, porém ela com a empresa tem meu contato e irão me procurar futuramente.\nAcompanhar até o final deste ano.', '2024-04-04 11:06:16');
