INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'AMERICO M CRAVEIRO', '76525341868', '1131011141', '61996474453', '61996730063', 'INTERESSE ALTO  31/03/2023 15:55:50\n\n011964735198  Em contato com o mesmo, solicita retorno na próxima semana\nInforma estar viajando e desliga!\nINTERESSE ALTO  29/03/2023 14:41:07\n\n011964735198 Tentativa de retorno, telefone para contato só da caixa postal\nINTERESSE ALTO  28/03/2023 10:04:12\n\n011964735198 Tentativa de retorno, telefone para contato só da caixa postal\n\n011964735198 Em contato com Americo, cliente aceita receber via email proposta\nAmil Saúde S750 no email : americocraveiro@uol.com.br \n\nEnviado ao mesmo, sanou dúvidas sobre plano empresarial, disse que teve uma experiência\nruim no mesmo modo de contratação, por isso voltou ao plano físico \n\nEnviada proposta com custo muito mais acessível, irei fazer o retorno para saber a opinião do cliente\nRetornar com argumentos para levar ao fechamento!\nPESQUISA  27/03/2023 11:46:19\n\n01196473', '2023-09-14 11:25:20');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'HELIO ZEMEL', '87385570887', '11996331930', '11963509442', NULL, '(11) 9963-31930 Em contato com Hélio, ao passar proposta Amil Saúde S750 \nO mesmo aceita receber sem compromisso, porém alega que faz um tratamento ativo. \nO cliente porta uma leucemia , informa não ser um grau grave, porém faz acompanhamentos .\n\nPassada a proposta ao mesmo e falado sobre a Portabilidade . \nIrei retornar o contato ao cliente para saber se quem sabe aceita fazer a tentativa da troca.', '2023-03-17 11:05:20');
