INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'IASIN ISSA AHMED', '00700516824', NULL, NULL, NULL, 'não tem nenhum dado do cliente também no assertiva\nprovavelmente pela profissão do mesmo, juiz de direito!', '2023-07-28 16:38:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE ROBERTO DA SILVA BURATTO', '67069100825', '1126490884', '11997946363', '11972029017', '(11) 9979-46363 Em contato com Dr josé, cliente se demonstrou bem interessado na proposta : \nBradesco Saúde Top Nacional 3, enviado no email atualizado do cliente , sanou diversas dúvidas do plano\nempresarial e gostou muito do que ouviu, pediu para enviar mensagem no whats e solicitou um retorno\npara quarta-feira no período da tarde, irei retornar o contato.', '2023-07-07 15:40:20');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'JOSE ROBERTO DA SILVA BURATTO', '67069100825', '1126490884', '11997946363', '11972029017', '(11) 9979-46363 Em retorno com Dr. José, cliente sana últimas dúvidas e solicita email com valores\npode cada participante e check list de documentos. \nPede retorno no dia 19/07/2023 e informa que irá entrar com a documentação para a troca do plano no\npróximo mês, irei retornar contato!', '2023-07-13 14:44:29');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCIA S RAIMUNDO DUARTE', '14665878811', '1126155296', '11969040468', NULL, '11 99935-7833  Em contato com a filha Juliana, cliente não informa numero dos pais\nporém tira algumas dúvidas do valor pago atualmente, dos benefícios e transição \nSolicita cotação para os pais por whatsapp e informa que irá contata-los para fazerem uma análise\n\nRetornar com argumentos de fechamento', '2023-07-07 14:23:15');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LUCIA S RAIMUNDO DUARTE', '14665878811', '1126155296', '11969040468', NULL, '11 99935-7833 Em retorno com Juliana, a mesma informa que não pode falar e alega que caso\ntenham interesse entrariam em contato, ja passou proposta aos pais!', '2023-07-11 10:39:14');
