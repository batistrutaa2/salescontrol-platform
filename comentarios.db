INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'LEANDRA STEINMETZ', '14773412852', '11991872290', '11991872290', NULL, '(11) 9918-72290 Em contato com Leandra, retorno referente ao Bradesco Saúde enviado\nem seu whatsapp em Dezembro, cliente passou também a idade do esposo na mesma \nfaixa-etária de idade de 49 a 53 anos. \nCliente informa estar de férias e pede retorno para tratarmos da proposta a partir do dia 30/02\nRetornar e fazer uma apresentação mais detalhada dos benefícios do Top Nacional Plus , oferecer\ntambém Diamante, retornar com argumentos para reunião e reforçando custo e benefício de seu plano!', '2023-01-24 10:40:48');
