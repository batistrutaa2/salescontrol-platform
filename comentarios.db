INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ERIKA KAMEYA DA SILVA', '79491286153', '65981118700', '65981118700', NULL, '(65) 9811-18700 Em contato com esposo Afonso, cliente necessita da abertura da \nempresa para Cuiaba Mato Grosso, pede algumas referências para a abertura. \nPassado uma empresa de contabilidade para a abertura e o mesmo irá avaliar quanto\na abertura da empresa, retornar com argumentos de fechamento.', '2023-02-01 14:50:27');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ERIKA KAMEYA DA SILVA', '79491286153', '65981118700', '65981118700', NULL, '(65) 9811-18700 Em contato com esposo Afonso, cliente necessita da abertura da \nempresa para Cuiaba Mato Grosso, pede algumas referências para a abertura. \nPassado uma empresa de contabilidade para a abertura e o mesmo irá avaliar quanto\na abertura da empresa, retornar com argumentos de fechamento.', '2023-02-01 14:50:37');
