INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MANUEL VITOR DOS SANTOS', '61864056800', '1150817309', '11991044534', '11991263630', '(11) 9912-63630 Em contato com Manuel, cliente aceita receber cotação da Amil Selecionada\nO mesmo sana algumas dúvidas e tem queixa do plano empresarial quanto a dedução do imposto de renda\nEnviado por email proposta com os calculas das economias na transição e comparação sem a dedução\n\nemail correto do cliente : manuelvitorsantos@bol.com.br\nValor atual do mesmo : R$ 18.558,19\n\nRetornar com argumentos de fechamento!', '2023-07-20 12:13:40');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MANUEL VITOR DOS SANTOS', '61864056800', '1150817309', '11991044534', '11991263630', '(11) 9912-63630 Em tentativa de retorno, telefone para contato só chamou!', '2023-07-28 11:54:20');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARCELA BORBA TAVARES MELO', '80169244415', '8130332842', '81991110406', '81982270708', '(81) 9911-10406 Em contato como qualicorp, cliente disse que uma corretora da qualicorp fez merda\na uns anos atras e ela não confia em nenhum corretor de la, cliente reclama do seu reajuste\nDesliga em face, ligar futuramente com uma nova abordagem!', '2023-09-20 15:40:44');
