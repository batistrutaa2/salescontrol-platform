INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARCELO MASSAHIKO HONA', '22061441823', '1135421142', '11999940347', '11980962434', '(11) 9999-40347 - em contato com ele, questionou plano por empresa, falei que sim e tal, falou que não tinha empresa, abordei abertura, falei como funcionava, que dava e tal, ele perguntou se outra cidades melhorava \nna tabela porto, falei que Litoral e tal, disse que era pra eu atualizar ele dos valores, pedi pra falar com a patricia \nele disse pra ela mandar email primeiro, vou ver com o ka pra montarmos um email sobre', '2023-06-05 15:58:03');
