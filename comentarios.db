INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'DIEGO PRETEL', '40478283865', '11994752435', NULL, NULL, 'Em contato com ele, por agr nao tem mto o que fzr pois agora ele nao tem um terceiro participante, tem unimed\npaga pouco e o unico hospital na cidade dele é Unimed, o resto é como sus ele me informou....', '2024-05-15 10:52:40');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'ADRIANA BERTOLAMI', '30711076847', '11976313399', NULL, NULL, 'Cliente está muito interessado, já tentou fazer essa transferência em outro momento porém sem sucesso. Estamos em contato com a gestora para saber o que houve, porém a mesma disse ter outro CNPJ para utilização.', '2024-05-13 15:43:28');
