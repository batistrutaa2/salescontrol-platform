INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DEISE NORIKO MATSUI NISHIMURA', '13557630889', '8532494064', '11963063679', '85988791874', '11 97708-9776 - Em contato com Deise, cliente se interessa pelo projeto Bradesco Saúde\nFalado sobre todos os benefícios e enviadas cotações TNP6 e TNP8 . Cliente não possui CNPJ \nPorém foi falado sobre a abertura de um mesmo e como funciona, cliente informa que irá \nmorar na Europa e quer manter seu plano no Brasil, falado sobre os benefícios do seguro \nviagem e sobre os reembolsos que a mesma utiliza, agendado um retorno para segunda-feira\npara tratarmos sobre e marcarmos uma reunião . \nE-mail atualizado', '2022-08-25 14:27:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'DEISE NORIKO MATSUI NISHIMURA', '13557630889', '8532494064', '11963063679', '85988791874', 'Retorno agendado referente a cotação !', '2022-08-29 17:30:00');
