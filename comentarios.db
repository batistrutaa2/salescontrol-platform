INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ALLINE VALADAO FERNANDES', NULL, '(11)99475-9889', NULL, NULL, '99475-9889 - Em contato com Eduardo, esposo dela, informou que estao mesmo com a pretensão de mudar o plano, que com a chegada de mais um filho (40/41/7 anos e 3 meses) e o reajuste o valor (4.500,00) esta inviável. Que ele vai constituir uma empresa para poder trocar o plano, perguntei se ia movimentar, falou que sim! Então é uma coisa mais com ele mesmo. Salientei carências compradas, ele informou que a esposa fez este ano um cirurgia de retirada de um nodulo no rim. Mas que ja era e que nem precisou fazer quimo nada. Umponto a se atentarmos em uma possível troca. Mandei e-mail, mandei wpp e fiquei de retornar na sexta feira para saber o que ele achou.', '2022-06-07 16:09:08');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ALLINE VALADAO FERNANDES', NULL, '(11)99475-9889', NULL, NULL, '99475-9889 - Em contato com Eduardo, esposo dela, informou que estao mesmo com a pretensão de mudar o plano, que com a chegada de mais um filho (40/41/7 anos e 3 meses) e o reajuste o valor (4.500,00) esta inviável. Que ele vai constituir uma empresa para poder trocar o plano, perguntei se ia movimentar, falou que sim! Então é uma coisa mais com ele mesmo. Salientei carências compradas, ele informou que a esposa fez este ano um cirurgia de retirada de um nodulo no rim. Mas que ja era e que nem precisou fazer quimo nada. Umponto a se atentarmos em uma possível troca. Mandei e-mail, mandei wpp e fiquei de retornar na sexta feira para saber o que ele achou.', '2022-06-07 16:09:08');
