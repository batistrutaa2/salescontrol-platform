INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROSA MARIA MARZO DE ALBUQUERQUE', NULL, '(11)99998-0449', '(11)3266-2469', NULL, 'Em contato com a cliente, a mesma se interessou pelo projeto Bradesco Saúde PME.\nInformou que seu marido possui participação em um contrato social e também tem filhos que possuem CNPJ.\nSolicitou cotação para 08 pessoas.\nIdades: 03 - 19 a 23 anos  / 76,77  /  49,51\nRetornar no final desta semana para alinhar uma reunião.', '2022-07-12 16:07:58');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROSA MARIA MARZO DE ALBUQUERQUE', NULL, '(11)99998-0449', '(11)3266-2469', NULL, 'Em contato com a cliente a mesma informou que até o final desta semana iremos agendar nossa reunião.', '2022-08-04 16:31:49');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROSA MARIA MARZO DE ALBUQUERQUE', NULL, '(11)99998-0449', '(11)3266-2469', NULL, 'Em contato com  a cliente, a mesma super insatisfeita com seu plano Atual. Sofreram reajuste de 20% e estão pagando 20 mil reais para duas pessoas. Solicitou contato amanhã qualquer horário. \nNacional Plus\n\nA intenção com essa cliente é trazer o PME com toda a família filhos e netos.', '2023-01-09 12:44:43');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROSA MARIA MARZO DE ALBUQUERQUE', NULL, '(11)99998-0449', '(11)3266-2469', NULL, 'Em contato com a cliente, a mesma super insatisfeita com seu plano Atual. Sofreram reajuste de 20% e estão pagando 20 mil reais para duas pessoas. Solicitou contato amanhã qualquer horário. Nacional Plus A intenção com essa cliente é trazer o PME com toda a família filhos e netos.\r\n\r\nINTERESSE ALTO  04-08-2022\r\n\r\nEm contato com a cliente a mesma informou que até o final desta semana iremos agendar nossa reunião.\r\n\r\nINTERESSE ALTO  12-07-2022\r\n\r\nEm contato com a cliente, a mesma se interessou pelo projeto Bradesco Saúde PME. Informou que seu marido possui participação em um contrato social e também tem filhos que possuem CNPJ. Solicitou cotação para 08 pessoas. Idades: 03 - 19 a 23 anos / 76,77 / 49,51 Retornar no final desta semana para alinhar uma reunião.', '2023-01-10 10:38:52');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROSA MARIA MARZO DE ALBUQUERQUE', NULL, '(11)99998-0449', '(11)3266-2469', NULL, 'Em contato com a cliente, a mesma super insatisfeita com seu plano Atual. Sofreram reajuste de 20% e\n estão pagando 20 mil reais para duas pessoas. Solicitou contato amanhã qualquer horário. Nacional Plus \nA intenção com essa cliente é trazer o PME com toda a família filhos e netos.\n\nINTERESSE ALTO  04-08-2022\n\nEm contato com a cliente a mesma informou que até o final desta semana iremos agendar nossa reunião.\n\nINTERESSE ALTO  12-07-2022\n\nEm contato com a cliente, a mesma se interessou pelo projeto Bradesco Saúde PME. Informou que seu \nmarido possui participação em um contrato social e também tem filhos que possuem CNPJ. Solicitou\n cotação para 08 pessoas. Idades: 03 - 19 a 23 anos / 76,77 / 49,51 Retornar no final desta semana\n para alinhar uma reunião.\n\npesquisa feita pelo kaique', '2023-01-10 11:19:26');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROSA MARIA MARZO DE ALBUQUERQUE', NULL, '(11)99998-0449', '(11)3266-2469', NULL, 'Contatei agora, liguei como Bradesco, pesquisa que gostaria de saber né o cenário, e informei que a Bradesco \nnecessita de 3 vidas. Ela disse que não quer incluir ngm que não tem como. que é pra ver algo somente \npra ela, falei ok ia ver uma opção na qualicorp e vou ligar a tarde dizendo que encontrei na amil', '2023-01-10 11:41:15');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ROSA MARIA MARZO DE ALBUQUERQUE', NULL, '(11)99998-0449', '(11)3266-2469', NULL, '(11) 9999-80449 - informou não ter recebido o e-mail. Reenviei e fiquei de retornar a tarde!', '2023-01-16 10:52:26');
