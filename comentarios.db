INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANTONIO C B NAVARRO', '04968859287', '1122917491', '11999611625', '11982246948', '(11) 9996-11625 Em contato com cliente, o mesmo informa que mesmo com as reduções no \ncusto, não tem nenhum interesse em receber proposta\nTentado contornar a objeção, cliente permaneceu sem interesse!', '2023-07-20 16:54:18');
