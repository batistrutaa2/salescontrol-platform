INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'RITA DE CASSIA ALVES PUGLIESE', '19887846899', '1150711949', '11938009920', NULL, 'TELEFONE 2\nCLIENTE SUPER AFAVEL.\nELA SAIU DA QUALICORP TEM UNS 2 MESES. ENTROU NO BRADESCO PME E ACRESCENTOU A SOBRINHA.\nELA SAIU POR CONTA DOS REAJUSTES, E ELA AINDA TINHA FEITO UM DOWNGRADE E MESMO ASSIM O VALOR\nESTAVA PUXADO PRA ELA.\nIDEAL SERIA AGENDAR PARA O MES 2/3 DE 2024 E OFERECER ALGO MELHOR.\n\nCLIENTE POSSUI BENEFICIOS NA PORTO SEGURO.\nCLIENTE POSSUI EMPRESA ABERTA (CLIENTE CONFIRMOU).', '2023-06-05 17:20:35');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'RITA DE CASSIA ALVES PUGLIESE', '19887846899', '1150711949', '11938009920', NULL, '11938009920 - Em contato com a cliente, a mesma informou que quando mudou para a Bradesco fez direto pelo banco. E entrou com todas as carências, então cancelou com a Bradesco e fez porto com sua corretora do auto.', '2024-02-16 12:33:58');
