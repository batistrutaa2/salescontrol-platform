INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'JOSE DE ALENCAR PINTO', '18552820706', NULL, '11985074264', '11992494314', 'TELEFONE 2\nAFAVEL.\nELE ESTAVA JUNTO DA MULHER NA LIGAÇÃO NO VIVA VOZ.\nELES ESTÃO COM DIFICULDADE COM REEMBOLSO, E ALEM DE TUDO, TEVE UM REEMBOLSO MUITO BAIXO NA\nULTIMA SOLICITAÇÃO.\nA CADA 3 ANOS, ELE FAZ UMA BATERIA DE EXAMES, E ESTÁ COM MEDO DE IR FAZER E NÃO CONSEGUIR FAZER.\nELE ESTÁ AGUARDANDO UMA LIGAÇÃO REFERENTE A UMA POSSIVEL MELHORA NO PLANO DELE.\n\nCLIENTE POSSUI DIVERSOS BENEFICIOS NA PORTO SEGURO.\nCLIENTE NÃO POSSUI EMPRESA ABERTA - ASSERTIVA\nA MULHER DELE MAGDA 082.823.328-44 (TEM 1 CNPJ, MAS ESTÁ BAIXADO)', '2023-04-05 12:14:51');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'JOSE DE ALENCAR PINTO', '18552820706', NULL, '11985074264', '11992494314', 'Em contato, o mesmo se interessou pelo Projeto Porto Seguro. pediu cotação no e-mail.', '2023-06-14 17:54:18');
