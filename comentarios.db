INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'ANA LUCIA DE A KATER', '26645941846', '1125975391', '11944797095', '11944999415', '(11) 98354-4450\nCLIENTE AFAVEL.\nNÃO TEM PROBLEMA ALGUM COM REEMBOLSO E UTILIZAÇÃO, MAS O VALOR ELA ACHA ALTO.\nCOMECEI A EXPLICAR O MOTIVO DA LIGAÇÃO, A COMPRA DA REDE D\'OR, ELA NÃO SABIA, MAS MESMO ASSIM\nACEITA OUVIR UMA POSSIVEL REDUÇÃO DE CUSTO NO PLANO DELA.\n\nCLIENTE POSSUI SEGURO AUTO NA PORTO SEGURO.\nCLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-30 16:24:06');
