INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ANDRE SOARES GALLO', '18006245819', '1136219154', '11996505958', '11968505931', '(11) 9965-05958 - Abordei como Porto Seguro, ele aceitou receber cotação, mais informou que a esposa \nTem pré e é delicado dele mudar, idades atualizadas 45/48/09 \nja ja abordar como amil portabilidade', '2023-03-07 17:16:10');
