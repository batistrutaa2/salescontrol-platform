INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'VITOR FERNANDES MISUGI', '39744564814', '11941054521', '1432087217', NULL, 'Em conversa com vitor o mesmo informou ter um plano bradesco Top nacional com 3 vidas de 65,61 e 32 anos, o mesmo não utiliza hospital desde que chegou em sp', '2023-05-30 17:04:40');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'VITOR FERNANDES MISUGI', '39744564814', '11941054521', '1432087217', NULL, 'Após retornar contato com o cliente o mesmo informou que seu plano é com a tabela do interior na bradesco e que \nseus pais são de Fernandópolis - SP, com isso partimos para os produtos Sulamerica onde tem uma tabela do \ninterior equivalente a Bradesco.\nretornar para o cliente e conversar mais sobre o produto', '2023-05-30 17:08:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'VITOR FERNANDES MISUGI', '39744564814', '11941054521', '1432087217', NULL, 'Em conversa com Vitor o mesmo disse que os valores apresentado não tiveram diferença da sua mensalidade \natual e que também não gostaria de ir para sulamerica pois sabe do momento atual da companhia, portanto não \ntem interesse em mexer no seguro saúde de seus pais.', '2023-05-31 10:46:44');
