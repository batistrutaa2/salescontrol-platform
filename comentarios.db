INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ANDRE DE ARIMATEIA DE SOUZA LIN', '63499908115', '11985884816', '11985884816', '11960820691', '(11) 9858-84816 Em contato com André, o mesmo informa não possuir interesse no momento\nporém ao abordar bem o tema, cliente aceita receber cotação sem compromisso. Enviado \ndois produtos sendo Porto Prata Mais e Bradesco com o novo produto TNI2. \nEnviado no email cadastrado, retornar com argumentos de fechamento para um desfecho!', '2022-10-27 11:09:11');
