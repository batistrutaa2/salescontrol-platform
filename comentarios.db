INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'GYSELLA LENARDUSSI FERREIRA', '14303401854', '11982162540', '11982162540', NULL, '(11) 9821-62540 tentativa de contato, telefone só chamou!\n\nEm contato com cliente via listagem de médicos . \nA mesma aceita receber proposta Porto Seguro empresarial. \nCliente passa idade do filho e de outro parente, alega que tem interesse em usar a empresa para fazer o plano. \nEnviada via whatsapp, retornarei para saber a opinião da mesma e falar sobre o produto Ouro Nacional', '2023-07-28 11:58:45');
