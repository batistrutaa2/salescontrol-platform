INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CAROLINE C S F DIAS', '22892178835', NULL, '11949951519', '11985681230', 'JA DISSE NO COMEÇO DA LIGAÇÃO QUE ESTA FAZENDO COTAÇÕES E QUER MUDAR. FEZ UM CNPJ PARA DIMINUIR CUSTOS. ESTÁ PAGANDO 2.000,00 COM O REAJUSTE. FEZ UMA COTAÇÃO NA AMIL POR 1.500,00 E ESTÁ PRA FECHAR. DIZ TER UM REEMBOLSO MUITO BAIXO. FAZER O QUANTO ANTES!!! CLIENTE NÃO POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.\r\n\r\nLigar e vender Amil', '2023-02-02 16:33:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CAROLINE C S F DIAS', '22892178835', NULL, '11949951519', '11985681230', 'Tentativa de contato sem sucesso!\n(11) 9856-81230 Atendente informa não conhecer Caroline\n(11) 9499-51519 Caixa postal', '2023-02-13 10:07:47');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CAROLINE C S F DIAS', '22892178835', NULL, '11949951519', '11985681230', '(11) 9499-51519 Em contato com cliente, a mesma aceita receber Amil S750R2 \nGosta dos valores , da rede credenciada \nPorém alega que deu baixa em seu CNPJ , consultado no assertiva consta uma empresa \naberta a cerca de 1 mês atrás : 49.511.882/0001-49 \n\nA mesma solicitou cotação via whatsapp, disse que ia conversar com seu pai e solicitou retorno . \n\nRetornar!', '2023-03-22 14:35:13');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CAROLINE C S F DIAS', '22892178835', NULL, '11949951519', '11985681230', '(11) 9499-51519 Em contato com Caroline, cliente solicita retorno na segunda-feira ou terça\npara tratarmos sobre a proposta feita da Amil Saúde\n\nRetornar', '2023-04-06 12:10:27');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CAROLINE C S F DIAS', '22892178835', NULL, '11949951519', '11985681230', '(11) 9499-51519  Em contato com cliente, a mesma aceita receber proposta da Unimed Nacional\nInforma ainda não ter CNPJ porém irá avaliar a possibilidade da abertura\nretornar futuramente!', '2023-11-08 15:59:10');
