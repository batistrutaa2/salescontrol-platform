INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LUCAS SANTANA PASSOS', 'ALESSANDRA OUCHI', '18033462809', '1124783815', '11968565661', '11991355661', 'Em contato com a cliente, foi marcado reunião para segunda-feira 21/11 as 15:30 via call.\r\n\r\nCriar sala na segunda e enviar via WhatsApp', '2022-11-18 15:32:39');
