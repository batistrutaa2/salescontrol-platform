INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANDREIA MACHINI BARBOSA', NULL, '1197135-9150', NULL, NULL, 'PESQUISA  07-03-2023\r\n\r\nTELEFONE DO LEAD. CLIENTE AFAVEL. ELA TEVE PROBLEMAS NA UTILIZAÇÃO NO CDB PARA FAZER UM RAIO-X QUE É SIMPLES. ESTÁ MUITO INSATISFEITA COM O VALOR PAGO. ELA ACEITA RECEBER SOLUÇÕES E DE PREFERENCIA REDUZIR O CUSTO, POIS ELA NÃO CONCORDA COM O VALOR QUE ESTÁ PAGANDO. (NÃO CONSEGUI SABER O VALOR EXATO QUE ESTÁ PAGANDO) E NÃO ESTÁ NO BRADESCO, ESTÁ NA SULAMERICA. BOM SABER QUAL A CATEGORIA E O VALOR (NÃO CONSEGUI POIS FALEI QUE SOU DA QUALI, ENTÃO TENHO QUE TER ESSAS INFORMAÇÕES) CLIENTE NÃO POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE NÃO POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-09 10:24:53');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANDREIA MACHINI BARBOSA', NULL, '1197135-9150', NULL, NULL, 'Tentativa de contato sem sucesso!\n(11) 9713-59150 Tentativa de contato por duas vezes só chamou', '2023-03-17 11:28:51');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANDREIA MACHINI BARBOSA', NULL, '1197135-9150', NULL, NULL, '(11) 9713-59150  Cliente migrou para sulamérica qualicorp\n\nA mesma informa que ja estudou possibilidade de migrar para um plano empresarial, comparou custos\nmas desistiu por conta de não ter interesse em abrir uma empresa, só para economizar custo no plano de saúde.', '2023-03-27 14:53:36');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ANDREIA MACHINI BARBOSA', NULL, '1197135-9150', NULL, NULL, '(11) 9713-59150 A mesma informa que saiu da qualicorp e não tem interesse em porpostas!', '2024-01-09 16:19:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', 'PESQUISA  07-03-2023\r\n\r\nTELEFONE 3 AFAVEL. CLIENTE NÃO TEVE PROBLEMAS COM UTILIZAÇÃO, E NEM SABE SOLICITAR REEMBOLSO, MAS SEMPRE TEVE VONTADE DE UTILIZAR. O MAIOR PROBLEMA DELA É O VALOR, ESTAVA PASSANDO O DIA DE HOJE PENSANDO EM CANCELAR, POIS ESTÁ MUITO CARO. LIGUEI NUM MOMENTO MUITO OPORTUNO. CLIENTE POSSUI AZUL SEGUROS DA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-09 10:29:12');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', '(11) 9821-77237 Em contato com Rosana, a mesma aceita receber a cotação da Amil Selecionada\nEnviada via whatsapp \n\nA mesma utiliza o Hospital Brasil de Santo André e passa com a médica :  Dra. Elaine Mazara CRM 60738/SP . \nInforma que está pagando valor atualizado acima e passa as idades dos pais que também estão na Sulamérica\nQualicorp : 70/76 \nNão identifiquei os pais pelo assertiva \n\nCotação enviada via whatsapp, a mesma possui empresa, retornar com argumentos de fechamento!', '2023-03-09 14:43:10');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', '(11) 9821-77237 Em contato com Rosana, cliente informa que irá viajar e só volta no dia 30/03\n \nAbordei com a mesma sobre a questão do plano para termos um desfecho e me coloquei a disposição\nde retornar após o retorno dela para quem sabe darmos um próximo passo . \n\nRetornar', '2023-03-21 10:31:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', '(11) 9821-77237 Em tentativa de contato com cliente, telefone da mesma chamou e desligou!', '2023-04-11 14:24:35');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', '(11) 9821-77237  Em contato com cliente, a mesma aceita falar sobre propostas e melhorias do custo\nAbordei com ela toda a transição como funciona e os valores da Amil saúde fiquei de passar amanhã\nAo abordar sobre reunião, cliente pede retorno amanhã para tentarmos ir em Santo André \nRetornarei contato com cotação pronta, melhorias ficaram bem atrativas!', '2023-05-11 14:42:00');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', '(11) 9821-77237  Telefone só chamou , irei retornar contato amanhã!', '2023-06-07 15:17:01');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', '(11) 9821-77237  Em contato com Rosana, cliente informa que não pode falar no momento e solicita\noutro contato em um horário mais oportuno. \nRetornar!', '2023-06-29 14:31:07');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', 'VALOR ATUAL = R$ 4.046,38', '2023-07-11 14:50:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', '(11) 9821-77237 Em retorno com cliente, a mesma informa que no momento tem receio na troca\nque por insegurança da transição, prefere continuar no seu plano\nTentei contornar a objeção, a mesma informa que não tem interesse no momento!', '2023-07-28 15:20:54');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', '(11) 9821-77237 Em contato com cliente, a mesma informa estar viajando e solicita retorno na próxima semana\nRetornar contato para abordar novamente o tema e tentar trazer melhoria a cliente', '2024-01-09 16:03:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', '(11) 9821-77237 Em novo contato com Rosana, cliente informa que estava querendo ja cancelar pelo custo\ninforma que aceita receber propostas e abordar tema novamente, passa a lista das utilizações: \nEucor _ clinica cardiologica\nHospital Brasil em santo andre\nHCoR em SP\nHospital Assunção \nHospital de fraturas IFOR\nAlergoclinica em Santo andre\n\nEnviado dois produtos, Amil S750 R1 e Seguros unimed Efetivo, a mesma possui comercio e fala em reunião\nRetornar contato com argumentos de fechamento para reunião!', '2024-05-29 15:58:17');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ROSANA VIEIRA DOS REIS', ' 13146031833', '1149941155', '11997041709', '11982177237', '(11) 9821-77237 Fiz novo retorno com cliente oferecendo o Prata Mais Porto Seguro para concluir o tema\nda reunião, a mesma pediu retorno na segunda feira para marcarmos a reunião e irmos até ela em Santo \nAndré. Retornar segunda-feira para tentar marcar a reunião.', '2024-08-02 16:37:44');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'HENRIQUE RESENDE DE SOUZA', '09763130816', '1132834847', '11976429933', NULL, 'PESQUISA  15-02-2023\r\n\r\nCLIENTE AFAVEL. ELE SAIU DA QUALICORP A MUITO TEMPO, ESTÁ NA AMIL NO PME. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-09 10:30:12');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'HENRIQUE RESENDE DE SOUZA', '09763130816', '1132834847', '11976429933', NULL, '(11) 9764-29933 - abordei como Porto, informou que estava sem tempo, que precisa falar rápido, falei do projeto se podia mandar cotação ele informou que nao, pois ja tem plano por empresa e desligou. \npedi pro le checar que dia ele saiu da qualicorp \n(11) 3283-4847 -', '2023-03-09 11:46:21');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'HENRIQUE RESENDE DE SOUZA', '09763130816', '1132834847', '11976429933', NULL, 'agendando mais pro mes 10 pois o le me informou que ele saiu da qualicorp no mes 11', '2023-04-12 11:04:12');
