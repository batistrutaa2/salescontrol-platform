INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARCELO ROBERTO RIBEIRO', NULL, '(11)9999-2956', '(11)97676-4267', NULL, '038.509.938-09 CPF - Possui benefícios com a Porto! Não possui CNPJ ativo .  (11) 9999-2956 Não pertence ao cliente .  (11) 9767-64267 Só chamou  (11) 99929-5646 Em contato com cliente, o mesmo passou as idades dos filhos 19 e 27 e duas de 58 sendo suas e da esposa, categoria da Porto Seguro Prata Mais se enquadrou ao cenário apresentado. Cliente utiliza AC Camargo, Samaritano, perdeu apenas o BP Mirante, gostou dos valores e o seu filho possui MEI ativo.  Retornar com argumento de fechamento ao mesmo!', '2022-06-09 16:18:15');
