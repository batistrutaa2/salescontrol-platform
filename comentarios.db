INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'David Sales Cavalcante', '4995023768', '(11) 9991-88617', '(11) 9718-80178', NULL, 'Após reunião realizada junto ao cliente e seu irmão em seu escritório, foi verificado que o mesmo esta a mais de 30 anos na Omint e que seus reajustes não são os mesmo aplicados atualmente, portanto a cotação enviada para o cliente tem um valor muito alto em relação ao que paga atualmente, que seria na faixa de R$9.000.\nNa reunião surgiu a oportunidade de conversar com seu irmão que esta na sulamerica pagando uma \nMensalidade de R$18.000 e que teve interesse em receber uma proposta para fazer um comparativo\ne verificar se faz sentido. Aguardar mensagem do mesmo.', '2023-05-23 10:23:28');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'ANTONIO PAULO DURANTE', '04910158871', '11999364748', NULL, NULL, '(11) 9993-64748 - em contato com ele, alegou já tar na Bradesco via PME, que as idades são 66/64/51/14\ne que não não tinha interesse, pedi pra ele receber sem compromisso só para quando reajustar quem sabe \nele ja esta com a opção da porto, vou cotar e mandar pra ele....', '2023-05-11 14:32:05');
