INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SYMONE SELLMANN OLIVEIRA', '12433520860', '1125986181', '11998362460', NULL, '11 99836-2460 Em contato com cliente, a mesma se interessa pelo tema da transição! \nAlega que sofreu reajuste com a Bradesco e que irá avaliar a transição, utiliza somente o hospital assunção. \nEm ligação, explicado toda a parte de atendimento e que exames decorrentes do PS ela terá cobertura. \nSolicita cotação via whatsapp e que irá conversar com seu esposo sobre o tema. \nSofrerá reajuste na Bradesco no proximo mes, retornar contato na proxima semana!', '2024-08-01 17:00:52');
