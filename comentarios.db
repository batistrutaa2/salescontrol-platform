INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FERNANDO LEVINO PEREIRA', '29516742874', '(11) 4667-5758', '(11) 99998-4737', '(11) 98558-1392', '(11) 9855-81392 - Em contato com Fernando, cliente está ativo na Porto Seguro \npagando : R$ 4.605,40 à mais de 1 ano, categoria Ouro Max\nCliente ainda não sabe que sofreu reajuste no seu plano!\nO mesmo se interessou pela categoria Executivo e solicitou cotação também para \no seu sócio, passada as idades : 38/38 e duas idades de 0 a 18 anos. \nEnviada cotação no e-mail atualizado , cliente solicita retorno na próxima semana\npara sabermos sua opinião e de seu sócio .', '2022-08-11 11:52:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FERNANDO LEVINO PEREIRA', '29516742874', '(11) 4667-5758', '(11) 99998-4737', '(11) 98558-1392', 'Tentativa de retorno, telefone para contato só chamou', '2022-08-15 14:31:42');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FERNANDO LEVINO PEREIRA', '29516742874', '(11) 4667-5758', '(11) 99998-4737', '(11) 98558-1392', 'PROJETO SULAMÉRICA\nEm contato com o mesmo, reenviada cotação, pois o mesmo não havia \nrecebido o e-mail \nCliente interessado na reconquista SulAmérica, retornar com argumentos \nde fechamento ao mesmo para trazer .', '2022-08-26 14:03:33');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FERNANDO LEVINO PEREIRA', '29516742874', '(11) 4667-5758', '(11) 99998-4737', '(11) 98558-1392', 'Retornar ao mesmo no final do dia 05/09/2022', '2022-09-06 17:30:00');
