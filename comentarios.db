INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'NELSON SERCHELI', '49298470878', '1142298016', '11997522756', '11993509392', 'Falei com a Selma 11 99743-9247, mulher dele encaminhei proposta por WhatsApp gostou da proposta da Amil e pedi-o para incluir a filha genro e netos. 46-47-11-17-15', '2023-07-31 14:06:07');
