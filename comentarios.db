INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEANDRO ALVES FREITAS DOS SANTOS', 'SANDRA REGINA DE LIMA', '03593777851', '11994576985', NULL, NULL, 'EM NOVO CTT COM O HUGO APRESENTEI NOSSO TRABALHO E O PRODUTO S750 DE INICIO, O MESMO\r\nAPÓS OUVIR DE PRODUTO DISSE QUE TINHA INTERESSE EM BRADESCO, SENDO ASSIM ENCAMINHEI\r\nUM ESTUDO BRADESCO PARA ELES E IREI RETORNAR NA PROX SEMANA', '2024-03-27 15:15:52');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEANDRO ALVES FREITAS DOS SANTOS', 'SANDRA REGINA DE LIMA', '03593777851', '11994576985', NULL, NULL, 'EM NOVO CTT COM O MESMO ELE DISSE QUE ESTA COM ALGUM PROBLEMAS FAMILIARES ENTRE A MÃE\r\nELE E POR MAIS QUE ELE TENHA VISTO A MELHORIA E REDUÇÃO DE CUSTO ELE NÃO VAI MEXER COM\r\nO PLANO NESSE MOMENTO POR ESSAS QUESTÕES MAS QUEM SABE NUM FUTURO', '2024-03-27 15:16:28');
