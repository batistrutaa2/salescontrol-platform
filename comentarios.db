INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'SILVIO FRANCO', '2501363841', '1941121127', '11966014443', '11989770338', '054.040.288-58 - Em contato como cliente no numero final 0338. O mesmo informou que tem interesse em mudar para plano empresarial utilizando seu endereço de Ubatuba. Não possui empresa porém irá abrir uma nova no Litoral para efeito de assistência médica. Solicitou contato 10/01 com todas as informações necessárias com Custo e Beneficio já disponível para a comparação.\nFazer cotação Bradesco Saúde TNQ Litoral e entrar em contato das 11:00 horas da manhã ao meio dia ou após as 16:00 horas da tarde.', '2023-01-09 17:04:14');
