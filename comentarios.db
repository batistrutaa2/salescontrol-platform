INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARCELO MASSAHIKO HONA', '22061441823', '1135421142', '11999940347', '11980962434', '(11) 9999-40347 - cxp  \n(11) 9809-62434 - encerrou a chamada as 3x em que liguei \n(11) 3542-1142 - nao atendeu \n\nem busca no assertiva \n\n(11) 3541-4211 - noa atendeu \n\ntem benf com a Porto \nnao encontrei empresa ativa', '2023-04-18 11:29:16');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARCELO MASSAHIKO HONA', '22061441823', '1135421142', '11999940347', '11980962434', '(11) 9999-40347 - em contato com ele, abordei como porto, deixou eu enviar cotação idades 41/47/10/07\nalegou ter especial 100, perguntou de carência e disse que aproveita e tal, acomodação ap e sem coparticipação. Fiquei de enviar no email e ret amanha por volta de 10h30 pra conversarmos melhor sobre o \nproduto! \npediu que enviasse no email e fiquei de retornar \n\n\nem busca no assertiva \n\n(11) 3541-4211 - noa atendeu \n\ntem benf com a Porto \nnao encontrei empresa ativa', '2023-04-25 11:01:27');
