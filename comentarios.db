INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'JACQUELINE SCHREURS', '6680745829', '11999911997', '11999911997', NULL, '(11) 9999-11997 Em contato com Jacqueline, cliente informa que conseguiu \numa redução de custo com a própria SulAmérica através de liminar e  está pagando\natualmente: R$ 5100,00 \nTentado trazer a Omint e bradesco e também Amil, a mesma informa que não possui \nnenhum interesse em sair da sulamérica, cotações dentro da própria sulamérica\nnão bateram os valores mesmo no empresarial!', '2022-11-09 15:28:02');
