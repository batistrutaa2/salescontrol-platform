INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'EDUARDO GOES NEVES', NULL, '(11)99998-4891', NULL, NULL, 'Olá Sr. Eduardo, bom dia! Tudo bom? \n\nÉ a Jaqueline representante da Bradesco Saúde, falamos um pouco a respeito do seu plano de saúde com a Qualicorp, o Sr. me expressou o desejo de mudar até o plano devido ao custo, que estava constituindo uma empresa... \n\nDeixo esta mensagem me colocando á disposição Eduardo. \n\nCaso queira iniciar a movimentação agora em Dezembro, ou até mesmo pra Janeiro. Vim me colocar á disposição ta ok! \n\nEstamos com muitos clientes do seu perfil Bradesco Qualicorp passando para o Bradesco empresarial e as economias de fato tem sido bem expressivas. Enfim estou á sua disposição.\n\nmandei esse whats, ta bem difícil falar com ele. me coloquei á disposição.', '2022-12-01 11:08:21');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'EDUARDO GOES NEVES', NULL, '(11)99998-4891', NULL, NULL, '(11) 9999-84891 - nao atendeu', '2022-12-26 12:27:45');
