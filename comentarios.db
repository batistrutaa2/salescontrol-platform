INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIA MARQUES LEITE', '14808751801', '11996366056', '11996366056', NULL, '11 99636-6056 Em contato com o esposo , o mesmo informa que quer migrar para a Bradesco Saúde\nAlega que esposa tem que decidir também, que irão conversar até sexta-feira\nMandada cotação e prestada a consultoria sobre todo o processo de transição \nFalado sobre a reunião na avenida angélica\nCliente informa que tem consultorio no local, retornar para marcar a reunião!', '2024-01-16 15:29:08');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIA MARQUES LEITE', '14808751801', '11996366056', '11996366056', NULL, '11 99636-6056 Em contato com o esposo Hélio , o mesmo informa que quer migrar para a Bradesco Saúde\nAlega que esposa tem que decidir também, que irão conversar até sexta-feira\nMandada cotação e prestada a consultoria sobre todo o processo de transição \nFalado sobre a reunião na avenida angélica\nCliente informa que tem consultorio no local, retornar para marcar a reunião!', '2024-01-16 15:29:26');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIA MARQUES LEITE', '14808751801', '11996366056', '11996366056', NULL, '11 99636-6056 Em retorno com Dr. Helio, o mesmo passa que está se comunicando e alinhando com esposa\nInforma que nas próximas semanas irá dar uma conclusão sobre o caso! \nManter-se no radar do cliente!', '2024-01-22 16:45:14');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIA MARQUES LEITE', '14808751801', '11996366056', '11996366056', NULL, '11 99636-6056 Em retorno com cliente, o mesmo cita estar tratando diversos temas, porém a transição\ne a reunião está em seu radar, solicita um retorno na última semana de fevereiro para tentarmos agendar\na reunião.', '2024-02-07 15:32:58');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIA MARQUES LEITE', '14808751801', '11996366056', '11996366056', NULL, '11 99636-6056 Novo contato com Helio, cliente passa que irá tratar com a esposa, o mesmo\ninforma que ela abriu um CNPJ , manter-se próximo e leva-lo ao fechamento!', '2024-03-27 11:17:03');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIA MARQUES LEITE', '14808751801', '11996366056', '11996366056', NULL, '11 99636-6056 Em novo contato, Hélio explica novamente estar aguardando a questão do CNPJ no nome\nda esposa, a mesma possui CNPJ de clinica médica com 2 sócios, explicado sobre a questão de não acarretar\ncustos nem os mesmos precisarem entrar, enviada nova cotação em seu whats para avaliação do cliente\nManter-se no radar pois estamos próximo ao reajuste!', '2024-04-23 11:22:41');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIA MARQUES LEITE', '14808751801', '11996366056', '11996366056', NULL, '11 99636-6056 Em contato com Helio, cliente solicitou retorno para hoje as 17horas', '2024-06-11 15:21:17');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CLAUDIA MARQUES LEITE', '14808751801', '11996366056', '11996366056', NULL, '11 99636-6056 - Em retorno com cliente e abordado reajuste, o mesmo solicitou retorno para amanhã a tarde.\nRetornar!', '2024-06-26 15:53:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'MARA LIZ CUSTODIO AVEIRO', '18104326856', '1150922813', '11981639767', '11996089020', NULL, '2024-01-16 18:15:31');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'MARA LIZ CUSTODIO AVEIRO', '18104326856', '1150922813', '11981639767', '11996089020', 'APRESENTEI POR TELEFONE NOVAMENTE, SE MOSTROU INTERESSADO. PORÉMELA É MUITO OCULPADA MAS FICOU DE ME DAR UM RETORNO PAA MARCARMOS UMA REUNIÃO NA PROXIMA SEMANA.', '2024-01-19 11:24:19');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'MARA LIZ CUSTODIO AVEIRO', '18104326856', '1150922813', '11981639767', '11996089020', 'Cliente muito ocupada, pediu contato por WhatsApp, porém é difícil de responder mas não atende mais o telefone também. Continuar tentando.', '2024-03-20 10:07:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'MARA LIZ CUSTODIO AVEIRO', '18104326856', '1150922813', '11981639767', '11996089020', 'Estou tentando novo contato, porém a cliente não atende e não retorna as mensagens.', '2024-06-18 16:18:47');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'MARA LIZ CUSTODIO AVEIRO', '18104326856', '1150922813', '11981639767', '11996089020', 'Cliente disse que precisa retomar esse assunto, ira iniciar um processo na Qualicorp para reaver valores, e a advogada está instruindo ela a entrar no plano pessoa física do esposo dela. Teremos que fazer portabilidade para os pais de 74/83 anos.', '2024-07-02 12:36:54');
