INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'ELEIDA COELHO CICCI RAMOS', '03066089878', '24160', NULL, NULL, '(11) 99983-8565 Em retorno, cliente informa que não tem interesse em mudar\nContornada a objeção e falado sobre o custo benefício, mesmo assim cliente permanece sem interesse.', '2024-01-08 11:22:25');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FERNANDA RODARTE DE SOUZA LIMA', '04626749674', '24160', NULL, NULL, '(11) 94632-0933 Em contato com cliente, a mesma aceita receber cotação da Amil One S2500 R1 \nCliente sana algumas dúvidas e utiliza bastante reembolso, enviado as duas opções \nA mesma informa que seu pai tem 82 anos e também gostaria de migrar, passei como funciona a portabilidade\nPrestada a consultoria sobre a abertura de empresa, cotação enviada via whatsapp \nRetornar com argumentos de fechamento!', '2023-09-01 15:27:06');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FERNANDA RODARTE DE SOUZA LIMA', '04626749674', '24160', NULL, NULL, '(11) 94632-0933 Em retorno, cliente informa que está ocupada e solicita retorno em horário mais oportuno !', '2023-09-12 16:13:38');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FERNANDA RODARTE DE SOUZA LIMA', '04626749674', '24160', NULL, NULL, '(11) 94632-0933 Em retorno com cliente, a mesma informa que no momento não está afim de fazer\na transição, fez algumas pesquisas e no momento prefere permanecer junto a sulamérica!', '2023-10-16 14:10:54');
