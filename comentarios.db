INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SYMONE SELLMANN OLIVEIRA', '12433520860', '1125986181', '11998362460', NULL, '11 99836-2460 Em contato com Symone, cliente se interessa pelo Bradesco Saúde\nInforma que ainda não obteve resultado da liminar e que está em um contrato via CNPJ\nA mesma informa que utiliza o hospital Assunção do ABC e que irá confirmar se o plano\nTNQQ tem utilizações no local, retornar amanhã no periodo da tarde a mesma com argumentos\nde fechamento!\nProposta enviada via whatsapp', '2023-02-23 15:30:38');
