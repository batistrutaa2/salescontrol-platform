INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MIKE ANDREW COUTO LICAS DA SILVA', 'RONALD LUIZ GOMES FLUMIGNAN', '21393922805', '1135672225', '11991221529', '11985347948', 'Carolina (11) 9912-21529 disse que por hora não pode mexer no plano, porém não quis me abrir os motivos. Retornar após o reajuste.', '2024-06-11 12:25:26');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'MARCUS AUGUSTUS GIANULLO', '81781610878', '(11) 2973-1583', '(11) 9991-95059', '(11) 9697-31583', 'Em conversa com Marcus o mesmo pediu que enviasse o estudo e ja adiantou que sua esposa teve cancer de \nmama a 4 anos onde hoje ela faz o acompanhamento necessario, e também que esta indo para o exterior e que \nretorna dia 28. ligar nesta data para marcar a reunião', '2023-07-31 15:57:37');
