INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'MANOEL VITOR DOS SANTOS', '61864056800', '1150817309', '11991044534', '11991263630', 'TELEFONE 2 - SELMA (MULHER DELE)\nTELEFONE 3 - DELE (MAS EU CONVERSEI COM A MULHER DELE)\nEXTREMAMENTE AFAVEL.\nELA NÃO TEM PROBLEMAS NENHUM EM UTILIZAÇÃO, NEM REEMBOLSO. O VALOR ELA NAO SOUBE EXPLICAR\nPOIS QUEM PAGA É O MARIDO. MAS ELA FALOU QUE RECLAMA TODOS OS DIAS QUE O VALOR ESTA ALTO\nENTÃO FALEI PRA ELA QUE IREI COLOCAR QUE O VALOR É ALGO QUE INCOMODA AMBOS, E QUE ALGUEM IRA \nRETORNAR LIGAÇÃO TRAZENDO ALGUMA ATUALIZAÇÃO PARA MELHORAR O BENEFICIO.\nPENSEI EM OFERECER UMA REDUÇÃO E COBRAR A DIFERENÇA CASO N]AO SEJA POSSIVEL UMA TROCA.\n\nCLIENTE POSSUI CNPJ - ASSERTIVA.', '2023-06-02 18:05:51');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'MANOEL VITOR DOS SANTOS', '61864056800', '1150817309', '11991044534', '11991263630', '(11) 9912-63630 - Cliente informou que tem um corretor da família com a situação em andamento.', '2023-09-01 13:52:59');
