INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'PAULA RODRIGUES', '10641121881', '(11) 4318-0048', '(91) 9876-89744', '(11) 9966-79067', '9966-79067 - paula informou estar na sulamerica com 3 vidas de 19,23 e 56 anos, a mesma pediu que enviasse o \nestudo em seu wpp\nEstudo da Bradesco enviado no WPP', '2023-06-22 11:16:41');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('LEONARDO PRADO MUTZ', 'PAULA RODRIGUES', '10641121881', '(11) 4318-0048', '(91) 9876-89744', '(11) 9966-79067', 'Paula informou ter gostado dos valores mas também disse que não tem interesse em planos PME.\nEm conversa com a mesma expliquei como funciona a abertura do CNPJ expliquei os valores e também que a \nempresa é aberta apenas para fins do plano de saúde,  porém Paula disse que ja conversou com seu contador e \nque não tem interesse em fazer abertura de CNPJ', '2023-06-28 11:53:40');
