INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIA DO CARMO CARDIA JULIAO', '24873727880', '6733214011', '67984834011', '67984551192', 'em contato com ela, falou que vai manter mais um pouco na sula pois ano passado o filho dela colocou \num stent e disse que ta insegura ainda de mexer. Que como a qualicorp reduziu, ela vai manter mais um \npouco la, me deixou ret em jan ai conversamos novamente', '2023-01-15 10:00:00');
