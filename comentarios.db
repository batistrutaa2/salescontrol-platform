INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'MARIA APARECIDA MORAES CAVINATO', '32308663804', '1125390473', '11991971107', '11966214242', '(11) 9919-71107 Em contato com cliente, a mesma aceita receber proposta da Amil S750R1 \nCliente informa que não tem dependente mas passa idade do neto de 0 a 18 anos\nPossui empresa aberta porém informou que não tem, a mesma disse que vai consultar o filho \ne pedir para o mesmo me ligar para sanar dúvidas \nRetornar na próxima semana para tentar marcar reunião!', '2023-09-01 11:50:25');
