INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('GUILHERME DA COSTA DE MAGALHAES', 'VERA SILVIA DE OLIVEIRA DIAS', '08582542801', '1125781927', '11995628499', NULL, 'EM RETORNO COM A CLIENTE ELA NÃO QUER NADA COM NADA... NÃO QUER PREVENT PORQUE O MARIDO TEM E NÃO CONSEGUE FAZER NADA, NÃO QUER AMIL PORQUE ODEIA O ATUAL DONO, E NÃO TEM NENHUMA OUTRA VIDA PARA QUE SEJA OFERECIDO ALGO DIFERENTE DISSO, FICA DIFICIL APRESENTAR ALGO QUE INTERESSE SOMENTE PRA VIDA DELA QUE NÃO SEJA AS OPÇÕES QUE JÁ APRESENTEI', '2024-02-22 12:00:43');
