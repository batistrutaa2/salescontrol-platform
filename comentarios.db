INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'CAROLINE C S F DIAS', '22892178835', NULL, '11949951519', '11985681230', '(11) 9499-51519 Em retorno com cliente, a mesma está pagando atualmente R$ 2.500,00 para ela e filha\nEnviada cotação em seu email : carolinechristina@hotmail.com . Cliente com CNPJ ativo e sana algumas dúvidas\nRetornar nos próximos dias para concluir transição, sofrerá reajuste em janeiro!', '2024-08-02 15:34:55');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SOLANGE DE CARVALHO NOGUEIRA', '31454851805', '1156136338', '11999856698', '11977721929', 'CLIENTE POSSUIA ANTIGAMENTE A LINHA EXECUTIVA. FEZ O DOWNGRADE E FOI PARA O CLASSICO. NESTA MUDANÇA, O CORRETOR NAO SE ATENTOU NA DATA DE VENCIMENTO E FOI PARA O DIA 10 ELA GOSTARIA QUE FOSSE DIA 20, POIS ELA ESTÁ SE ENROLANDO PARA PAGAR. TEM UMA AÇÃO NA SULAMERICA REFERENTE A REEMBOLSO, MAS MESMO ASSIM É FELIZ E INDICARIA. DIZ ESTAR FELIZ COM O VALOR PAGO. CLIENTE NÃO POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA\r\n\r\nTrazer para TNP4 ou ONE Health', '2023-02-02 16:34:09');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SOLANGE DE CARVALHO NOGUEIRA', '31454851805', '1156136338', '11999856698', '11977721929', '(11) 9998-56698 Em contato com Solange, cliente informa não possuir interesse\nA mesma alega que não sai da sulamérica por nada , por isso mesmo entrou com \nação judicial para permanecer na mesma operadora \nCliente reforçou que não sai da sulamerica antes de finalizar ligação!', '2023-02-03 12:56:56');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'SOLANGE DE CARVALHO NOGUEIRA', '31454851805', '1156136338', '11999856698', '11977721929', 'VALOR ATUAL R$ 2.405,49', '2023-09-14 16:43:50');
