INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('KAIQUE ALBERTIN', 'MARIANA LOPES PARREIRA BETTINI', NULL, '1199677-7474', NULL, NULL, '(11) 99933-0463 - NUMERO DO PAI DELA. \nELE FOI LA FALAR COM ELA, E ELA NÃO QUIS ME ATENDER, POIS ELA DISSE QUE NÃO TEM MAIS VINCULO\nCOM A QUALICORP, E QUE HOJE ELA TEM VINCULO DIRETO COM A EMRPESA.\nACREDITO QUE HOJE ELA DEVE TER PME. \nE TAMBÉM NÃO CONSEGUI CONFIRMAR SE O TELEFONE DELA É O DO LEAD.', '2023-04-03 15:57:43');
