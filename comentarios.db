INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FLAVIA REGINA F ALBUQUERQUE', '25909331850', '1142218821', '11996270063', '11995236473', 'PESQUISA  07-03-2023\r\n\r\nTELEFONE 2 CLIENTE AFAVEL MAS NÃO DE MUITAS PALAVRAS. DIZ ESTAR TUDO CERTO, COM TUDO. EU INSISTI, FALEI SOBRE DESCREDENCIAMENTOS E TALS. ELA COMENTOU QUE TENTOU USAR O LABORATORIO ROCHA LIMA EM SAO CAETANO, ONDE SEMPRE PASSOU E AGORA NÃO ESTÃO ACEITANDO PARA FAZER OS PROCEDIMENTOS. UNICA DOR QUE CONSEGUI ARRANCAR DELA. EXPLIQUEI QUE IREMOS TENTAR UMA ATUALIZAÇÃO DENTRO DA SULAMERICA E CASO NÃO SEJA POSSIVEL OUTRO COMPANHIA IRA RETORNAR COM A SOLUÇÃO. ELA ACEITOU. CLIENTE POSSUI BENEFICIOS NA PORTO SEGURO. CLIENTE POSSUI EMPRESA ABERTA - ASSERTIVA.', '2023-03-09 10:31:06');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FLAVIA REGINA F ALBUQUERQUE', '25909331850', '1142218821', '11996270063', '11995236473', '(11) 9962-70063 Em contato com Flavia, a mesma foi generosa porém disse estar trabalhando\r\n\r\nSolicitou retorno na próxima semana após as 17h da tarde, horário em que já saiu do trabalho.', '2023-03-17 11:48:18');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FLAVIA REGINA F ALBUQUERQUE', '25909331850', '1142218821', '11996270063', '11995236473', '(11) 9962-70063 Irei fazer o retorno hoje após as 17 horas!\r\n\r\nRetornar', '2023-03-21 10:38:05');
INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('MATHEUS OLIVEIRA DILE', 'FLAVIA REGINA F ALBUQUERQUE', '25909331850', '1142218821', '11996270063', '11995236473', '(11) 9962-70063  Em contato com Flavia, cliente informa que não tem interesse no momento.\n\nAo tentar insistir, cliente informa que não quer sair da sulamérica e que trata dessa questão no futuro.', '2023-03-21 17:45:51');
