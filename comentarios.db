INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('JAQUELINE RODRIGUES GOIS', 'MARIA DO CARMO CARDIA JULIAO', '24873727880', '6733214011', '67984834011', '67984551192', 'Olá Dra. Maria, boa tarde   Como vai ?   Passando por aqui para avisar que eu quem liguei no seu celular agora pouco, a linha estava muda, não sei se me ouvia...  Te envio este WhatsApp para verificar se a Dra. teve um tempo de checar quanto a proposta que enviei, da Bradesco, esta um valor bem competitivo com o seu atual e gostaria de me colocar á disposição caso deseje esta semana realizar uma reunião por chamada de vídeo através destas inúmeras plataformas que temos hoje para Call...   Como é um assunto bem serio, caso se sinta mais confortável, podemos fazer isso e esmiuçar todos os pontos do plano que te ofereço sem compromisso ok. Estou á disposição e desejo uma excelente semana.', '2022-05-30 18:23:39');
