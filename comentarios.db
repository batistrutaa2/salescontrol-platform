INSERT INTO `comentarios_legado` (`nome_autor`, `nome_cliente`, `cpf`, `telefone1`, `telefone2`, `telefone3`, `anotacao`, `created_at`) VALUES ('SRD ADMIN', 'ALICE CRISTINA VIEIRA', '30146172884', '15996269452', '15996950137', NULL, '(15) 99626-9452 - Em contato com Alice, cliente informa que está com 5 participantes no Amil S450. Utiliza os hospitais de Sorocaba Evangélico e GPaci, enviado dois produtos da Bradesco sendo Efetivo e Nacional Flex, efetivo não entra apenas o evangélico. Retornar a mesmo com argumentos de fechamento .  Cliente possui vários CNPJ', '2022-06-28 11:47:36');
