# Integração privada CRM -> servidor de arquivos pela rede WireGuard
DOCUMENTOS_PROCESSAMENTO_ATIVO=false
DOCUMENTOS_DISK=documentos_sftp
DOCUMENTOS_ROOT=EmAnalise
DOCUMENTOS_SFTP_HOST=servidor-documentos
DOCUMENTOS_SFTP_PORT=22
DOCUMENTOS_SFTP_USERNAME=crm_documentos
DOCUMENTOS_SFTP_PRIVATE_KEY=/var/www/html/storage/app/private/keys/documentos_sftp
DOCUMENTOS_SFTP_PASSPHRASE=
DOCUMENTOS_SFTP_FINGERPRINT=substitua-pelo-fingerprint-validado
DOCUMENTOS_SFTP_BASE_PATH=/srv/samba/administrativo
DOCUMENTOS_SFTP_TIMEOUT=45
DOCUMENTOS_SFTP_CONNECT_TRIES=1

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=120

# Deve ser maior que o timeout de 600 segundos do worker de transferência.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
DB_QUEUE_RETRY_AFTER=900
REDIS_QUEUE_RETRY_AFTER=900
