#!/usr/bin/env bash
# Wrapper Docker de desenvolvimento do SalesControl.
# Uso: ./dev <comando> [args...]
set -euo pipefail

COMPOSE="docker compose -f compose.dev.yaml"
INFRA_COMPOSE="docker compose -f ../docker-compose.yml"

# Garante que o MySQL compartilhado está de pé
ensure_infra() {
  if ! docker ps --format '{{.Names}}' | grep -q '^brsolutions-mysql$'; then
    echo "→ Subindo infra compartilhada (MySQL)..."
    $INFRA_COMPOSE up -d --wait
  fi
}

cmd="${1:-help}"; shift || true

case "$cmd" in
  up)       ensure_infra; $COMPOSE up -d "$@" ;;
  down)     $COMPOSE --profile queue --profile scheduler --profile reverb down "$@" ;;
  restart)  $COMPOSE restart "$@" ;;
  ps)       $COMPOSE ps ;;
  logs)     $COMPOSE logs -f "$@" ;;
  build)    $COMPOSE build app ;;
  queue)    ensure_infra; $COMPOSE --profile queue up -d --scale documentos-queue=2 --scale documentos-scan=1 ;;
  scheduler|cron) ensure_infra; $COMPOSE --profile scheduler up -d ;;
  reverb)   ensure_infra; $COMPOSE --profile reverb up -d ;;
  artisan|art) ensure_infra; $COMPOSE run --rm --no-deps app php artisan "$@" ;;
  tinker)   ensure_infra; $COMPOSE run --rm --no-deps -it app php artisan tinker ;;
  composer) $COMPOSE run --rm --no-deps app composer "$@" ;;
  npm)      $COMPOSE run --rm --no-deps vite npm "$@" ;;
  test)     ensure_infra; $COMPOSE run --rm --no-deps app php artisan test "$@" ;;
  pint|lint) $COMPOSE run --rm --no-deps app ./vendor/bin/pint "$@" ;;
  shell|sh) $COMPOSE run --rm --no-deps -it app bash ;;
  mysql)    ensure_infra; docker exec -it brsolutions-mysql mysql -udev -psecret salescontrol ;;
  help|*)
    cat <<'EOF'
Uso: ./dev <comando>

  up              Sobe app (:8001) + vite (:5174), e o MySQL se preciso
  down            Derruba todos os containers do SalesControl
  queue           Sobe também o worker de fila (profile opcional)
  scheduler       Sobe o agendador/cron Laravel (profile opcional)
  cron            Alias de scheduler
  reverb          Sobe também o servidor websocket (:8082, profile opcional)
  artisan <...>   Roda comando artisan            (ex.: ./dev artisan migrate)
  test [...]      Roda a suíte de testes          (ex.: ./dev test --filter=X)
  pint            Formata o PHP (Laravel Pint)
  composer <...>  Roda composer                   (ex.: ./dev composer install)
  npm <...>       Roda npm                        (ex.: ./dev npm run build)
  tinker          Abre o tinker
  shell           Abre um bash no container
  mysql           Abre o client MySQL no database salescontrol
  logs [serviço]  Segue os logs
  ps              Lista containers
  build           Reconstrói a imagem dev
EOF
    ;;
esac
