APP_URL=http://localhost
PLATFORM_NAME="SalesControl"
PLATFORM_CREATOR_NAME="BR Solutions"
PLATFORM_CREATOR_URL=

PLATFORM_COMPANY_NAME="SalesControl Desenvolvimento"
PLATFORM_COMPANY_DOCUMENT="00000000000000"
PLATFORM_COMPANY_PHONE="00000000000"
PLATFORM_COMPANY_EMAIL="platform@salescontrol.local"

PLATFORM_ADMIN_NAME="Administrador da Plataforma"
PLATFORM_ADMIN_EMAIL="admin@salescontrol.local"
# Obrigatória para executar `php artisan db:seed`; nunca reutilize em produção.
PLATFORM_ADMIN_PASSWORD=

# Necessário somente se eventos de entrega do Resend forem utilizados.
# Sem este valor, o endpoint permanece bloqueado por uma assinatura local.
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_TOLERANCE=300
