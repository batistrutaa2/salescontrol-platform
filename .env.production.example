APP_NAME="SalesControl"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://licas-consultoria.brsolution.tech
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

APP_IMAGE=ghcr.io/batistrutaa2/salescontrol-platform
APP_HTTP_PORT=8010
REVERB_SERVER_PORT=8087
COMPOSE_PROFILES=realtime

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=salescontrol_platform
DB_USERNAME=salescontrol_platform
DB_PASSWORD=
DB_PERSONAL_HOST=host.docker.internal
DB_PERSONAL_PORT=3306
DB_PERSONAL_DATABASE=people_db
DB_PERSONAL_USERNAME=salescontrol_platform
DB_PERSONAL_PASSWORD=

LEMIT_API_TOKEN=
LEMIT_BASE_URL=https://api.lemit.com.br/api/v1/consulta
LEMIT_CACHE_MONTHS=3
ASSERTIVA_ENABLED=false

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=licas_salescontrol_
REDIS_QUEUE_RETRY_AFTER=900

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=salescontrol-platform
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@brsolution.tech
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
DOCUMENTOS_PROCESSAMENTO_ATIVO=false

PLATFORM_NAME="SalesControl"
PLATFORM_CREATOR_NAME="BR Solutions"
PLATFORM_CREATOR_URL=https://brsolution.tech
PLATFORM_ADMIN_NAME="Administrador da Plataforma"
PLATFORM_ADMIN_EMAIL=
# Necessária apenas no primeiro deploy. Depois do primeiro login, troque a senha
# e remova este valor do secret PRODUCTION_ENV no GitHub.
PLATFORM_ADMIN_PASSWORD=

DB_BACKUP_ENABLED=true
DB_BACKUP_RETENTION=14
